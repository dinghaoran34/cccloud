<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Holo.Light 在 API 14+ 可用，无需任何支持库 -->
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowAnimationStyle">@style/TeamCloudWindowAnim</item>
    </style>

    <!-- 全局窗口切换动画（进入淡入/退出淡出，约 200-220ms，符合安卓动效节奏；API14 可用） -->
    <style name="TeamCloudWindowAnim">
        <item name="android:windowEnterAnimation">@anim/anim_fade_in</item>
        <item name="android:windowExitAnimation">@anim/anim_fade_out</item>
        <item name="android:windowShowAnimation">@anim/anim_fade_in</item>
        <item name="android:windowHideAnimation">@anim/anim_fade_out</item>
    </style>

    <!-- Material 风格弹窗容器：透明背景由内容自绘圆角卡片，保证 API14+ 观感一致 -->
    <style name="TeamCloudDialog" parent="@android:style/Theme.Holo.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/TeamCloudDialogAnim</item>
    </style>

    <!-- M3 弹窗进出场：中心缩放 + 淡入淡出（220ms/140ms），API14 可用 -->
    <style name="TeamCloudDialogAnim">
        <item name="android:windowEnterAnimation">@anim/anim_dlg_in</item>
        <item name="android:windowExitAnimation">@anim/anim_dlg_out</item>
    </style>
</resources>
