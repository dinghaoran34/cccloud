<?xml version="1.0" encoding="utf-8"?>
<!--
  CC网盘 自适应图标（API 26+）背景：品牌蓝竖向渐变，与 PNG 图标完全一致。
  顶 #2B7DE9 (43,125,233) → 底 #1F6FD0 (31,111,208)；angle=270 即自上而下。
  形状 drawable（API 1 起支持），仅在 mipmap-anydpi-v26 中被引用，不影响 minSdk 11 构建。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF2B7DE9"
        android:endColor="#FF1F6FD0"
        android:type="linear" />
</shape>
