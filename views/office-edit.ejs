<%- include('partials/cr-shell-head', { crActive: 'files' }) %>
  <header class="cr-topbar">
    <button type="button" class="cr-hamburger" data-cr-drawer-open title="打开菜单" aria-label="打开菜单">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4.6 5.6h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 10.5h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 15.4h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3z"/></svg>
    </button>
    <nav class="cr-crumb" aria-label="面包屑">
      <a class="cr-crumb-item" href="/office/<%= fileId %>">只读预览</a>
      <span class="cr-crumb-sep">/</span>
      <span class="cr-crumb-item is-current" title="<%= fileName %>"><%= fileName %></span>
    </nav>
    <div class="cr-top-actions">
      <a class="cr-btn cr-btn-ghost" href="/office/<%= fileId %>">返回预览</a>
      <a class="cr-btn cr-btn-primary" href="<%= downloadUrl %>" download>下载</a>
      <%- include('partials/cr-theme-btn') %>
      <%- include('partials/cr-user-menu') %>
    </div>
  </header>

  <div class="cr-content">
    <% if (!editConfigured) { %>
      <div class="cr-card">
        <div class="cr-card-head">
          <h2>在线编辑不可用</h2>
        </div>
        <div class="cr-card-body">
          <div class="cr-alert cr-alert-error" style="display:block;">
            <strong>需部署 OnlyOffice Document Server</strong><br>
            <%= editMsg %>
          </div>
          <p class="cr-hint" style="margin-top:12px;">配置方法：部署 OnlyOffice Document Server 后，设置环境变量 <code>ONLYOFFICE_URL</code>（如 https://office.example.com）
            与可选的 <code>ONLYOFFICE_JWT_SECRET</code>，重启本服务即可启用在线编辑。当前只读预览功能不受影响。</p>
        </div>
      </div>
    <% } else { %>
      <div class="cr-card">
        <div class="cr-card-head">
          <h3><%= fileName %></h3>
          <span class="cr-spring"></span>
          <span class="cr-hint"><%= sizeText %> · OnlyOffice Document Server 在线编辑，保存后自动写回网盘（生成新版本）</span>
        </div>
        <div class="cr-card-body">
          <div id="onlyofficePlaceholder" class="cr-office-editor"></div>
        </div>
      </div>
      <script src="<%= onlyofficeUrl %>/web-apps/apps/api/documents/api.js"></script>
      <script>
      (function(){
        var cfg = <%- editorConfigJson %>;
        function boot(){
          if (!window.DocsAPI) {
            document.getElementById('onlyofficePlaceholder').innerHTML =
              '<div class="cr-empty"><p>OnlyOffice 编辑器脚本加载失败，请检查 ONLYOFFICE_URL 是否可访问。</p></div>';
            return;
          }
          new DocsAPI.DocEditor('onlyofficePlaceholder', cfg);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
      })();
      </script>
    <% } %>
  </div>
<%- include('partials/cr-shell-foot') %>
