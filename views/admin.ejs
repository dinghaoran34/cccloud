  </div>
</div>

<div id="crAlertModal" class="cr-modal-mask" style="display:none">
  <div class="cr-modal" style="width:400px">
    <h3 class="cr-modal-title" id="crAlertTitle">提示</h3>
    <p class="cr-hint" id="crAlertMsg" style="margin-bottom:6px;white-space:pre-wrap;"></p>
    <div class="cr-modal-btns">
      <button type="button" class="cr-btn cr-btn-primary" id="crAlertOk">知道了</button>
    </div>
