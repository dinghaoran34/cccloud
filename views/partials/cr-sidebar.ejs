<aside class="cr-side" id="crSide">
  <a class="cr-side-brand" href="/dashboard">
    <%- _brandMark %>
    <span>CC网盘</span>
  </a>

  <nav class="cr-nav" id="panSideNav">
    <a class="<%= _cls('home') %>" href="/dashboard" data-pan="home" title="首页">
      <%- _ico('home', 18) %><span>首页</span>
    </a>
    <a class="<%= _cls('files') %>" href="/dashboard?tab=files" data-pan="files" title="我的文件">
      <%- _ico('folder', 18) %><span>文件</span>
    </a>
    <a class="<%= _cls('shares') %>" href="/shares" title="我的分享">
      <%- _ico('share', 18) %>
      <span>我的分享</span>
    </a>
    <a class="<%= _cls('offline') %>" href="/offline" title="离线下载">
      <%- _ico('download', 18) %><span>离线下载</span>
    </a>
    <a class="<%= _cls('starred') %>" href="/dashboard?tab=starred" data-pan="starred" title="收藏">
      <%- _ico('star', 18) %>
      <span>收藏</span>
    </a>
    <a class="<%= _cls('recent') %>" href="/dashboard?tab=recent" data-pan="recent" title="最近访问">
      <%- _ico('clock', 18) %>
      <span>最近访问</span>
    </a>
    <a class="<%= _cls('teams') %>" href="/dashboard?tab=teams" data-pan="teams" title="团队空间">
      <%- _ico('users', 18) %><span>团队</span>
      <% if (typeof hasTeam !== 'undefined' && hasTeam) { %><span class="cr-nav-badge"><%= teams.length %></span><% } %>
    </a>
    <a class="<%= _cls('trash') %>" href="/trash" title="回收站">
      <%- _ico('trash', 18) %><span>回收站</span>
    </a>
    <a class="<%= _cls('search') %>" href="/search" title="搜索">
      <%- _ico('search', 18) %>
      <span>搜索</span>
    </a>
    <% if (_user && _user.role === 'admin') { %>
      <a class="<%= _cls('admin') %>" href="/admin" title="管理后台">
        <%- _ico('gear', 18) %><span>管理后台</span>
      </a>
    <% } %>
  </nav>

  <% if (typeof usage !== 'undefined' && usage) { %>
    <%
      var _pct = Math.min(100, Math.round(usage.used / usage.quota * 1000) / 10);
      var _bar = _pct >= 95 ? 'var(--cr-danger)' : (_pct >= 80 ? 'var(--cr-warning)' : 'var(--cr-primary)');
    %>
    <div class="cr-side-foot">
      <div class="cr-usage-head"><%- _ico('storage', 14) %> 网盘容量</div>
      <div class="progress-track">
        <div class="progress-bar" style="width: <%= _pct %>%; background: <%= _bar %>;"></div>
      </div>
      <div class="cr-usage-text"><%= _fmtSize(usage.used) %> / <%= _fmtSize(usage.quota) %></div>
      <% if (_pct >= 95) { %>
        <div class="cr-usage-warn"><%- _ico('warn', 12) %> 容量即将用尽</div>
      <% } %>
      <div class="cr-usage-stats">
        <%- _ico('file', 12) %>
        <span><%= (typeof personalCount !== 'undefined' ? personalCount : 0) %> 个文件</span>
      </div>
    </div>
  <% } %>
</aside>
