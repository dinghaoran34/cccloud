<%
  /* 顶栏用户头像 + 下拉菜单（我的 / 管理后台 / 退出登录）
     依赖 res.locals.currentUser（全站中间件已注入） */
  var _cu = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
  var _name = _cu ? (_cu.nickname || _cu.username || '') : '';
%>
<% if (_cu) { %>
<div class="cr-user">
  <button type="button" class="cr-user-btn" title="账户菜单" aria-haspopup="true">
    <span class="cr-avatar">
      <% if (_cu.avatar) { %><img src="/avatar/<%= _cu.uid %>" alt="头像"><% } else { %><%= _name.slice(0, 1).toUpperCase() %><% } %>
    </span>
    <span class="cr-user-name"><%= _name %></span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M11.15 15.42Q12 16.27 12.85 15.42L19.32 8.95Q20.17 8.1 19.32 7.25Q18.47 6.4 17.62 7.25L12 12.87L6.38 7.25Q5.53 6.4 4.68 7.25Q3.83 8.1 4.68 8.95Z"/></svg>
  </button>
  <div class="cr-menu">
    <div class="cr-menu-head">
      <b><%= _name %></b>
      <span>UID: <%= _cu.uid %></span>
    </div>
    <a class="cr-menu-item" href="/dashboard?tab=account"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M8.2 8a3.8 3.8 0 1 0 7.6 0a3.8 3.8 0 1 0-7.6 0zM12 12.8a7.4 7.4 0 0 1 7.4 7.4V21.4H4.6v-1.2a7.4 7.4 0 0 1 7.4-7.4z"/></svg>我的账户</a>
    <% if (_cu.role === 'admin') { %>
      <a class="cr-menu-item" href="/admin"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M5 12a7 7 0 1 0 14 0a7 7 0 1 0-14 0zM9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0z"/><path d="M18 12.5L18 11.5A1 1 0 0 1 19 10.5L20.2 10.5A1 1 0 0 1 21.2 11.5L21.2 12.5A1 1 0 0 1 20.2 13.5L19 13.5A1 1 0 0 1 18 12.5ZM15.89 16.6L16.6 15.89A1 1 0 0 1 18.01 15.89L18.86 16.74A1 1 0 0 1 18.86 18.15L18.15 18.86A1 1 0 0 1 16.74 18.86L15.89 18.01A1 1 0 0 1 15.89 16.6ZM11.5 18L12.5 18A1 1 0 0 1 13.5 19L13.5 20.2A1 1 0 0 1 12.5 21.2L11.5 21.2A1 1 0 0 1 10.5 20.2L10.5 19A1 1 0 0 1 11.5 18ZM7.4 15.89L8.11 16.6A1 1 0 0 1 8.11 18.01L7.26 18.86A1 1 0 0 1 5.85 18.86L5.14 18.15A1 1 0 0 1 5.14 16.74L5.99 15.89A1 1 0 0 1 7.4 15.89ZM6 11.5L6 12.5A1 1 0 0 1 5 13.5L3.8 13.5A1 1 0 0 1 2.8 12.5L2.8 11.5A1 1 0 0 1 3.8 10.5L5 10.5A1 1 0 0 1 6 11.5ZM8.11 7.4L7.4 8.11A1 1 0 0 1 5.99 8.11L5.14 7.26A1 1 0 0 1 5.14 5.85L5.85 5.14A1 1 0 0 1 7.26 5.14L8.11 5.99A1 1 0 0 1 8.11 7.4ZM12.5 6L11.5 6A1 1 0 0 1 10.5 5L10.5 3.8A1 1 0 0 1 11.5 2.8L12.5 2.8A1 1 0 0 1 13.5 3.8L13.5 5A1 1 0 0 1 12.5 6ZM16.6 8.11L15.89 7.4A1 1 0 0 1 15.89 5.99L16.74 5.14A1 1 0 0 1 18.15 5.14L18.86 5.85A1 1 0 0 1 18.86 7.26L18.01 8.11A1 1 0 0 1 16.6 8.11Z"/></svg>管理后台</a>
    <% } %>
    <div class="cr-menu-sep"></div>
    <form action="/logout" method="POST">
      <button type="submit" class="cr-menu-item is-danger"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M6.6 6.6a1.2 1.2 0 0 1 1.7 0L12 10.3l3.7-3.7a1.2 1.2 0 1 1 1.7 1.7L13.7 12l3.7 3.7a1.2 1.2 0 0 1-1.7 1.7L12 13.7l-3.7 3.7a1.2 1.2 0 0 1-1.7-1.7L10.3 12 6.6 8.3a1.2 1.2 0 0 1 0-1.7z"/></svg>退出登录</button>
    </form>
  </div>
</div>
<% } %>
