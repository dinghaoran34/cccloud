<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="no-referrer">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style-mobile.css?v=2026091905">
  <script>
    /* 主题预置：避免刷新时闪白/闪黑（与桌面版一致：默认跟随系统，手动选择存 localStorage.cr_theme） */
    (function () {
      try {
        var t = localStorage.getItem('cr_theme');
        if (t === 'dark' || t === 'light') { document.documentElement.setAttribute('data-theme', t); }
      } catch (e) { }
    })();
  </script>
</head>
<body>
  <%- include('cr-app-banner') %>
  <nav class="navbar">
    <!-- 左：应用页汉堡（打开更多抽屉）/ 访客页品牌 -->
    <button type="button" class="nav-icon-btn nav-burger" id="mbBurgerBtn" title="导航菜单" aria-label="导航菜单" aria-expanded="false" aria-controls="mbDrawer">
      <%- _ico('burger', 24) %>
    </button>
    <a href="<%= _cu ? '/dashboard' : '/' %>" class="nav-brand">
      <span class="logo-icon"><%- _brandMark(24) %></span>
      <span>CC网盘</span>
    </a>

    <!-- 中：标题（应用页显示，17 Bold 单行省略） -->
    <div class="nav-title" id="mbNavTitle"
         data-title-home="首页" data-title-files="文件" data-title-team="团队" data-title-me="我的"><%= _navTitle %></div>

    <!-- 右：图标按钮（≤3 个，各 44×44）：主题 / 搜索 / ⋯更多 -->
    <div class="nav-actions">
      <button type="button" class="nav-theme-btn" id="mbThemeBtn" title="主题：浅色 / 深色 / 跟随系统" aria-label="主题：浅色 / 深色 / 跟随系统" aria-haspopup="dialog">
        <%- _icoMoon %>
        <%- _icoSun %>
      </button>
      <% if (_cu) { %>
        <a href="/search" class="nav-icon-btn" title="搜索" aria-label="搜索">
          <%- _ico('search', 24) %>
        </a>
        <button type="button" class="nav-icon-btn" id="mbMoreBtn" title="更多" aria-label="更多" aria-haspopup="dialog" aria-expanded="false" aria-controls="mbDrawer">
          <%- _ico('more', 24) %>
        </button>
      <% } else { %>
        <a href="/login" class="btn-logout">登录</a>
        <a href="/register" class="btn-logout btn-logout-primary">注册</a>
      <% } %>
    </div>
  </nav>

  <% if (_cu) { %>
  <!-- 更多抽屉：完整导航（顺序 / 命名与桌面侧边栏一致） -->
  <div class="mb-drawer-mask" id="mbDrawerMask"></div>
  <aside class="mb-drawer" id="mbDrawer" role="dialog" aria-modal="true" aria-label="导航">
    <div class="mb-drawer-head">
      <%- _brandMark(28) %>
      <div class="mb-drawer-head-info">
        <b><%= _name %></b>
        <span>UID: <%= _cu.uid %></span>
      </div>
    </div>
    <nav class="mb-drawer-nav">
      <% _navItems.forEach(function (it) { %>
        <% if (it.admin && _cu.role !== 'admin') { return; } %>
        <a class="mb-drawer-item" href="<%= it.href %>"<% if (it.goto) { %> data-goto="<%= it.goto %>"<% } %>>
          <% if (it.svg) { %><%- it.svg %><% } else { %><img src="<%= it.icon %>" width="20" height="20" alt=""><% } %>
          <span><%= it.label %></span>
        </a>
      <% }) %>
    </nav>
    <div class="mb-drawer-foot">
      <form action="/logout" method="POST">
        <button type="submit" class="mb-drawer-item is-danger">
          <%- _ico('logout', 20) %><span>退出登录</span>
        </button>
      </form>
    </div>
  </aside>
  <% } %>

  <!-- 主题三选一（浅色 / 深色 / 跟随系统） -->
  <div class="modal-overlay" id="mbThemeSheet" style="align-items:flex-end;">
    <div class="fm-sheet" role="dialog" aria-modal="true" aria-label="主题">
      <div class="fm-name">主题</div>
      <button type="button" class="fm-item" data-mb-theme="light"><span class="fm-i"><%- _icoSun %></span><span>浅色</span><span class="fm-check"></span></button>
      <button type="button" class="fm-item" data-mb-theme="dark"><span class="fm-i"><%- _icoMoon %></span><span>深色</span><span class="fm-check"></span></button>
      <button type="button" class="fm-item" data-mb-theme="system"><span class="fm-i"><%- _icoAuto %></span><span>跟随系统</span><span class="fm-check"></span></button>
      <button type="button" class="fm-cancel" data-mb-theme-close>取消</button>
    </div>
  </div>

  <script>
  /* ===================== 移动版公共交互（主题 / 抽屉 / 面板 / 提示） ===================== */
  (function () {
    var KEY = 'cr_theme';
    function root() { return document.documentElement; }
    function readTheme() {
      try { var v = localStorage.getItem(KEY); return (v === 'dark' || v === 'light') ? v : null; }
      catch (e) { return null; }
    }
    function applyTheme(v) {
      if (v) { root().setAttribute('data-theme', v); } else { root().removeAttribute('data-theme'); }
    }
    function systemDark() { return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches); }
    function isDark() { var t = readTheme(); if (t === 'dark') { return true; } if (t === 'light') { return false; } return systemDark(); }
    function getTheme() { return readTheme() || 'system'; }
    function setTheme(v) {
      if (v === 'light' || v === 'dark') { try { localStorage.setItem(KEY, v); } catch (e) { } applyTheme(v); }
      else { try { localStorage.removeItem(KEY); } catch (e) { } applyTheme(null); }
      syncThemeUI();
    }
    /* 与桌面版一致的全局接口 */
    window.crSetTheme = setTheme;
    window.crGetTheme = getTheme;
    window.crIsDark = isDark;
    window.crToggleTheme = function () { setTheme(isDark() ? 'light' : 'dark'); };

    var sheet = document.getElementById('mbThemeSheet');
    function syncThemeUI() {
      var cur = getTheme();
      var items = document.querySelectorAll('#mbThemeSheet [data-mb-theme]');
      for (var i = 0; i < items.length; i++) {
        var on = items[i].getAttribute('data-mb-theme') === cur;
        items[i].classList.toggle('is-active', on);
        var ck = items[i].querySelector('.fm-check');
        if (ck) { ck.textContent = on ? '✓' : ''; }
      }
      var btn = document.getElementById('mbThemeBtn');
      if (btn) { btn.setAttribute('aria-pressed', isDark() ? 'true' : 'false'); }
    }
    function openSheet() { if (sheet) { sheet.style.display = 'flex'; syncThemeUI(); } }
    function closeSheet() { if (sheet) { sheet.style.display = 'none'; } }
    var themeBtn = document.getElementById('mbThemeBtn');
    if (themeBtn) { themeBtn.addEventListener('click', openSheet); }
    if (sheet) {
      sheet.addEventListener('click', function (e) {
        if (e.target === sheet || e.target.closest('[data-mb-theme-close]')) { closeSheet(); return; }
        var opt = e.target.closest ? e.target.closest('[data-mb-theme]') : null;
        if (opt) { setTheme(opt.getAttribute('data-mb-theme')); closeSheet(); }
      });
    }
    /* 未手动选择时跟随系统变化 */
    if (window.matchMedia) {
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var onChange = function () { if (!readTheme()) { applyTheme(null); syncThemeUI(); } };
      if (mq.addEventListener) { mq.addEventListener('change', onChange); } else if (mq.addListener) { mq.addListener(onChange); }
    }
    syncThemeUI();

    /* ---------- Toast 短提示（替代 alert） ---------- */
    var toastEl = null, toastTimer = null;
    window.mbToast = function (msg, kind) {
      if (!toastEl) {
        toastEl = document.createElement('div');
        toastEl.className = 'mb-toast';
        toastEl.setAttribute('role', 'status');
        document.body.appendChild(toastEl);
      }
      toastEl.textContent = msg || '';
      toastEl.className = 'mb-toast is-show' + (kind === 'ok' ? ' is-ok' : (kind === 'err' ? ' is-err' : ''));
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toastEl.className = 'mb-toast'; }, 2200);
    };

    /* ---------- 加载遮罩（品牌色环形指示 + 半透明遮罩） ---------- */
    var loadEl = null;
    window.mbLoading = function (show) {
      if (!loadEl) {
        loadEl = document.createElement('div');
        loadEl.className = 'mb-loading';
        var sp = document.createElement('div');
        sp.className = 'mb-spinner';
        loadEl.appendChild(sp);
        document.body.appendChild(loadEl);
      }
      loadEl.classList.toggle('is-show', !!show);
    };

    /* ---------- 自绘圆角确认弹窗（替代 confirm，危险操作主按钮红色） ---------- */
    var cfEl = null, cfOk = null;
    function ensureConfirm() {
      if (cfEl) { return cfEl; }
      cfEl = document.createElement('div');
      cfEl.className = 'modal-overlay';
      cfEl.id = 'mbConfirmModal';
      var box = document.createElement('div');
      box.className = 'modal-content';
      var h = document.createElement('h3');
      h.id = 'mbConfirmTitle';
      var p = document.createElement('p');
      p.className = 'mb-confirm-msg';
      p.id = 'mbConfirmMsg';
      var acts = document.createElement('div');
      acts.className = 'modal-actions';
      cfOk = document.createElement('button');
      cfOk.type = 'button';
      cfOk.className = 'btn btn-primary';
      cfOk.id = 'mbConfirmOk';
      cfOk.textContent = '确定';
      var no = document.createElement('button');
      no.type = 'button';
      no.className = 'btn btn-outline';
      no.id = 'mbConfirmCancel';
      no.textContent = '取消';
      acts.appendChild(cfOk); acts.appendChild(no);
      box.appendChild(h); box.appendChild(p); box.appendChild(acts);
      cfEl.appendChild(box);
      document.body.appendChild(cfEl);
      no.addEventListener('click', function () { cfEl.style.display = 'none'; });
      cfEl.addEventListener('click', function (e) { if (e.target === cfEl) { cfEl.style.display = 'none'; } });
      return cfEl;
    }
    window.mbConfirm = function (opts) {
      opts = opts || {};
      var el = ensureConfirm();
      document.getElementById('mbConfirmTitle').textContent = opts.title || '请确认';
      document.getElementById('mbConfirmMsg').textContent = opts.message || '';
      cfOk.textContent = opts.okText || '确定';
      cfOk.className = 'btn ' + (opts.danger ? 'btn-danger' : 'btn-primary');
      cfOk.onclick = function () {
        el.style.display = 'none';
        if (typeof opts.onOk === 'function') { opts.onOk(); }
      };
      el.style.display = 'flex';
    };

    /* ---------- 自绘单按钮提示弹窗（替代 alert；危险操作可传 danger） ---------- */
    var alEl = null, alOk = null;
    function ensureAlert() {
      if (alEl) { return alEl; }
      alEl = document.createElement('div');
      alEl.className = 'modal-overlay';
      alEl.id = 'mbAlertModal';
      var box = document.createElement('div');
      box.className = 'modal-content';
      var h = document.createElement('h3');
      h.id = 'mbAlertTitle';
      var p = document.createElement('p');
      p.id = 'mbAlertMsg';
      var acts = document.createElement('div');
      acts.className = 'modal-actions';
      alOk = document.createElement('button');
      alOk.type = 'button';
      alOk.className = 'btn btn-primary';
      alOk.id = 'mbAlertOk';
      alOk.textContent = '知道了';
      acts.appendChild(alOk);
      box.appendChild(h); box.appendChild(p); box.appendChild(acts);
      alEl.appendChild(box);
      document.body.appendChild(alEl);
      alOk.addEventListener('click', function () { alEl.style.display = 'none'; });
      alEl.addEventListener('click', function (e) { if (e.target === alEl) { alEl.style.display = 'none'; } });
      return alEl;
    }
    window.mbAlert = function (msg, title) {
      var el = ensureAlert();
      document.getElementById('mbAlertTitle').textContent = title || '提示';
      document.getElementById('mbAlertMsg').textContent = msg || '';
      el.style.display = 'flex';
      try { alOk.focus(); } catch (e) { }
    };
    /* 与桌面版同名接口：app.js 出现 window.crAlert 时走自绘弹窗（不再回退原生 alert） */
    window.crAlert = function (msg, title) { window.mbAlert(msg, title); return Promise.resolve(true); };

    /* ---------- 登录状态失效统一提示（逐字文案） ---------- */
    window.mbAuthExpired = function () { window.mbToast('登录状态已失效，请重新登录', 'err'); };
    /* 拦截 fetch 的 401（移动版所有 JSON 接口调用） */
    if (window.fetch) {
      var _mbFetch = window.fetch;
      window.fetch = function () {
        return _mbFetch.apply(this, arguments).then(function (resp) {
          if (resp && resp.status === 401 && !resp.__mbAuthNotified) { resp.__mbAuthNotified = true; window.mbAuthExpired(); }
          return resp;
        });
      };
    }

    /* ---------- 声明式确认：表单上的 data-mb-confirm 拦截提交（替代 confirm） ---------- */
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (!f || !f.getAttribute || !f.getAttribute('data-mb-confirm')) { return; }
      if (f.getAttribute('data-mb-confirmed') === '1') { f.removeAttribute('data-mb-confirmed'); return; }
      e.preventDefault();
      e.stopPropagation();
      window.mbConfirm({
        title: f.getAttribute('data-mb-confirm-title') || '请确认',
        message: f.getAttribute('data-mb-confirm'),
        okText: f.getAttribute('data-mb-confirm-ok') || '确定',
        danger: f.getAttribute('data-mb-confirm-danger') === '1',
        onOk: function () {
          f.setAttribute('data-mb-confirmed', '1');
          if (f.requestSubmit) { f.requestSubmit(); } else { f.submit(); }
        }
      });
    }, true);

    /* ---------- 更多抽屉 ---------- */
    var drawer = document.getElementById('mbDrawer');
    var mask = document.getElementById('mbDrawerMask');
    function openDrawer() {
      if (!drawer) { return; }
      drawer.classList.add('is-open');
      if (mask) { mask.classList.add('is-open'); }
      var b = document.getElementById('mbBurgerBtn'), m = document.getElementById('mbMoreBtn');
      if (b) { b.setAttribute('aria-expanded', 'true'); }
      if (m) { m.setAttribute('aria-expanded', 'true'); }
    }
    function closeDrawer() {
      if (!drawer) { return; }
      drawer.classList.remove('is-open');
      if (mask) { mask.classList.remove('is-open'); }
      var b = document.getElementById('mbBurgerBtn'), m = document.getElementById('mbMoreBtn');
      if (b) { b.setAttribute('aria-expanded', 'false'); }
      if (m) { m.setAttribute('aria-expanded', 'false'); }
    }
    window.mbCloseDrawer = closeDrawer;
    var burger = document.getElementById('mbBurgerBtn'), more = document.getElementById('mbMoreBtn');
    if (burger) { burger.addEventListener('click', function () { drawer && drawer.classList.contains('is-open') ? closeDrawer() : openDrawer(); }); }
    if (more) { more.addEventListener('click', function () { drawer && drawer.classList.contains('is-open') ? closeDrawer() : openDrawer(); }); }
    if (mask) { mask.addEventListener('click', closeDrawer); }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.keyCode === 27) { closeDrawer(); closeSheet(); }
    });

    /* ---------- 面板切换（底部 Tab 4 项 + 抽屉/快捷卡 data-goto） ---------- */
    function paneExists(tab) { return !!document.getElementById('mbp-' + tab); }
    window.mbShowPane = function (tab) {
      if (!paneExists(tab)) { return false; }
      var panes = document.querySelectorAll('.mb-pane');
      for (var i = 0; i < panes.length; i++) { panes[i].hidden = (panes[i].id !== 'mbp-' + tab); }
      var tabs = document.querySelectorAll('#mbTabbar .mb-tab');
      for (var j = 0; j < tabs.length; j++) {
        tabs[j].classList.toggle('active', tabs[j].getAttribute('data-tab') === tab);
      }
      var t = document.getElementById('mbNavTitle');
      if (t) { var nv = t.getAttribute('data-title-' + tab); if (nv) { t.textContent = nv; } }
      var items = document.querySelectorAll('.mb-drawer-item[data-goto]');
      for (var k = 0; k < items.length; k++) {
        items[k].classList.toggle('is-active', items[k].getAttribute('data-goto') === tab);
      }
      window.scrollTo(0, 0);
      return true;
    };

    function init() {
      document.addEventListener('click', function (e) {
        if (!e.target.closest) { return; }
        var el = e.target.closest('[data-goto]');
        if (!el) { return; }
        if (!paneExists(el.getAttribute('data-goto'))) { return; }   /* 非本页面板 → 正常跳转 */
        e.preventDefault();
        closeDrawer();
        window.mbShowPane(el.getAttribute('data-goto'));
      });
      var tabs = document.querySelectorAll('#mbTabbar .mb-tab');
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].addEventListener('click', function (ev) {
          window.mbShowPane(ev.currentTarget.getAttribute('data-tab'));
        });
      }
      /* 支持从其它页面带 ?tab= 进入（files / teams / account 等映射到同名面板） */
      var m = /[?&]tab=([^&]+)/.exec(window.location.search);
      var map = { files: 'files', teams: 'team', team: 'team', account: 'me', me: 'me' };
      var tab = m ? map[decodeURIComponent(m[1])] : null;
      if (!tab || !window.mbShowPane(tab)) {
        var first = document.querySelector('.mb-pane');
        if (first) { window.mbShowPane(first.id.replace('mbp-', '')); }
      }
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
  })();
  </script>
  <main class="main-content">
