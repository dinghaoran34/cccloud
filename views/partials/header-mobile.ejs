  function _ico(k, s, rule) {
    var parts = (_I[k] || []).map(function (p) {
      return '<path d="' + p[0] + '"' + (p[1] ? ' opacity="' + p[1] + '"' : '') + '/>';
    }).join('');
    return '<svg viewBox="0 0 24 24" width="' + s + '" height="' + s + '" fill="currentColor"'
      + (rule === false ? '' : ' fill-rule="evenodd"') + ' aria-hidden="true">' + parts + '</svg>';
  }
  /* 品牌标记：圆角方块 + 镂空 C（CC网盘 首字母，原创几何） */
  var _brandMark = function (s) {
    return '<svg viewBox="0 0 24 24" width="' + s + '" height="' + s + '" aria-hidden="true">'
      + '<path fill="var(--cr-primary)" fill-rule="evenodd" d="M7.6 2.4h8.8a5.2 5.2 0 0 1 5.2 5.2v8.8a5.2 5.2 0 0 1-5.2 5.2h-8.8a5.2 5.2 0 0 1-5.2-5.2V7.6a5.2 5.2 0 0 1 5.2-5.2zM16.26 15.32A5.4 5.4 0 1 1 16.26 8.68L14.64 9.94A3.35 3.35 0 1 0 14.64 14.06Z"/></svg>';
  };
  /* 外观切换三态（浅色 / 深色 / 跟随系统）：原创几何，圆角填充 + 极简线性细节 */
  var _icoSun = '<svg class="cr-i-sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">'
    + '<path fill-rule="evenodd" d="M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2z"/>'
    + '<g stroke="currentColor" stroke-width="2" stroke-linecap="round">'
    + '<path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M5.2 18.8l1.6-1.6M17.2 6.8l1.6-1.6"/></g></svg>';
  var _icoMoon = '<svg class="cr-i-moon" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">'
    + '<path d="M10.34 3.36A8.8 8.8 0 1 0 20.64 13.66A7.4 7.4 0 0 1 10.34 3.36z"/></svg>';
  var _icoAuto = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">'
    + '<path d="M12 4.4a7.6 7.6 0 1 0 0 15.2z"/>'
    + '<circle cx="12" cy="12" r="7.6" fill="none" stroke="currentColor" stroke-width="2"/></svg>';

  /* 导航条目（顺序 / 命名与桌面侧边栏及安卓端一致；goto = 移动版同名面板 id）
     svg = 新风格内联图标；icon 保留为 <img> 回退路径 */
  var _navItems = [
    { key: 'home',     label: '首页',     href: '/dashboard',           goto: 'home',  icon: '/icons/home.svg',     svg: _ico('home', 20) },
    { key: 'files',    label: '文件',     href: '/dashboard?tab=files', goto: 'files', icon: '/icons/folder.svg',   svg: _ico('folder', 20) },
    { key: 'shares',   label: '我的分享', href: '/shares',              icon: '/icons/share.svg',    svg: _ico('share', 20) },
