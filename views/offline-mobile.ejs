<%- include('partials/header-mobile') %>

<div id="alert"></div>
<div id="aria2Notice"></div>

<div class="mb-toolbar">
  <span class="mb-toolbar-sub" id="count">离线下载</span>
  <span class="mb-spring"></span>
  <button type="button" class="btn btn-primary btn-sm" id="newBtn">新建任务</button>
</div>

<div class="card" id="list">
  <div class="card-body"><div class="empty-state"><p>加载中…</p></div></div>
</div>

<!-- ==================== 新建任务弹窗 ==================== -->
<div id="newModal" class="modal-overlay" style="display:none;">
  <div class="modal-content" role="dialog" aria-modal="true" aria-label="新建离线下载任务">
    <h3><img src="/icons/download.svg" width="18" height="18" alt=""> 新建离线下载任务</h3>
    <div class="mb-field">
      <label for="newUrl">下载链接（HTTP / HTTPS 直链，或 magnet: 磁力链接）</label>
      <input id="newUrl" type="text" placeholder="https://example.com/file.zip" autocomplete="off" spellcheck="false">
    </div>
    <p class="mb-hint" id="magnetHint"></p>
    <div class="modal-actions">
      <button type="button" class="btn btn-outline" id="newCancel">取消</button>
      <button type="button" class="btn btn-primary" id="newSubmit">开始下载</button>
    </div>
  </div>
</div>

<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var timer = null, aria2 = null;

  function esc(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  function say(t, ok){
    var a = $('alert');
    a.innerHTML = '';
    if (t) { a.className = 'alert ' + (ok ? 'alert-success' : 'alert-error'); a.textContent = t; }
    else { a.className = ''; }
  }
  function info(title, msg){ window.mbAlert(msg, title); }
  function confirmBox(title, msg, onOk){
    window.mbConfirm({ title: title || '请确认', message: msg || '', onOk: onOk });
  }

  var STATUS = {
    queued:   { text: '排队中', cls: 'is-muted' },
    running:  { text: '下载中', cls: 'is-primary' },
    paused:   { text: '已暂停', cls: 'is-muted' },
    done:     { text: '已完成', cls: 'is-success' },
    error:    { text: '失败',   cls: 'is-danger' },
    canceled: { text: '已取消', cls: 'is-muted' }
  };

  function renderAria2(){
    var box = $('aria2Notice');
    if (!aria2) { box.innerHTML = ''; return; }
    if (aria2.available) {
      box.innerHTML = '<div class="alert alert-success" style="display:block;">'
        + '已检测到 Aria2 服务（' + esc(aria2.url) + '）：磁力 / 种子任务将交由 Aria2 下载。</div>';
    } else {
      box.innerHTML = '<div class="alert alert-error" style="display:block;">'
        + '<strong>磁力 / 种子需要部署 Aria2（未检测到 ' + esc(aria2.url) + '）</strong><br>'
        + '配置方法：部署 Aria2 并开启 RPC（<code>aria2c --enable-rpc --rpc-listen-all=false --rpc-listen-port=6800</code>），'
        + '然后设置环境变量 <code>ARIA2_RPC_URL</code>（默认 http://127.0.0.1:6800/jsonrpc）与可选 <code>ARIA2_RPC_SECRET</code>，重启本服务即可。'
        + '当前磁力入口保留但不可用，直链（HTTP/HTTPS）下载不受影响。</div>';
    }
  }

  function rowHtml(t){
    var st = STATUS[t.status] || { text: t.status, cls: 'is-muted' };
    var src = t.source === 'aria2' ? '磁力/Aria2' : '直链';
    var sizeText = t.totalBytes > 0 ? t.totalText : t.doneText;
    var pct = t.percent;
    var barCls = t.status === 'error' ? ' progress-error' : '';
    var progress = '<div class="progress-track" title="' + pct + '%"><div class="progress-bar' + barCls + '" style="width:' + pct + '%"></div></div>'
      + '<div class="mb-hint" style="margin-top:4px;">' + pct + '% · ' + esc(t.doneText) + (t.totalBytes > 0 ? ' / ' + esc(t.totalText) : '')
      + (t.speed > 0 ? ' · ' + esc(t.speedText) : '') + '</div>';
    var ops = '';
    var btn = function(act, label, cls){ return '<button type="button" class="btn btn-sm ' + (cls || 'btn-outline') + '" data-act="' + act + '" data-id="' + t.id + '">' + label + '</button>'; };
    if (t.status === 'running' || t.status === 'queued') { ops += btn('pause', '暂停'); ops += btn('cancel', '取消'); }
    if (t.status === 'paused') { ops += btn('resume', '继续'); ops += btn('cancel', '取消'); ops += btn('delete', '删除', 'btn-danger'); }
    if (t.status === 'error' || t.status === 'canceled') { ops += btn('retry', '重试'); ops += btn('delete', '删除', 'btn-danger'); }
    if (t.status === 'done') {
      if (t.resultFileId) ops += '<a class="btn btn-outline btn-sm" href="/download/' + t.resultFileId + '">下载</a>';
      ops += btn('delete', '删除', 'btn-danger');
    }
    var errHtml = t.error ? '<div class="mb-hint" style="color:var(--cr-danger);margin-top:4px;">' + esc(t.error) + '</div>' : '';
    var urlText = t.url || '';
    return '<div class="mb-item">'
      + '<div class="mb-item-main">'
      + '<span class="file-icon mb-ico--video"><img src="/icons/download.svg" width="20" height="20" alt=""></span>'
      + '<div class="file-info"><div class="file-name" title="' + esc(urlText) + '">' + esc(t.filename) + '</div>'
      + '<div class="file-meta">' + esc(src) + ' · ' + esc(sizeText) + ' · 更新于 ' + esc(t.updatedAt || t.createdAt || '—') + '</div>'
      + '<div class="file-meta" style="word-break:break-all;">' + esc(urlText.length > 90 ? urlText.slice(0, 90) + '…' : urlText) + '</div>' + errHtml + '</div>'
      + '<span class="mb-tag ' + st.cls + '">' + esc(st.text) + '</span>'
      + '</div>'
      + '<div style="margin-top:var(--cr-sp-2);">' + progress + '</div>'
      + '<div class="mb-row-ops">' + ops + '</div>'
      + '</div>';
  }

  function render(tasks){
    var c = $('list');
    $('count').textContent = '离线下载（共 ' + tasks.length + ' 个任务）';
    if (!tasks.length) {
      c.innerHTML = '<div class="card-body"><div class="empty-state">'
        + '<div class="empty-icon"><img src="/icons/empty.svg" width="24" height="24" alt=""></div>'
        + '<p>暂无内容</p><span class="empty-desc">暂无离线下载任务，点击右上角「新建任务」开始</span>'
        + '<button type="button" class="btn btn-primary" id="emptyNewBtn">新建任务</button></div></div>';
      var eb = $('emptyNewBtn');
      if (eb) { eb.onclick = openNew; }
      return;
    }
    c.innerHTML = tasks.map(rowHtml).join('');
  }

  function load(){
    var x = new XMLHttpRequest();
    x.open('GET', '/api/offline/list');
    x.onload = function(){
      if (x.status === 401) { window.mbAuthExpired(); return; }
      var j = null; try { j = JSON.parse(x.responseText); } catch(e) {}
      if (!j || !j.ok) { render([]); say((j && j.error) || '任务列表加载失败'); return; }
      aria2 = j.aria2 || null;
      renderAria2();
      render(j.tasks || []);
    };
    x.onerror = function(){ say('网络异常，请重试'); };
    x.send();
  }

  function post(url, body, onOk){
    if (window.mbLoading) { window.mbLoading(true); }
    var x = new XMLHttpRequest();
    x.open('POST', url);
    x.setRequestHeader('Content-Type', 'application/json');
    x.onload = function(){
      if (window.mbLoading) { window.mbLoading(false); }
      if (x.status === 401) { window.mbAuthExpired(); return; }
      var j = null; try { j = JSON.parse(x.responseText); } catch(e) {}
      if (j && j.ok) { say(''); if (onOk) onOk(j); load(); }
      else { info('操作失败', (j && j.error) || '操作失败，请稍后重试'); }
    };
    x.onerror = function(){
      if (window.mbLoading) { window.mbLoading(false); }
      info('网络异常', '网络异常，请重试');
    };
    x.send(JSON.stringify(body || {}));
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('[data-act]') : null;
    if (!btn) return;
    var id = Number(btn.dataset.id);
    var act = btn.dataset.act;
    if (act === 'pause') post('/api/offline/pause', { id: id });
    else if (act === 'resume') post('/api/offline/resume', { id: id });
    else if (act === 'retry') post('/api/offline/retry', { id: id });
    else if (act === 'cancel') confirmBox('取消任务', '确定取消该离线下载任务？已下载的临时分片将被删除。', function(){ post('/api/offline/cancel', { id: id }); });
    else if (act === 'delete') confirmBox('删除记录', '确定删除该任务记录？该操作不会删除已保存到网盘的文件。', function(){ post('/api/offline/delete', { id: id }); });
  });

  function openNew(){
    $('newUrl').value = '';
    $('magnetHint').textContent = (aria2 && aria2.available)
      ? '已检测到 Aria2：磁力 / 种子链接可直接提交。'
      : ('当前未检测到 Aria2（' + ((aria2 && aria2.url) || 'http://127.0.0.1:6800/jsonrpc') + '）：磁力 / 种子提交会被拒绝，请先部署 Aria2。直链不受影响。');
    $('newModal').style.display = 'flex';
    setTimeout(function(){ try { $('newUrl').focus(); } catch(e){} }, 30);
  }
  $('newBtn').onclick = openNew;
  $('newCancel').onclick = function(){ $('newModal').style.display = 'none'; };
  $('newModal').addEventListener('click', function(e){ if (e.target === $('newModal')) $('newModal').style.display = 'none'; });

  $('newSubmit').onclick = function(){
    var url = String($('newUrl').value || '').trim();
    if (!url) { info('参数不完整', '请填写下载链接'); return; }
    if (/^(?!https?:|magnet:)/i.test(url)) { info('链接不合法', '仅支持 http/https 直链或 magnet: 磁力链接'); return; }
    if (/^magnet:/i.test(url) && aria2 && !aria2.available) {
      info('磁力/种子需要部署 Aria2', '未检测到 ' + aria2.url + '。\n请部署 Aria2 并开启 RPC，配置环境变量 ARIA2_RPC_URL / ARIA2_RPC_SECRET 后重启服务。');
      return;
    }
    post('/api/offline/create', { url: url }, function(){ $('newModal').style.display = 'none'; });
  };

  load();
  timer = setInterval(function(){ if (!document.hidden) load(); }, 2000);
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) load(); });
})();
</script>

<%- include('partials/footer-mobile') %>
