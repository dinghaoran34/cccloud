<%
function formatFileSize(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
  return (bytes / 1073741824).toFixed(1) + ' GB';
}

function fileIconPath(filename) {
  var ext = filename.split('.').pop().toLowerCase();
  var types = {
    pdf: 'pdf', doc: 'doc', docx: 'doc',
    xls: 'xls', xlsx: 'xls',
    ppt: 'ppt', pptx: 'ppt',
    jpg: 'img', jpeg: 'img', png: 'img', gif: 'img', bmp: 'img', webp: 'img', svg: 'img',
    mp3: 'audio', wav: 'audio', flac: 'audio', m4a: 'audio', ogg: 'audio',
    mp4: 'video', avi: 'video', mkv: 'video', mov: 'video', wmv: 'video', webm: 'video',
    zip: 'archive', rar: 'archive', '7z': 'archive', tar: 'archive', gz: 'archive',
    txt: 'text', md: 'text', log: 'text',
    js: 'code', html: 'code', css: 'code', py: 'code', json: 'code', ts: 'code', java: 'code',
    exe: 'exe', msi: 'exe', bat: 'exe', apk: 'exe'
  };
  return '/icons/file-' + (types[ext] || 'generic') + '.svg';
}

/* 彩色类型图标底色类名（对应 style-mobile.css 的 .mb-ico--*，使用 --cr-tint-* 令牌） */
function fileTintClass(filename) {
  var key = fileIconPath(filename).replace('/icons/file-', '').replace('.svg', '');
  var map = {
    pdf: 'doc', doc: 'doc', xls: 'doc', ppt: 'doc', text: 'doc', code: 'doc',
    img: 'image', video: 'video', archive: 'archive'
  };
  return 'mb-ico--' + (map[key] || 'other');
}
%>
<%- include('partials/header-mobile') %>
<script>document.body.classList.add('app-top');</script>

<section id="mbp-home" class="mb-pane">
<!-- 网盘容量进度条 -->
<% var usedPct = Math.min(100, Math.round(usage.used / usage.quota * 1000) / 10); %>
<% var barColor = usedPct >= 95 ? 'var(--cr-danger)' : (usedPct >= 80 ? 'var(--cr-warning)' : 'var(--cr-primary)'); %>
<div class="usage-card">
  <div class="usage-head">
    <span class="usage-title"><img src="/icons/storage.svg" width="16" height="16" alt=""> 网盘容量</span>
    <span class="usage-text">已用 <b><%= formatFileSize(usage.used) %></b> / <%= formatFileSize(usage.quota) %>（<%= usedPct %>%）</span>
  </div>
  <div class="progress-track usage-track">
    <div class="progress-bar" style="width: <%= usedPct %>% ; background: <%= barColor %>;"></div>
  </div>
  <% if (usedPct >= 95) { %>
    <p class="usage-warn"><img src="/icons/warning.svg" width="16" height="16" alt=""> 容量即将用尽，请及时清理文件</p>
  <% } %>
</div>
<% if (typeof uploadError !== 'undefined' && uploadError) { %>
  <div class="alert alert-error">
    <span class="alert-icon"><img src="/icons/warning.svg" width="18" height="18" alt=""></span>
    <span><%= uploadError %></span>
  </div>
<% } %>

<!-- 快捷操作(双卡) -->
<div class="mb-quick">
  <button type="button" class="mb-qcard" data-goto="files">
    <span class="mb-qico"><img src="/icons/upload.svg" width="24" height="24" alt=""></span>
    <b>上传文件</b>
    <i>保存到我的网盘</i>
  </button>
</div>

<!-- 最近文件 -->
<div class="mb-recent">
  <div class="mb-recent-head">
    <span>📁 文件</span>
    <button type="button" class="mb-more" data-goto="files">查看全部 &rsaquo;</button>
  </div>
  <% if (personalFiles.length === 0) { %>
    <div class="mb-recent-empty">
      <span class="mb-recent-empty-ico"><img src="/icons/empty.svg" width="24" height="24" alt=""></span>
      <p>暂无内容</p>
      <span class="mb-dim" style="display:block; font-size:13px; margin-top:4px;">上传文件或新建文件夹后会显示在这里</span>
      <button type="button" class="btn btn-primary" data-goto="files">上传文件</button>
    </div>
  <% } else { %>
    <% personalFiles.slice(0, 5).forEach(function(file) { %>
      <a class="mb-recent-item" href="/download/<%= file.id %>">
        <span class="mb-r-ico <%= fileTintClass(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="20" height="20" alt=""></span>
        <span class="mb-r-info"><b><%= file.filename %></b><i><%= formatFileSize(file.file_size) %> · <%= new Date(file.uploaded_at).toLocaleDateString('zh-CN') %></i></span>
        <span class="mb-r-arrow">&rsaquo;</span>
      </a>
    <% }) %>
  <% } %>
</div>
</section>
<section id="mbp-files" class="mb-pane" hidden>
<!-- 上传区 -->
<div class="card">
  <div class="card-header">
    <h2><img src="/icons/upload.svg" width="18" height="18" alt=""> 上传文件</h2>
  </div>
  <div class="card-body">
    <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form">
      <div class="upload-options">
        <label class="radio-label">
          <input type="radio" name="share" value="false" checked>
          <span>个人</span>
        </label>
      </div>
      <input type="hidden" name="folderId" value="<%= currentFolderId || '' %>">
      <div class="file-input-wrapper">
        <input type="file" name="file" id="fileInput" required>
        <label for="fileInput" class="file-input-label">
          <img src="/icons/folder.svg" width="16" height="16" alt=""><span id="fileLabel">选择文件</span>
          <span class="file-hint">最大1GB</span>
        </label>
      </div>
      <div class="upload-progress" style="display:none;">
        <div class="progress-track"><div class="progress-bar"></div></div>
        <div class="progress-info">
          <span class="progress-pct">0%</span>
          <span class="progress-speed">--</span>
          <span class="progress-eta"></span>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block">上传</button>
    </form>
  </div>
</div>

<!-- 个人文件 -->
<div class="card">
  <div class="card-header">
    <!-- 面包屑导航 -->
    <h2>
      <a href="/dashboard" style="color:inherit;text-decoration:none;"><img src="/icons/folder.svg" width="16" height="16" alt=""> 全部文件</a>
      <% folderPath.forEach(function(f) { %>
        <span style="color:var(--cr-muted);">›</span>
        <% if (f.id === currentFolderId) { %>
          <span style="color:var(--cr-primary);"><%= f.name %></span>
        <% } else { %>
          <a href="/dashboard?folder=<%= f.id %>" style="color:inherit;text-decoration:none;"><%= f.name %></a>
        <% } %>
      <% }) %>
    </h2>
    <span class="badge"><%= folders.length + personalFiles.length %></span>
  </div>
  <div class="card-body" style="padding:0;">
    <!-- 新建文件夹 -->
    <form action="/folder/create" method="POST" style="display:flex;gap:8px;padding:12px;border-bottom:1px solid var(--cr-border);">
      <input type="hidden" name="parentId" value="<%= currentFolderId || '' %>">
      <input type="text" name="name" placeholder="新建文件夹名称" required maxlength="60" style="flex:1;min-width:0;padding:8px 12px;border:1px solid var(--cr-border);border-radius:var(--cr-radius);font-size:15px;">
      <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;"><img src="/icons/folder.svg" width="16" height="16" alt=""> 新建</button>
    </form>
    <% if (folders.length === 0 && personalFiles.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><img src="/icons/empty.svg" width="24" height="24" alt=""></div>
        <p>暂无内容</p>
        <span class="empty-desc">新建一个文件夹或上传文件吧</span>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('fileInput').click()">上传文件</button>
      </div>
    <% } else { %>
      <% folders.forEach(function(f) { %>
        <div class="file-item">
          <span class="file-icon mb-ico--folder"><img src="/icons/folder.svg" width="20" height="20" alt=""></span>
          <div class="file-info">
            <a href="/dashboard?folder=<%= f.id %>" style="color:inherit;text-decoration:none;display:block;"><%= f.name %></a>
            <div class="file-meta">文件夹</div>
          </div>
          <div class="file-actions">
            <button type="button" class="fm-btn" title="更多操作" data-kind="folder" data-fid="<%= f.id %>" data-name="<%= f.name %>" onclick="openFileMenu(this)">⋯</button>
          </div>
        </div>
      <% }) %>
      <% personalFiles.forEach(function(file) { %>
        <div class="file-item">
          <span class="file-icon <%= fileTintClass(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="20" height="20" alt=""></span>
          <div class="file-info">
            <div class="file-name"><%= file.filename %></div>
            <div class="file-meta"><%= formatFileSize(file.file_size) %> · <%= new Date(file.uploaded_at).toLocaleDateString('zh-CN') %></div>
          </div>
          <div class="file-actions">
            <button type="button" class="fm-btn" title="更多操作" data-kind="file" data-fid="<%= file.id %>" data-name="<%= file.filename %>" data-team="" data-canshare="1" onclick="openFileMenu(this)">⋯</button>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

</section>

<section id="mbp-team" class="mb-pane" hidden>
<div class="card">
  <div class="card-header">
    <h2><img src="/icons/users.svg" width="18" height="18" alt=""> 团队空间</h2>
    <span class="badge">UID:<%= currentUser.uid %></span>
  </div>
  <div class="card-body">
    <% if (typeof teamSuccess !== 'undefined' && teamSuccess) { %>
      <div class="alert alert-success"><span><img src="/icons/check.svg" width="16" height="16" alt=""></span><span><%= teamSuccess %></span></div>
    <% } %>
    <% if (typeof teamError !== 'undefined' && teamError) { %>
      <div class="alert alert-error"><span><img src="/icons/warning.svg" width="16" height="16" alt=""></span><span><%= teamError %></span></div>
    <% } %>

    <% if (!hasTeam) { %>
      <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:12px;">您还未加入任何团队。创建团队或输入团队长UID加入。</p>

      <h3 style="font-size:17px; margin-bottom:8px;"><img src="/icons/plus.svg" width="16" height="16" alt=""> 创建团队</h3>
      <form action="/team/create" method="POST" style="margin-bottom:16px;">
        <input type="text" name="name" placeholder="团队名称" required style="width:100%; margin-bottom:8px;">
        <button type="submit" class="btn btn-primary btn-block">创建团队</button>
      </form>

      <h3 style="font-size:17px; margin-bottom:8px;"><img src="/icons/key.svg" width="16" height="16" alt=""> 加入团队</h3>
      <form action="/team/join" method="POST">
        <input type="text" name="ownerUid" placeholder="团队长的UID" required style="width:100%; margin-bottom:8px; text-transform:uppercase;">
        <button type="submit" class="btn btn-primary btn-block">加入团队</button>
      </form>
    <% } else { %>
      <% teams.forEach(function(team) { %>
        <div class="mb-box">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
            <h3 style="margin:0; font-size:17px;"><img src="/icons/folder.svg" width="18" height="18" alt=""> <%= team.name %></h3>
            <% if (team.isOwner) { %><span class="badge">团队长</span><% } %>
          </div>
          <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:12px;">团队长: <%= team.owner_name %> (UID: <%= team.owner_uid %>)</p>

          <form action="/team/<%= team.id %>/upload" method="POST" enctype="multipart/form-data" style="margin-bottom:12px;">
            <div class="file-input-wrapper" style="margin-bottom: 8px;">
              <input type="file" name="file" id="teamFileM<%= team.id %>" required>
              <label for="teamFileM<%= team.id %>" class="file-input-label" style="padding: 12px; flex-direction: row; gap: 8px;">
                <img src="/icons/folder.svg" width="16" height="16" alt="" style="width:16px;height:16px;margin-bottom:0;"><span class="file-label-text" style="font-size:15px;">选择文件</span>
                <span class="file-hint" style="font-size:13px; flex-shrink:0;">上传到团队</span>
              </label>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-sm">上传到团队</button>
            <div class="upload-progress" style="display:none; margin-top:8px;">
              <div class="progress-track"><div class="progress-bar"></div></div>
              <div class="progress-info">
                <span class="progress-pct">0%</span>
                <span class="progress-speed">--</span>
                <span class="progress-eta"></span>
              </div>
            </div>
          </form>

          <% if (team.files.length === 0) { %>
            <p style="color:var(--cr-text-2); font-size:13px; padding:8px 0;">暂无内容</p>
          <% } else { %>
            <% team.files.forEach(function(file) { %>
              <div class="file-item">
                <span class="file-icon <%= fileTintClass(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="20" height="20" alt=""></span>
                <div class="file-info">
                  <div class="file-name"><%= file.filename %></div>
                  <div class="file-meta"><%= formatFileSize(file.file_size) %> · <%= file.uploader_name %></div>
                </div>
                <div class="file-actions">
                  <button type="button" class="fm-btn" title="更多操作" data-kind="file" data-fid="<%= file.id %>" data-name="<%= file.filename %>" data-team="<%= team.id %>" data-canshare="<%= file.user_id === currentUser.id ? '1' : '0' %>" onclick="openFileMenu(this)">⋯</button>
                </div>
              </div>
            <% }) %>
          <% } %>

          <% if (team.isOwner) { %>
            <div class="mb-sep" style="margin-top:12px; padding-top:12px;">
              <h4 style="font-size:15px; margin-bottom:8px;"><img src="/icons/users.svg" width="16" height="16" alt=""> 团员管理</h4>
              <form action="/team/<%= team.id %>/add-member" method="POST" style="display:flex; gap:8px; margin-bottom:12px;">
                <input type="text" name="targetUid" placeholder="输入UID添加团员" required style="flex:1; min-width:0; padding:8px; border:1px solid var(--cr-border); border-radius:var(--cr-radius); font-size:13px; text-transform:uppercase;">
                <button type="submit" class="btn btn-primary btn-sm">添加</button>
              </form>
              <% team.members.forEach(function(m) { %>
                <div class="file-item">
                  <span class="file-icon"><% if (m.uid === team.owner_uid) { %><img src="/icons/crown.svg" width="20" height="20" alt=""><% } else { %><img src="/icons/user.svg" width="20" height="20" alt=""><% } %></span>
                  <div class="file-info">
                    <div class="file-name"><%= m.username %><% if (m.uid === team.owner_uid) { %> (团队长)<% } %></div>
                    <div class="file-meta"><%= m.uid %></div>
                  </div>
                  <div class="file-actions">
                    <% if (m.uid !== team.owner_uid) { %>
                      <form action="/team/<%= team.id %>/remove-member" method="POST" style="display:inline;" data-mb-confirm="确定移除该团员？" data-mb-confirm-title="移除团员" data-mb-confirm-ok="移除">
                        <input type="hidden" name="memberUserId" value="<%= m.id %>">
                        <button type="submit" class="btn btn-sm btn-danger">移除</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <form action="/team/<%= team.id %>/leave" method="POST" style="margin-top:12px;">
            <button type="submit" class="btn btn-outline btn-block btn-sm">退出团队</button>
          </form>

          <% if (team.isOwner) { %>
            <div class="mb-sep-danger" style="margin-top:12px; padding-top:12px;">
              <p style="color:var(--cr-danger); font-size:13px; margin-bottom:8px;"><img src="/icons/warning.svg" width="16" height="16" alt=""> 解散团队将删除所有团队文件，不可恢复。</p>
              <button type="button" class="btn btn-danger btn-block btn-sm" onclick="document.getElementById('dissolveFormM<%= team.id %>').style.display='block'">解散团队</button>
              <div id="dissolveFormM<%= team.id %>" style="display:none; margin-top:8px;">
                <form action="/team/<%= team.id %>/dissolve" method="POST" data-mb-confirm="解散后所有团队文件将被永久删除，且不可恢复。" data-mb-confirm-title="解散团队" data-mb-confirm-ok="确认解散" data-mb-confirm-danger="1">
                  <input type="password" name="password" required placeholder="输入账户密码" style="width:100%; margin-bottom:8px; padding:8px; border:1px solid var(--cr-danger); border-radius:var(--cr-radius);">
                  <button type="submit" class="btn btn-danger btn-block btn-sm">确认解散</button>
                  <button type="button" class="btn btn-outline btn-block btn-sm" onclick="document.getElementById('dissolveFormM<%= team.id %>').style.display='none'">取消</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<!-- 账户管理 -->
</section>
<section id="mbp-me" class="mb-pane" hidden>
<div class="card">
  <div class="card-header">
    <h2><img src="/icons/gear.svg" width="18" height="18" alt=""> 账户管理</h2>
  </div>
  <div class="card-body">
    <% if (typeof passwordSuccess !== 'undefined' && passwordSuccess) { %>
      <div class="alert alert-success"><span><img src="/icons/check.svg" width="16" height="16" alt=""></span><span><%= passwordSuccess %></span></div>
    <% } %>
    <% if (typeof passwordError !== 'undefined' && passwordError) { %>
      <div class="alert alert-error"><span><img src="/icons/warning.svg" width="16" height="16" alt=""></span><span><%= passwordError %></span></div>
    <% } %>
    <% if (typeof deleteError !== 'undefined' && deleteError) { %>
      <div class="alert alert-error"><span><img src="/icons/warning.svg" width="16" height="16" alt=""></span><span><%= deleteError %></span></div>
    <% } %>

    <div style="margin-bottom:16px; padding-bottom:16px; border-bottom:1px solid var(--cr-border);">
      <h3 style="margin-bottom:12px; font-size:17px;"><img src="/icons/user.svg" width="16" height="16" alt=""> 个人资料</h3>
      <div style="display:flex; align-items:center; gap: 12px;">
        <div style="text-align:center;">
          <img id="mbProfileAvatar" src="<%= currentUser.avatar ? ('/avatar/' + currentUser.uid) : '/icons/user.svg' %>" alt="头像"
               style="width:64px;height:64px;border-radius:50%;object-fit:cover;background:var(--cr-hover);border:1px solid var(--cr-border);">
          <div style="margin-top:8px; font-size:13px;">
            <label for="mbAvatarInput" style="color:var(--cr-primary);">更换头像</label>
            <input type="file" id="mbAvatarInput" accept="image/*" style="display:none;">
          </div>
        </div>
        <div style="flex:1;">
          <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:4px;">登录名：<b class="mb-strong"><%= currentUser.username %></b></p>
          <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:8px;">团队ID：<b class="mb-strong"><%= currentUser.uid %></b></p>
          <div style="display:flex; gap:8px;">
            <input type="text" id="mbNicknameInput" maxlength="20" value="<%= currentUser.nickname || currentUser.username %>"
                   placeholder="昵称（≤20字）" style="flex:1; padding:8px 12px; border:1px solid var(--cr-border); border-radius:var(--cr-radius); font-size:15px;">
            <button type="button" class="btn btn-primary btn-sm" id="mbSaveNicknameBtn">保存</button>
          </div>
        </div>
      </div>
      <div id="mbProfileMsg" style="color:var(--cr-success); font-size:13px; margin-top:8px; min-height:16px;"></div>
    </div>

    <div style="margin-bottom:16px; padding-bottom:16px; border-bottom:1px solid var(--cr-border);">
      <h3 style="margin-bottom:8px; font-size:17px;"><img src="/icons/lock.svg" width="16" height="16" alt=""> 修改密码</h3>
      <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:12px;">需验证原密码。</p>
      <button type="button" class="btn btn-primary btn-block" id="changePasswordBtn">修改密码</button>
    </div>

    <h3 style="margin-bottom:8px; font-size:17px; color:var(--cr-danger);"><img src="/icons/trash.svg" width="16" height="16" alt=""> 注销账户</h3>
    <p style="color:var(--cr-text-2); font-size:13px; margin-bottom:12px;">注销账户将永久删除所有文件，不可恢复。</p>
    <button type="button" class="btn btn-danger btn-block" id="deleteAccountBtn"><img src="/icons/trash.svg" width="16" height="16" alt=""> 注销账户</button>
  </div>
</div>

</section>

<!-- 底部导航(123云盘式) -->
<nav class="mb-tabbar" id="mbTabbar">
  <button type="button" class="mb-tab active" data-tab="home"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M11.06 3.05a1.6 1.6 0 0 1 1.88 0l7.24 5.73c.4.32.64.8.64 1.32v8.5A2.4 2.4 0 0 1 18.42 21H5.58A2.4 2.4 0 0 1 3.18 18.6v-8.5c0-.52.24-1 .64-1.32zM12 14.6h0a1.85 1.85 0 0 1 1.85 1.85v1.5a1.85 1.85 0 0 1-1.85 1.85h0a1.85 1.85 0 0 1-1.85-1.85v-1.5a1.85 1.85 0 0 1 1.85-1.85z"/></svg><span>首页</span></button>
  <button type="button" class="mb-tab" data-tab="files"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.8 7.6A2.8 2.8 0 0 1 5.6 4.8h3.36c.74 0 1.45.29 1.98.8l1.1 1.1h6.36a2.8 2.8 0 0 1 2.8 2.8v7.1a2.8 2.8 0 0 1-2.8 2.8H5.6a2.8 2.8 0 0 1-2.8-2.8z"/></svg><span>文件</span></button>
