<script>
(function() {
  var panes = ['home', 'files', 'team', 'me'];
  function show(name) {
    panes.forEach(function(p) {
      var pane = document.getElementById('mbp-' + p);
      var tab = document.querySelector('#mbTabbar .mb-tab[data-tab="' + p + '"]');
      if (pane) pane.hidden = (p !== name);
      if (tab) tab.classList.toggle('active', p === name);
    });
    window.scrollTo(0, 0);
  }
  document.querySelectorAll('#mbTabbar .mb-tab').forEach(function(t) {
    t.addEventListener('click', function() { show(t.dataset.tab); });
  });
  document.querySelectorAll('[data-goto]').forEach(function(el) {
    el.addEventListener('click', function() { show(el.dataset.goto); });
  });
  show('home');
})();
</script>
<script>
(function() {
  function m$(id) { return document.getElementById(id); }
  function mmsg(msg, ok) {
    var el = m$('mbProfileMsg');
    if (!el) return;
    el.style.color = ok ? 'var(--cr-success)' : 'var(--cr-danger)';
    el.textContent = msg || '';
  }
  function mxhr(method, url, body, okFn, errFn) {
    if (window.mbLoading) { window.mbLoading(true); }
    var x = new XMLHttpRequest();
    x.open(method, url);
    x.setRequestHeader('Accept', 'application/json');
    if (body && !(body instanceof FormData)) x.setRequestHeader('Content-Type', 'application/json');
    x.onload = function() {
      if (window.mbLoading) { window.mbLoading(false); }
      var j = null;
      try { j = JSON.parse(x.responseText); } catch (e) {}
      if (x.status === 401) { window.mbAuthExpired(); if (errFn) errFn('登录状态已失效，请重新登录'); return; }
      if (x.status >= 200 && x.status < 300 && j && j.ok) { if (okFn) okFn(j); }
      else if (errFn) errFn((j && j.error) || '操作失败');
    };
    x.onerror = function() {
      if (window.mbLoading) { window.mbLoading(false); }
      if (errFn) errFn('网络异常，请重试');
    };
    x.send(body ? (body instanceof FormData ? body : JSON.stringify(body)) : null);
  }
  function bindMbProfile() {
    var inp = m$('mbAvatarInput'), btn = m$('mbSaveNicknameBtn'), ni = m$('mbNicknameInput');
    if (inp) {
      inp.addEventListener('change', function() {
        var f = inp.files && inp.files[0];
        if (!f) return;
        if (!/^image\//i.test(f.type)) { mmsg('仅支持图片文件', false); return; }
        if (f.size > 5 * 1024 * 1024) { mmsg('图片不能超过5MB', false); return; }
        var fd = new FormData();
        fd.append('avatar', f);
        mmsg('上传中…', true);
        mxhr('POST', '/api/account/avatar', fd, function() {
          mmsg('头像已更新', true);
          setTimeout(function() { location.reload(); }, 600);
        }, function(e) { mmsg(e, false); });
      });
    }
    if (btn && ni) {
      btn.addEventListener('click', function() {
        var v = (ni.value || '').trim();
        if (!v) { mmsg('昵称不能为空', false); return; }
        mxhr('POST', '/api/account/profile', { nickname: v }, function() {
          mmsg('昵称已保存', true);
          setTimeout(function() { location.reload(); }, 600);
        }, function(e) { mmsg(e, false); });
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindMbProfile);
  } else {
    bindMbProfile();
  }
})();
</script>

