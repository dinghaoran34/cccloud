<div class="modal-overlay" id="shareModal">
  <div class="modal-content">
    <h3><img src="/icons/share.svg" width="18" height="18" alt=""> 分享文件</h3>
    <p id="shareFileName" style="color:var(--cr-text-2); word-break:break-all; font-size:13px;"></p>
    <p style="color:var(--cr-text-2); font-size:13px;">任何人获得此链接和<b style="color:var(--cr-danger);">4位数字密码</b>即可<b style="color:var(--cr-danger);">无需登录</b>直接下载：</p>
    <input type="text" id="shareLinkInput" readonly style="width:100%; padding:8px 12px; border:1px solid var(--cr-border); border-radius:var(--cr-radius); font-size:13px; color:var(--cr-text); background:var(--cr-bg); box-sizing:border-box;" onfocus="this.select()">
    <div style="display:flex; gap:8px; margin-top:8px; align-items:center;">
      <span style="color:var(--cr-text-2); font-size:13px; white-space:nowrap;">访问密码:</span>
      <input type="text" id="sharePwdInput" readonly value="----" style="flex:0 0 90px; padding:8px 12px; border:1px solid var(--cr-warning); border-radius:var(--cr-radius); font-size:15px; letter-spacing:3px; text-align:center; color:var(--cr-warning); background:var(--cr-bg); font-weight:bold; box-sizing:border-box;" onfocus="this.select()">
      <button type="button" class="btn btn-outline" onclick="copySharePwd()" style="flex:1; padding:8px 0; font-size:13px;">复制密码</button>
    </div>
