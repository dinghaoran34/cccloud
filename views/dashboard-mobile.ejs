      <button type="button" class="btn btn-primary" onclick="copyShareLink()">复制</button>
      <button type="button" class="btn btn-danger" onclick="revokeShare()">撤销分享</button>
      <button type="button" class="btn btn-outline" onclick="closeShareModal()">关闭</button>
    </div>
  </div>
</div>

<script>
document.getElementById('fileInput').addEventListener('change', function(e) {
  var label = document.getElementById('fileLabel');
  if (e.target.files.length > 0) {
    label.textContent = e.target.files[0].name;
  } else {
    label.textContent = '选择文件';
  }
});

var modal = document.getElementById('deleteModal');
document.getElementById('deleteAccountBtn').addEventListener('click', function() {
  modal.style.display = 'flex';
});
document.getElementById('cancelDelete').addEventListener('click', function() {
  modal.style.display = 'none';
});
modal.addEventListener('click', function(e) {
  if (e.target === modal) modal.style.display = 'none';
});

var pwdModal = document.getElementById('passwordModal');
document.getElementById('changePasswordBtn').addEventListener('click', function() {
  pwdModal.style.display = 'flex';
});
document.getElementById('cancelPassword').addEventListener('click', function() {
  pwdModal.style.display = 'none';
});
pwdModal.addEventListener('click', function(e) {
  if (e.target === pwdModal) pwdModal.style.display = 'none';
});

// ===== 分享链接弹窗 =====
var pvModal = document.getElementById('previewModal');

// ===== 文件操作菜单(⋯) =====
var fmModal = document.getElementById('fileMenuModal');
window.openFileMenu = function(btn) {
  var d = btn.dataset;
  var kind = d.kind, fid = d.fid, name = d.name, team = d.team || '';
  document.getElementById('fmName').textContent = name;
  var items = [];
  if (kind === 'file') {
    items.push({ icon: '👁', label: '预览', fn: function() { closeFileMenu(); openPreview(fid, team || null); } });
    items.push({ icon: '⬇️', label: '下载', fn: function() { closeFileMenu(); window.location.href = team ? ('/team/' + team + '/download/' + fid) : ('/download/' + fid); } });
    if (d.canshare === '1') items.push({ icon: '🔗', label: '生成分享链接', fn: function() { closeFileMenu(); openShareModal(fid, name); } });
  }
  items.push({ icon: '🗑', label: '删除', danger: true, fn: function() {
    closeFileMenu();
    var isFolder = kind === 'folder';
    window.mbConfirm({
      title: isFolder ? '删除文件夹' : '删除文件',
      message: isFolder ? ('确定删除文件夹「' + name + '」？内部所有文件都会被永久删除！') : '确定删除该文件？',
      okText: '删除',
      danger: true,
      onOk: function () {
        var f = document.createElement('form');
        f.method = 'POST';
        f.action = isFolder ? ('/folder/' + fid + '/delete') : ('/delete/' + fid);
        document.body.appendChild(f);
        f.submit();
      }
    });
  }});
  var list = document.getElementById('fmList');
  list.innerHTML = '';
  items.forEach(function(it) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'fm-item' + (it.danger ? ' danger' : '');
    var ic = document.createElement('span'); ic.className = 'fm-i'; ic.textContent = it.icon;
    var lb = document.createElement('span'); lb.textContent = it.label;
    b.appendChild(ic); b.appendChild(lb);
    b.addEventListener('click', it.fn);
    list.appendChild(b);
  });
  fmModal.style.display = 'flex';
};
window.closeFileMenu = function() { fmModal.style.display = 'none'; };
fmModal.addEventListener('click', function(e) { if (e.target === fmModal) closeFileMenu(); });

// ===== 文件预览 =====
var pvModal = document.getElementById('previewModal');
window.openPreview = function(fid, teamId) {
  var api = teamId ? '/team/' + teamId + '/preview/' + fid : '/preview/' + fid;
  var dl = teamId ? '/team/' + teamId + '/download/' + fid : '/download/' + fid;
  var body = document.getElementById('pvBody');
  var openBtn = document.getElementById('pvOpen');
  var dlBtn = document.getElementById('pvDl');
  body.innerHTML = '<p style="color:#8a99ab;padding:24px;">加载中…</p>';
  openBtn.style.display = 'none'; dlBtn.style.display = 'none';
  document.getElementById('pvTitle').textContent = '预览';
  pvModal.style.display = 'flex';
  fetch(api).then(function(r) { return r.json(); }).then(function(d) {
    if (!d.ok) {
      body.innerHTML = '<div style="padding:24px 20px;color:#dfe7ef;"><div style="font-size:40px;">📄</div><p style="margin-top:12px;">' + (d.unsupported ? '该格式暂不支持在线预览' : (d.error || '预览失败')) + '</p></div>';
      dlBtn.href = dl; dlBtn.style.display = 'inline-block';
      return;
    }
    document.getElementById('pvTitle').textContent = d.name;
    var inner = '';
    if (d.kind === 'image') inner = '<img src="' + d.url + '" style="max-width:100%;max-height:66vh;display:block;margin:0 auto;" alt="">';
    else if (d.kind === 'pdf') inner = '<iframe src="' + d.url + '" style="width:100%;height:64vh;border:none;background:#fff;display:block;"></iframe>';
    else if (d.kind === 'video') inner = '<video src="' + d.url + '" controls autoplay style="width:100%;max-height:64vh;background:#000;display:block;"></video>';
    else if (d.kind === 'audio') inner = '<audio src="' + d.url + '" controls autoplay style="width:100%;display:block;margin-top:20vh;"></audio>';
    else if (d.kind === 'text') inner = '<iframe src="' + d.url + '" style="width:100%;height:64vh;border:none;background:#fff;display:block;text-align:left;"></iframe>';
    body.innerHTML = inner;
    openBtn.href = d.url; openBtn.style.display = 'inline-block';
    dlBtn.href = dl; dlBtn.style.display = 'inline-block';
  }).catch(function() {
    body.innerHTML = '<div style="padding:24px 20px;color:#dfe7ef;">预览失败，请下载查看</div>';
    dlBtn.href = dl; dlBtn.style.display = 'inline-block';
  });
};
window.closePreview = function() { pvModal.style.display = 'none'; };
pvModal.addEventListener('click', function(e) { if (e.target === pvModal) closePreview(); });
var shareModal = document.getElementById('shareModal');
var currentShareFileId = null;

window.openShareModal = function(fileId, fileName) {
  currentShareFileId = fileId;
  document.getElementById('shareFileName').textContent = fileName || '';
  document.getElementById('shareLinkInput').value = '正在生成链接...';
  document.getElementById('sharePwdInput').value = '----';
  document.getElementById('shareStatus').textContent = '';
  shareModal.style.display = 'flex';

  fetch('/share/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ fileId: fileId })
  }).then(function(resp) {
    if (!resp.ok) return resp.json().then(function(d) { throw new Error(d.error || '生成失败'); });
    return resp.json();
  }).then(function(data) {
    document.getElementById('shareLinkInput').value = window.location.origin + data.url;
    document.getElementById('sharePwdInput').value = data.password || '----';
  }).catch(function(err) {
    document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-danger);"><img src="/icons/cross.svg" width="16" height="16" alt=""> ' + err.message + '</span>';
    document.getElementById('shareLinkInput').value = '';
  });
};

window.closeShareModal = function() {
  shareModal.style.display = 'none';
  currentShareFileId = null;
};

window.copyShareLink = function() {
  var input = document.getElementById('shareLinkInput');
  if (!input.value || input.value.indexOf('http') !== 0) return;
  input.select();
  input.setSelectionRange(0, 99999);
  try {
    document.execCommand('copy');
    document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);"><img src="/icons/check.svg" width="16" height="16" alt=""> 链接已复制（请连同下方密码一起发给对方）</span>';
  } catch (e) {
    document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-text-2);">请手动复制链接</span>';
  }
};

window.copySharePwd = function() {
  var input = document.getElementById('sharePwdInput');
  if (!input.value || input.value === '----') return;
  input.select();
  input.setSelectionRange(0, 99999);
  try {
    document.execCommand('copy');
    document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);"><img src="/icons/check.svg" width="16" height="16" alt=""> 密码已复制</span>';
  } catch (e) {
    document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-text-2);">请手动复制密码</span>';
  }
};

window.revokeShare = function() {
  if (!currentShareFileId) return;
  window.mbConfirm({
    title: '撤销分享',
    message: '确定撤销该文件的分享链接？撤销后链接立即失效。',
    okText: '撤销',
    danger: true,
    onOk: function () {
      fetch('/share/revoke', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fileId: currentShareFileId })
      }).then(function(resp) {
        if (!resp.ok) return resp.json().then(function(d) { throw new Error(d.error || '撤销失败'); });
        return resp.json();
      }).then(function() {
        document.getElementById('shareLinkInput').value = '';
        document.getElementById('sharePwdInput').value = '----';
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);"><img src="/icons/check.svg" width="16" height="16" alt=""> 分享已撤销，链接已失效</span>';
      }).catch(function(err) {
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-danger);"><img src="/icons/cross.svg" width="16" height="16" alt=""> ' + err.message + '</span>';
      });
    }
  });
};

shareModal.addEventListener('click', function(e) {
  if (e.target === shareModal) closeShareModal();
});
</script>
<script src="/js/app.js"></script>

