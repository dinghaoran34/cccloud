<%
  /* 搜索（移动版）：搜索框（可提交 / 可回填 ?q=）+ 搜索历史 + 建议 + 结果列表
     数据走 /api/search/suggest 与 /api/search（与桌面版完全一致）
     结果项链接：文件夹 → /dashboard?folder=id；个人文件 → /api/download/proxy/id；
                团队文件 → /api/team/:teamId/download/proxy/:id */
%>
<%- include('partials/header-mobile') %>

<form class="mb-searchbar" id="searchForm" action="/search" method="GET" role="search">
  <input id="q" name="q" type="search" placeholder="搜索文件 / 文件夹（中英文均可）"
         autocomplete="off" autocapitalize="off" autocorrect="off" aria-label="搜索关键词">
  <button type="submit" class="btn btn-primary" id="go">搜索</button>
</form>

<div class="mb-toolbar">
  <span class="mb-toolbar-sub">支持搜索个人文件、文件夹与所属团队文件</span>
  <span class="mb-spring"></span>
  <button type="button" class="btn btn-outline btn-sm" id="clear">清空</button>
  <button type="button" class="btn btn-outline btn-sm" id="cancel">返回文件</button>
</div>

<div id="wrap"></div>

<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var HIST_KEY = 'teamcloud_search_history';
  var timer = null, token = 0, lastQuery = '';

  /* 文件类型图标 / 彩色图标块（与 dashboard-mobile 一致） */
  function fileIconPath(filename) {
    var ext = String(filename || '').split('.').pop().toLowerCase();
    var types = {
      pdf: 'pdf', doc: 'doc', docx: 'doc', xls: 'xls', xlsx: 'xls', ppt: 'ppt', pptx: 'ppt',
      jpg: 'img', jpeg: 'img', png: 'img', gif: 'img', bmp: 'img', webp: 'img', svg: 'img',
      mp3: 'audio', wav: 'audio', flac: 'audio', m4a: 'audio', ogg: 'audio',
      mp4: 'video', avi: 'video', mkv: 'video', mov: 'video', wmv: 'video', webm: 'video',
      zip: 'archive', rar: 'archive', '7z': 'archive', tar: 'archive', gz: 'archive',
      txt: 'text', md: 'text', log: 'text',
      js: 'code', html: 'code', css: 'code', py: 'code', json: 'code', ts: 'code', java: 'code',
      exe: 'exe', msi: 'exe', bat: 'exe', apk: 'exe'
    };
    return '/icons/file-' + (types[ext] || 'generic') + '.svg';
  }
  function fileTintClass(filename) {
    var key = fileIconPath(filename).replace('/icons/file-', '').replace('.svg', '');
    var map = { pdf: 'doc', doc: 'doc', xls: 'doc', ppt: 'doc', text: 'doc', code: 'doc', img: 'image', video: 'video', archive: 'archive' };
    return 'mb-ico--' + (map[key] || 'other');
  }

  function history(){
    try { return JSON.parse(localStorage.getItem(HIST_KEY) || '[]'); } catch(e){ return []; }
  }
  function saveHist(q){
    var h = history().filter(function(x){ return x !== q; });
    h.unshift(q); if (h.length > 10) h.length = 10;
    try { localStorage.setItem(HIST_KEY, JSON.stringify(h)); } catch(e){}
  }
  function esc(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  function iconHtml(kind){
    if (kind === 'folder') { return '<span class="file-icon mb-ico--folder"><img src="/icons/folder.svg" width="20" height="20" alt=""></span>'; }
    if (kind === 'team') { return '<span class="file-icon mb-ico--video"><img src="/icons/users.svg" width="20" height="20" alt=""></span>'; }
    return '<span class="file-icon mb-ico--other"><img src="/icons/file-generic.svg" width="20" height="20" alt=""></span>';
  }
  function emptyBox(msg, retryFn, retryId){
    var w = $('wrap');
    w.innerHTML = '<div class="card"><div class="card-body"><div class="empty-state">'
      + '<div class="empty-icon"><img src="/icons/empty.svg" width="24" height="24" alt=""></div>'
      + '<p>暂无内容</p><span class="empty-desc">' + esc(msg).replace(/\n/g, '<br>') + '</span>'
      + (retryFn ? '<button type="button" class="btn btn-primary" id="' + retryId + '">重试</button>' : '')
      + '</div></div></div>';
    if (retryFn) { $(retryId).onclick = retryFn; }
  }
  function cardHead(title, hint){
    return '<div class="card-header"><h2>' + esc(title) + '</h2>'
      + (hint ? '<span class="badge">' + esc(hint) + '</span>' : '') + '</div>';
  }
  function rowHtml(kind, name, meta, href, actionLabel){
    return '<div class="mb-item"><div class="mb-item-main">'
      + '<span class="file-icon ' + (kind === 'folder' ? 'mb-ico--folder' : (kind === 'team' ? 'mb-ico--video' : fileTintClass(name))) + '">'
      + '<img src="' + (kind === 'folder' ? '/icons/folder.svg' : (kind === 'team' ? '/icons/users.svg' : fileIconPath(name))) + '" width="20" height="20" alt=""></span>'
      + '<div class="file-info"><a href="' + href + '" title="' + esc(name) + '">' + esc(name) + '</a>'
      + '<div class="file-meta">' + esc(meta) + '</div></div>'
      + '<div class="file-actions"><a class="btn btn-outline btn-sm" href="' + href + '">' + actionLabel + '</a></div>'
      + '</div></div>';
  }

  // 首页：搜索历史
  function home(){
    var h = history();
    if (!h.length) { emptyBox('输入关键词搜索个人文件、文件夹与团队文件\n支持中英文与数字混合'); return; }
    var html = '<div class="card">' + cardHead('搜索历史', String(h.length) + ' 条')
      + '<div class="card-body" style="padding:0;">';
    h.forEach(function(x){
      html += '<div class="mb-item" data-hist="' + esc(x) + '" style="cursor:pointer;"><div class="mb-item-main">'
        + '<span class="file-icon mb-ico--other"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M12 4.6a7.4 7.4 0 1 0 0 14.8 7.4 7.4 0 0 0 0-14.8zM12 6.4a5.6 5.6 0 1 0 0 11.2 5.6 5.6 0 0 0 0-11.2zM11.05 8.2L12.95 8.2L12.95 11.05L15.1 11.05L15.1 12.95L11.05 12.95Z"/></svg></span>'
        + '<div class="file-info"><div class="file-name">' + esc(x) + '</div><div class="file-meta">历史记录</div></div>'
        + '</div></div>';
    });
    html += '</div><div class="card-body" style="padding-top:0;"><button type="button" class="btn btn-outline btn-block btn-sm" id="clearHist">清空历史</button></div></div>';
    $('wrap').innerHTML = html;
    Array.prototype.forEach.call($('wrap').querySelectorAll('[data-hist]'), function(row){
      row.onclick = function(){ $('q').value = row.getAttribute('data-hist'); search(row.getAttribute('data-hist')); };
    });
    $('clearHist').onclick = function(){ try { localStorage.removeItem(HIST_KEY); } catch(e){} home(); };
  }

  function doSuggest(q){
    clearTimeout(timer);
    var my = ++token;
    timer = setTimeout(function(){
      var x = new XMLHttpRequest();
      x.open('GET', '/api/search/suggest?q=' + encodeURIComponent(q));
      x.onload = function(){
        if (my !== token) return;
        var j = null; try { j = JSON.parse(x.responseText); } catch(e){}
        if (!j || !j.ok) return;
        renderSuggest(q, j.items || []);
      };
      x.onerror = function(){ if (my === token) renderSuggest(q, []); };
      x.send();
    }, 220);
  }

  function renderSuggest(q, items){
    if (!items.length) { emptyBox('暂无匹配建议，回车直接搜索'); return; }
    var html = '<div class="card">' + cardHead('搜索建议', String(items.length) + ' 项') + '<div class="card-body" style="padding:0;">'
      + items.map(function(it){
        var kind = it.type === 'folder' ? 'folder' : (it.type === 'team' ? 'team' : 'file');
        var label = kind === 'folder' ? '文件夹' : (kind === 'team' ? '团队文件' : '个人文件');
        return '<div class="mb-item" data-sug="' + esc(it.text) + '" style="cursor:pointer;"><div class="mb-item-main">'
          + iconHtml(kind) + '<div class="file-info"><div class="file-name">' + esc(it.text) + '</div><div class="file-meta">' + label + '</div></div>'
          + '</div></div>';
      }).join('')
      + '</div></div>';
    $('wrap').innerHTML = html;
    Array.prototype.forEach.call($('wrap').querySelectorAll('[data-sug]'), function(row){
      row.onclick = function(){ $('q').value = row.getAttribute('data-sug'); search(row.getAttribute('data-sug')); };
    });
  }

  function loading(q){
    $('wrap').innerHTML = '<div class="card"><div class="card-body"><div class="empty-state">'
      + '<div class="empty-icon"><img src="/icons/empty.svg" width="24" height="24" alt=""></div>'
      + '<p>正在搜索 “' + esc(q) + '” …</p></div></div></div>';
  }

  function search(q){
    q = (q || '').trim(); if (!q) return;
    saveHist(q);
    lastQuery = q;
    var my = ++token;
    loading(q);
    var x = new XMLHttpRequest();
    x.open('GET', '/api/search?q=' + encodeURIComponent(q));
    x.onload = function(){
      if (my !== token) return;
      if (x.status === 401) { window.mbAuthExpired(); return; }
      var j = null; try { j = JSON.parse(x.responseText); } catch(e){}
      if (!j || !j.ok) { emptyBox((j && j.error) || '搜索失败', function(){ search(q); }, 'retryBtn'); return; }
      render(j);
    };
    x.onerror = function(){ if (my === token) emptyBox('网络异常，请重试', function(){ search(q); }, 'retryBtn'); };
    x.send();
  }

  function render(j){
    var folders = j.folders || [], files = j.files || [], team = j.teamFiles || [];
    var total = folders.length + files.length + team.length;
    if (!total) { emptyBox('没有找到相关内容，换个关键词试试吧'); return; }
    var html = '<div class="mb-toolbar"><span class="mb-toolbar-sub">“' + esc(j.q) + '” 的搜索结果，共 ' + total + ' 项</span></div>';

    if (folders.length) {
      html += '<div class="card">' + cardHead('文件夹', String(folders.length) + ' 项') + '<div class="card-body" style="padding:0;">';
      folders.forEach(function(f){
        html += rowHtml('folder', f.name, '文件夹', '/dashboard?folder=' + encodeURIComponent(f.id), '打开');
      });
      html += '</div></div>';
    }
    if (files.length) {
      html += '<div class="card">' + cardHead('文件', String(files.length) + ' 项') + '<div class="card-body" style="padding:0;">';
      files.forEach(function(f){
        var url = '/api/download/proxy/' + f.id;
        html += rowHtml('file', f.filename, '个人文件', url, '下载');
      });
      html += '</div></div>';
    }
    if (team.length) {
      html += '<div class="card">' + cardHead('团队文件', String(team.length) + ' 项') + '<div class="card-body" style="padding:0;">';
      team.forEach(function(f){
        var url = '/api/team/' + f.teamId + '/download/proxy/' + f.id;
        html += rowHtml('team', f.filename || '', '团队·' + (f.teamName || ''), url, '下载');
      });
      html += '</div></div>';
    }
    $('wrap').innerHTML = html;
  }

  $('q').addEventListener('input', function(){
    var v = this.value.trim();
    clearTimeout(timer);
    if (!v) { ++token; home(); }
    else { doSuggest(v); }
  });
  $('searchForm').addEventListener('submit', function(e){
    e.preventDefault();
    search($('q').value);
  });
  $('clear').onclick = function(){ var q = $('q'); q.value = ''; try { q.focus(); } catch(e){} ++token; home(); };
  $('cancel').onclick = function(){ location.href = '/dashboard'; };

  // 支持顶栏搜索框跳转过来：/search?q=关键词（回填）
  var initQ = '';
  try {
    var m = /[?&]q=([^&]*)/.exec(location.search);
    if (m) { initQ = decodeURIComponent(m[1].replace(/\+/g, ' ')); }
  } catch(e) {}
  if (initQ) { $('q').value = initQ; search(initQ); }
  else { home(); }
})();
</script>

<%- include('partials/footer-mobile') %>
