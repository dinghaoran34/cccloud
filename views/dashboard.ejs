  // ==================== 上传任务队列（复用 app.js 的 presign→PUT→confirm 请求逻辑） ====================
  var FOLDER_ID = '<%= currentFolderId || '' %>';
  var DASH_URL = '/dashboard' + (FOLDER_ID ? '?folder=' + FOLDER_ID : '');
  var upPanel = document.getElementById('crUploadPanel');
  var upList = document.getElementById('crUploadList');
  var upCount = document.getElementById('crUploadCount');
  var upTasks = [];
  var upRunning = false;
  var upReloaded = false;

  function upRefreshCount() {
    var done = 0, fail = 0;
    upTasks.forEach(function (t) { if (t.state === 'done') { done++; } if (t.state === 'fail') { fail++; } });
    upCount.textContent = '完成 ' + done + ' / 失败 ' + fail + ' / 共 ' + upTasks.length;
    if (!upTasks.length) { upPanel.hidden = true; }
  }

  function upRemove(t) {
    var i = upTasks.indexOf(t);
    if (i >= 0) { upTasks.splice(i, 1); }
    if (t.el && t.el.parentNode) { t.el.parentNode.removeChild(t.el); }
    upRefreshCount();
  }

  function upAdd(file) {
    var el = document.createElement('div');
    el.className = 'cr-task';
    el.innerHTML = '<div class="cr-task-top">'
      + '<span class="cr-task-name"></span>'
      + '<span class="cr-task-pct"></span>'
      + '<span class="cr-task-state">等待</span>'
      + '<button type="button" class="cr-task-x" title="移除任务" disabled>✕</button>'
      + '</div><div class="progress-track"><div class="progress-bar"></div></div>';
    el.querySelector('.cr-task-name').textContent = file.name;
    var t = {
      file: file,
      state: 'wait',
      el: el,
      bar: el.querySelector('.progress-bar'),
      pct: el.querySelector('.cr-task-pct'),
      stateEl: el.querySelector('.cr-task-state'),
      xBtn: el.querySelector('.cr-task-x')
    };
    t.xBtn.addEventListener('click', function () {
      if (t.state === 'wait' || t.state === 'up') { return; }
      upRemove(t);
    });
    upList.appendChild(el);
    upTasks.push(t);
    upPanel.hidden = false;
    upRefreshCount();
    return t;
  }

  /* 顺序执行队列（秒传/分片续传/直传统一走 app.js 的 uploadFileSmart，缺失时回退 multiThreadUpload） */
  function upRun() {
    if (upRunning) { return; }
    var hasUploader = (typeof window.uploadFileSmart === 'function') || (typeof window.multiThreadUpload === 'function');
    if (!hasUploader) { return; }
    var next = null;
    for (var i = 0; i < upTasks.length; i++) {
      if (upTasks[i].state === 'wait') { next = upTasks[i]; break; }
    }
    if (!next) {
      if (!upReloaded && upTasks.some(function (t) { return t.state === 'done'; })) {
        upReloaded = true;
        setTimeout(function () { window.location.href = DASH_URL; }, 1200);
      }
      return;
    }
    upRunning = true;
    next.state = 'up';
    next.stateEl.textContent = '上传中';
    next.pct.textContent = '0%';

    var upFn = (typeof window.uploadFileSmart === 'function') ? window.uploadFileSmart : window.multiThreadUpload;
    upFn(next.file, false, function (p) {
      var v = Math.max(0, Math.min(100, Math.round(p * 100)));
      next.bar.style.width = v + '%';
      next.pct.textContent = v + '%';
    }, null, FOLDER_ID || null).then(function () {
      next.state = 'done';
      next.bar.style.width = '100%';
      next.pct.textContent = '100%';
      next.stateEl.textContent = '已完成';
      next.el.classList.add('is-done');
      next.xBtn.disabled = false;
      next.xBtn.title = '从列表移除';
      upRunning = false;
      upRefreshCount();
      upRun();
    }).catch(function (err) {
      next.state = 'fail';
      next.bar.style.width = '100%';
      next.stateEl.textContent = '失败';
      next.el.classList.add('is-fail');
      next.xBtn.disabled = false;
      next.xBtn.title = '从列表移除';
      upRunning = false;
      upRefreshCount();
      crToast('上传失败：' + ((err && err.message) ? err.message : '未知错误'), 'error');
      upRun();
    });
  }

  /* 老浏览器（app.js 未启用分片直传）：沿用原有隐藏表单提交路径 */
  function upFallback() {
    var btn = document.getElementById('panUploadBtn');
    if (upPanel) { upPanel.hidden = true; }
    if (btn) { btn.click(); }
  }

  /* 注意：先复制 FileList 再清空 input.value（清空会让原 FileList 变空） */
  function filesToArray(list) {
    var out = [];
    if (!list) { return out; }
    for (var i = 0; i < list.length; i++) { out.push(list[i]); }
    return out;
  }

  function onPickFiles(files, input) {
    var arr = filesToArray(files);
    if (!arr.length) { return; }
    if (input) { try { input.value = ''; } catch (e) { } }
    if (typeof window.multiThreadUpload !== 'function') { upFallback(); return; }
    for (var i = 0; i < arr.length; i++) { upAdd(arr[i]); }
    upRun();
  }

  var fileInput = document.getElementById('panFileInput');
  if (fileInput) {
    fileInput.addEventListener('change', function () { onPickFiles(this.files, this); });
  }

  var dirInput = document.getElementById('panDirInput');
  var dirBtn = document.getElementById('crUploadDirBtn');
  if (dirBtn && dirInput) {
    dirBtn.addEventListener('click', function () { dirInput.click(); });
    dirInput.addEventListener('change', function () { onPickFiles(this.files, this); });
  }

  // ==================== 拖拽上传（文件/文件夹拖入文件区即加入上传队列） ====================
  (function () {
    var zone = document.getElementById('crDropZone');
    var fileSection = document.getElementById('pan-files');
    if (!fileSection) { return; }
    var dragDepth = 0;
    function isFileDrag(e) {
      var dt = e.dataTransfer;
      if (!dt) { return false; }
      if (dt.types && Array.prototype.indexOf.call(dt.types, 'Files') >= 0) { return true; }
      return false;
    }
    function show() { if (zone) { zone.classList.add('is-active'); } }
    function hide() { if (zone) { zone.classList.remove('is-active'); } }
    fileSection.addEventListener('dragenter', function (e) {
      if (!isFileDrag(e)) { return; }
      e.preventDefault();
      dragDepth++;
      show();
    });
    fileSection.addEventListener('dragover', function (e) {
      if (!isFileDrag(e)) { return; }
      e.preventDefault();
      if (e.dataTransfer) { e.dataTransfer.dropEffect = 'copy'; }
      show();
    });
    fileSection.addEventListener('dragleave', function (e) {
      if (!isFileDrag(e)) { return; }
      dragDepth = Math.max(0, dragDepth - 1);
      if (!dragDepth) { hide(); }
    });
    fileSection.addEventListener('drop', function (e) {
      if (!isFileDrag(e)) { return; }
      e.preventDefault();
      dragDepth = 0;
      hide();
      var dt = e.dataTransfer;
      var collector = window.crCollectDroppedFiles;
      var promise = (typeof collector === 'function') ? collector(dt) : Promise.resolve(filesToArray(dt && dt.files));
      promise.then(function (files) {
        var arr = files || [];
        if (!arr.length) { crToast('未识别到可上传的文件', 'error'); return; }
        if (typeof window.uploadFileSmart !== 'function' && typeof window.multiThreadUpload !== 'function') { crAlert('当前浏览器不支持拖拽上传，请点击「上传文件」按钮'); return; }
        for (var i = 0; i < arr.length; i++) { upAdd(arr[i]); }
        upRun();
        crToast('已加入上传队列：' + arr.length + ' 个文件');
      }).catch(function () { crToast('读取拖入的文件失败', 'error'); });
    });
    // 防止拖到页面空白处时浏览器直接打开文件
    ['dragover', 'drop'].forEach(function (ev) {
      document.addEventListener(ev, function (e) {
        if (!isFileDrag(e)) { return; }
        if (fileSection.contains(e.target)) { return; }
        e.preventDefault();
        dragDepth = 0;
        hide();
      });
    });
  })();

  if (upPanel) {
    var upToggle = document.getElementById('crUploadToggle');
    if (upToggle) {
      upToggle.addEventListener('click', function () {
        var min = upPanel.classList.toggle('is-min');
        upToggle.title = min ? '展开' : '收起/展开';
      });
    }
    var upClear = document.getElementById('crUploadClear');
    if (upClear) {
      upClear.addEventListener('click', function () {
        var remain = [];
        upTasks.slice().forEach(function (t) {
          if (t.state === 'done' || t.state === 'fail') {
            if (t.el && t.el.parentNode) { t.el.parentNode.removeChild(t.el); }
          } else {
            remain.push(t);
          }
        });
        upTasks = remain;
        upRefreshCount();
