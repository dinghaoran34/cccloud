<script>
/* ==================== 公共交互组件：Toast / 确认弹窗 / 提示弹窗 ==================== */
(function () {
  function $(id) { return document.getElementById(id); }

  window.crEsc = function (s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };

  window.crToast = function (msg, kind) {
    var wrap = $('crToasts');
    if (!wrap) return;
    var el = document.createElement('div');
    el.className = 'cr-toast' + (kind ? ' is-' + kind : '');
    el.textContent = msg;
    wrap.appendChild(el);
    setTimeout(function () { if (el.parentNode) { el.parentNode.removeChild(el); } }, 2800);
  };

  window.crConfirm = function (opt) {
    if (typeof opt === 'string') { opt = { message: opt }; }
    opt = opt || {};
    return new Promise(function (resolve) {
      var modal = $('crConfirmModal');
      var ok = $('crConfirmOk');
      var cancel = $('crConfirmCancel');
      $('crConfirmTitle').textContent = opt.title || '确认操作';
      $('crConfirmMsg').textContent = opt.message || '';
      ok.textContent = opt.okText || '确定';
      ok.className = 'cr-btn ' + (opt.danger ? 'cr-btn-danger' : 'cr-btn-primary');
      modal.style.display = 'flex';
      try { ok.focus(); } catch (e) { }
      function done(v) {
        modal.style.display = 'none';
        ok.removeEventListener('click', onOk);
        cancel.removeEventListener('click', onCancel);
        modal.removeEventListener('click', onMask);
        document.removeEventListener('keydown', onKey);
        resolve(v);
      }
      function onOk() { done(true); }
      function onCancel() { done(false); }
      function onMask(e) { if (e.target === modal) { done(false); } }
      function onKey(e) { if (e.key === 'Escape') { done(false); } }
      ok.addEventListener('click', onOk);
      cancel.addEventListener('click', onCancel);
      modal.addEventListener('click', onMask);
      document.addEventListener('keydown', onKey);
    });
  };

  window.crAlert = function (msg, title) {
    return new Promise(function (resolve) {
      var modal = $('crAlertModal');
      var ok = $('crAlertOk');
      $('crAlertTitle').textContent = title || '提示';
      $('crAlertMsg').textContent = msg || '';
      modal.style.display = 'flex';
      try { ok.focus(); } catch (e) { }
      function done() {
        modal.style.display = 'none';
        ok.removeEventListener('click', done);
        modal.removeEventListener('click', onMask);
        document.removeEventListener('keydown', onKey);
        resolve(true);
      }
      function onMask(e) { if (e.target === modal) { done(); } }
      function onKey(e) { if (e.key === 'Escape') { done(); } }
      ok.addEventListener('click', done);
      modal.addEventListener('click', onMask);
      document.addEventListener('keydown', onKey);
    });
  };

  /* 声明式确认：<form data-confirm="..."> 拦截提交，确认后再真正提交 */
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (!f || !f.dataset || !f.dataset.confirm) return;
    if (f.dataset.confirmed === '1') { f.dataset.confirmed = ''; return; }
    e.preventDefault();
    e.stopPropagation();
    var danger = !!f.dataset.confirmDanger;
    window.crConfirm({
      title: danger ? '危险操作' : '确认操作',
      message: f.dataset.confirm,
      danger: danger,
      okText: danger ? '确认删除' : '确定'
    }).then(function (okv) {
      if (!okv) return;
      f.dataset.confirmed = '1';
      if (typeof HTMLFormElement !== 'undefined' && HTMLFormElement.prototype.submit) {
        HTMLFormElement.prototype.submit.call(f);
      } else { f.submit(); }
      setTimeout(function () { f.dataset.confirmed = ''; }, 0);
    });
  }, true);
})();
</script>
<script>
(function() {
  // ==================== 侧边栏 / 分栏切换 ====================
  var sideItems = document.querySelectorAll('#panSideNav .pan-side-item');
  var sections = { home: 'pan-files', files: 'pan-files', teams: 'pan-teams', account: 'pan-account', starred: 'pan-starred', recent: 'pan-recent' };
  var crumb = document.getElementById('crCrumb');
  var crumbHomeHTML = crumb ? crumb.innerHTML : '';

  function activateTab(tab, pushState) {
    if (!sections[tab]) tab = 'home';
    for (var i = 0; i < sideItems.length; i++) {
      var it = sideItems[i];
      it.classList.toggle('is-active', it.dataset.pan === tab);
    }
    Object.keys(sections).forEach(function(k) {
      var el = document.getElementById(sections[k]);
      if (el) el.style.display = (sections[k] === sections[tab]) ? '' : 'none';
    });
    // 面包屑跟随当前栏目（“我的文件”保留文件夹层级面包屑）
    if (crumb) {
      if (tab === 'files' || tab === 'home') {
        crumb.innerHTML = crumbHomeHTML;
      } else {
        var label = tab === 'teams' ? '团队空间' : (tab === 'starred' ? '收藏' : (tab === 'recent' ? '最近访问' : '账户设置'));
        crumb.innerHTML = '<span class="cr-crumb-item is-current">' + label + '</span>';
      }
    }
    if (pushState && window.history && history.replaceState) {
      var url = location.pathname + (tab === 'files' || tab === 'home' ? '' : '?tab=' + tab);
      history.replaceState(null, '', url);
    }
    if (tab !== 'files' && tab !== 'home') { updateSelBar(); }
  }

  for (var i = 0; i < sideItems.length; i++) {
    (function(item) {
      item.addEventListener('click', function(e) {
        if (!item.dataset.pan) return;              // 普通外链导航项（回收站/搜索/管理后台等）
        if (item.dataset.pan === 'home') return;    // 首页：交给浏览器跳转到 /dashboard 根目录
        e.preventDefault();
        activateTab(item.dataset.pan, true);
      });
    })(sideItems[i]);
  }

  // 初始栏目：?tab=teams|account|files
  var initTab = 'home';
  try {
    var m = /[?&]tab=([a-z]+)/.exec(location.search);
    if (m && sections[m[1]]) { initTab = m[1]; }
  } catch (e) { }
  activateTab(initTab, false);

  // ==================== 视图切换（网格/列表，localStorage 记忆） ====================
  var VIEW_KEY = 'cr_view_mode';
  var viewBtns = document.querySelectorAll('#panViewToggle .pan-view-btn');
  var gridEl = document.getElementById('panGridView');
  var listEl = document.getElementById('panListView');

  function setView(mode, save) {
    for (var i = 0; i < viewBtns.length; i++) {
      viewBtns[i].classList.toggle('is-active', viewBtns[i].dataset.view === mode);
    }
    if (gridEl) gridEl.style.display = mode === 'grid' ? '' : 'none';
    if (listEl) listEl.style.display = mode === 'list' ? '' : 'none';
    if (save) { try { localStorage.setItem(VIEW_KEY, mode); } catch (e) { } }
  }
  for (var v = 0; v < viewBtns.length; v++) {
    (function(btn) {
      btn.addEventListener('click', function() { setView(btn.dataset.view, true); });
    })(viewBtns[v]);
  }
  var savedView = 'grid';
  try { savedView = localStorage.getItem(VIEW_KEY) || 'grid'; } catch (e) { }
  setView(savedView === 'list' ? 'list' : 'grid', false);

  // ==================== 批量选择 ====================
  var sel = {};            // key -> {kind, id, name}
  var selBar = document.getElementById('crSelBar');
  var selCount = document.getElementById('crSelCount');
  var checkAll = document.getElementById('crCheckAll');

  function selKeys() { return Object.keys(sel || {}); }

  function syncChecks() {
    var boxes = document.querySelectorAll('.cr-row-check');
    for (var i = 0; i < boxes.length; i++) {
      var b = boxes[i];
      var key = b.dataset.kind + ':' + b.dataset.id;
      b.checked = !!sel[key];
      var box = b.closest('.cr-gcard') || b.closest('tr');
      if (box) { box.classList.toggle('is-selected', !!sel[key]); }
    }
    if (checkAll) {
      var all = visibleChecks();
      var total = all.length, checked = 0;
      for (var j = 0; j < all.length; j++) { if (all[j].checked) { checked++; } }
      checkAll.checked = total > 0 && checked === total;
      checkAll.indeterminate = checked > 0 && checked < total;
    }
  }

  /* 当前筛选条件下可见的选择框（列表视图用） */
  function visibleChecks() {
    var all = document.querySelectorAll('#panListView .cr-row-check');
    var out = [];
    for (var i = 0; i < all.length; i++) {
      var row = all[i].closest('tr');
      if (!row || row.style.display !== 'none') { out.push(all[i]); }
    }
    return out;
  }

  function updateSelBar() {
