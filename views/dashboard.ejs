<%
function formatFileSize(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1024 * 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  return (bytes / (1024 * 1024 * 1024)).toFixed(1) + ' GB';
}

function fileIconPath(filename) {
  const ext = filename.split('.').pop().toLowerCase();
  const types = {
    pdf: 'pdf', doc: 'doc', docx: 'doc',
    xls: 'xls', xlsx: 'xls',
    ppt: 'ppt', pptx: 'ppt',
    jpg: 'img', jpeg: 'img', png: 'img', gif: 'img', bmp: 'img', webp: 'img', svg: 'img',
    mp3: 'audio', wav: 'audio', flac: 'audio', m4a: 'audio', ogg: 'audio',
    mp4: 'video', avi: 'video', mkv: 'video', mov: 'video', wmv: 'video', webm: 'video',
    zip: 'archive', rar: 'archive', '7z': 'archive', tar: 'archive', gz: 'archive',
    txt: 'text', md: 'text', log: 'text',
    js: 'code', html: 'code', css: 'code', py: 'code', json: 'code', ts: 'code', java: 'code',
    exe: 'exe', msi: 'exe', bat: 'exe', apk: 'exe'
  };
  return '/icons/file-' + (types[ext] || 'generic') + '.svg';
}

/* 文件类型 → 彩色图标底色（folder/image/video/doc/archive/other） */
function fileTint(filename) {
  const ext = String(filename || '').split('.').pop().toLowerCase();
  if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'].indexOf(ext) >= 0) return 'image';
  if (['mp4', 'avi', 'mkv', 'mov', 'wmv', 'webm', 'mp3', 'wav', 'flac', 'm4a', 'ogg'].indexOf(ext) >= 0) return 'video';
  if (['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'md', 'log', 'csv'].indexOf(ext) >= 0) return 'doc';
  if (['zip', 'rar', '7z', 'tar', 'gz'].indexOf(ext) >= 0) return 'archive';
  return 'other';
}

/* 时间字符串 → 时间戳（毫秒），供前端排序/详情面板使用 */
function tsOf(v) {
  const t = new Date(String(v == null ? '' : v).replace(' ', 'T')).getTime();
  return isNaN(t) ? 0 : t;
}
%>
<% var _ownerName = currentUser.nickname || currentUser.username; %>

<%- include('partials/cr-shell-head', { crActive: 'home' }) %>

  <header class="cr-topbar">
    <button type="button" class="cr-hamburger" data-cr-drawer-open title="打开菜单" aria-label="打开菜单">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4.6 5.6h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 10.5h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 15.4h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3z"/></svg>
    </button>

    <!-- 面包屑（跟随当前文件夹层级） -->
    <nav class="cr-crumb" id="crCrumb" aria-label="面包屑">
      <a class="cr-crumb-item<%= currentFolderId ? '' : ' is-current' %>" href="/dashboard">全部文件</a>
      <% folderPath.forEach(function(f) { %>
        <span class="cr-crumb-sep">/</span>
        <% if (f.id === currentFolderId) { %>
          <span class="cr-crumb-item is-current"><%= f.name %></span>
        <% } else { %>
          <a class="cr-crumb-item" href="/dashboard?folder=<%= f.id %>"><%= f.name %></a>
        <% } %>
      <% }) %>
    </nav>

    <div class="cr-top-actions">
      <form class="cr-search" action="/search" method="GET" role="search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4.8 10.8a6 6 0 1 0 12 0a6 6 0 1 0-12 0zM6.9 10.8a3.9 3.9 0 1 0 7.8 0a3.9 3.9 0 1 0-7.8 0z"/><path d="M19.26 14.74L19.26 14.74A1.2 1.2 0 0 1 19.26 16.43L16.43 19.26A1.2 1.2 0 0 1 14.74 19.26L14.74 19.26A1.2 1.2 0 0 1 14.74 17.57L17.57 14.74A1.2 1.2 0 0 1 19.26 14.74Z"/></svg>
        <input type="search" name="q" placeholder="搜索文件…" autocomplete="off" aria-label="搜索文件">
      </form>

      <div class="cr-viewtoggle" id="panViewToggle" role="group" aria-label="视图切换">
        <button type="button" class="cr-vt-btn pan-view-btn is-active" data-view="grid" title="网格视图" aria-label="网格视图">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M5.8 3.6h4.2a2.2 2.2 0 0 1 2.2 2.2v4.2a2.2 2.2 0 0 1-2.2 2.2H5.8a2.2 2.2 0 0 1-2.2-2.2V5.8a2.2 2.2 0 0 1 2.2-2.2zM14 3.6h4.2a2.2 2.2 0 0 1 2.2 2.2v4.2a2.2 2.2 0 0 1-2.2 2.2H14a2.2 2.2 0 0 1-2.2-2.2V5.8A2.2 2.2 0 0 1 14 3.6zM5.8 11.8h4.2a2.2 2.2 0 0 1 2.2 2.2v4.2a2.2 2.2 0 0 1-2.2 2.2H5.8a2.2 2.2 0 0 1-2.2-2.2V14a2.2 2.2 0 0 1 2.2-2.2zM14 11.8h4.2a2.2 2.2 0 0 1 2.2 2.2v4.2a2.2 2.2 0 0 1-2.2 2.2H14a2.2 2.2 0 0 1-2.2-2.2V14a2.2 2.2 0 0 1 2.2-2.2z"/></svg>
        </button>
        <button type="button" class="cr-vt-btn pan-view-btn" data-view="list" title="列表视图" aria-label="列表视图">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4.6 5.6h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 10.5h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3zM4.6 15.4h14.8a1.5 1.5 0 0 1 0 3H4.6a1.5 1.5 0 0 1 0-3z"/></svg>
        </button>
      </div>

      <div class="cr-new-wrap">
        <button type="button" class="cr-btn cr-btn-primary" id="crNewBtn"
                aria-haspopup="menu" aria-expanded="false" title="新建 / 上传">
          <img src="/icons/plus.svg" width="16" height="16" alt="">新建
        </button>
        <div class="cr-menu" id="crNewMenu" role="menu">
          <div class="cr-menu-item" role="menuitem" tabindex="0" data-new="folder">新建文件夹</div>
          <div class="cr-menu-item" role="menuitem" tabindex="0" data-new="upload">上传文件</div>
          <div class="cr-menu-item" role="menuitem" tabindex="0" data-new="uploaddir">上传文件夹</div>
        </div>
      </div>

      <%- include('partials/cr-theme-btn') %>
      <%- include('partials/cr-user-menu') %>
    </div>
  </header>

  <div class="cr-content">

    <% if (typeof uploadError !== 'undefined' && uploadError) { %>
      <div class="cr-alert cr-alert-error">
        <img src="/icons/warning.svg" width="18" height="18" alt="">
        <span><%= uploadError %></span>
      </div>
    <% } %>

    <!-- ==================== 我的文件 ==================== -->
    <section id="pan-files" class="pan-section">

      <!-- 上传（隐藏表单 + 进度条；app.js 拦截走 S3 直传） -->
      <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form pan-hidden-upload">
        <input type="hidden" name="share" value="false">
        <input type="hidden" name="folderId" value="<%= currentFolderId || '' %>">
        <input type="file" name="file" id="panFileInput" multiple required>
        <button type="submit" id="panUploadBtn" style="display:none">上传</button>
        <div class="upload-progress" style="display:none;">
          <div class="progress-track"><div class="progress-bar"></div></div>
          <div class="progress-info">
            <span class="progress-pct">0%</span>
            <span class="progress-speed">--</span>
            <span class="progress-eta"></span>
          </div>
        </div>
      </form>

      <!-- 上传文件夹（webkitdirectory；文件进入上传任务队列） -->
      <input type="file" id="panDirInput" webkitdirectory directory multiple hidden>

      <!-- 工具栏 -->
      <div class="cr-toolbar">
        <button type="button" class="cr-btn cr-btn-ghost" id="crNewFolderBtn">
          <img src="/icons/plus.svg" width="16" height="16" alt="">新建文件夹
        </button>
        <button type="button" class="cr-btn cr-btn-ghost" id="crUploadDirBtn">
          <img src="/icons/upload.svg" width="16" height="16" alt="">上传文件夹
        </button>
        <span class="cr-toolbar-sub" id="crCountText"><%= folders.length %> 个文件夹 · <%= personalFiles.length %> 个文件</span>
        <span class="cr-spring"></span>
        <div class="cr-seg" id="crFilterSeg" role="group" aria-label="筛选">
          <button type="button" class="cr-seg-btn is-active" data-filter="all">全部</button>
          <button type="button" class="cr-seg-btn" data-filter="folder">仅文件夹</button>
          <button type="button" class="cr-seg-btn" data-filter="file">仅文件</button>
          <button type="button" class="cr-seg-btn" data-filter="starred">收藏</button>
        </div>
        <div class="cr-seg" id="crSortSeg" role="group" aria-label="排序">
          <button type="button" class="cr-seg-btn is-active" data-sort="name">名称</button>
          <button type="button" class="cr-seg-btn" data-sort="size">大小</button>
          <button type="button" class="cr-seg-btn" data-sort="time">时间</button>
        </div>
        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="crSortDir" title="切换升序/降序">▲ 升序</button>
        <a class="cr-btn cr-btn-text" href="/trash">回收站</a>
      </div>

      <!-- 标签筛选（阶段一）：点击标签筛选当前目录内文件 -->
      <% if (typeof myTags !== 'undefined' && myTags.length) { %>
        <div class="cr-tagbar" id="crTagBar">
          <span class="cr-tagbar-label">标签</span>
          <a class="cr-chip<%= activeTag ? '' : ' is-active' %>" href="/dashboard<%= currentFolderId ? '?folder=' + currentFolderId : '' %>">全部</a>
          <% myTags.forEach(function(t) { %>
            <a class="cr-chip<%= activeTag === t.id ? ' is-active' : '' %>" href="/dashboard?<%= currentFolderId ? 'folder=' + currentFolderId + '&' : '' %>tag=<%= t.id %>"<% if (t.color) { %> style="--chip-color:<%= t.color %>"<% } %>>
              <%= t.name %><span class="cr-chip-num"><%= t.count %></span>
            </a>
          <% }) %>
          <% if (activeTag) { %><span class="cr-tagbar-tip">当前按标签筛选，仅显示该标签下的文件</span><% } %>
        </div>
      <% } else { %>
        <div class="cr-tagbar" id="crTagBar" style="display:none"></div>
      <% } %>

      <!-- 批量选择操作栏 -->
      <div class="cr-selbar" id="crSelBar" style="display:none">
        <span class="cr-selbar-count">已选 <b id="crSelCount">0</b> 项</span>
        <button type="button" class="cr-btn cr-btn-text cr-btn-sm" id="crSelAll">全选</button>
        <button type="button" class="cr-btn cr-btn-text cr-btn-sm" id="crSelInvert">反选</button>
        <span class="cr-spring"></span>
        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="crSelDownload">打包下载</button>
        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="crSelMove">移动到</button>
        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="crSelCopy">复制到</button>
        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="crSelShare">分享</button>
        <button type="button" class="cr-btn cr-btn-danger cr-btn-sm" id="crSelDelete">删除</button>
        <button type="button" class="cr-btn cr-btn-text cr-btn-sm" id="crSelClear">取消</button>
      </div>

      <!-- 网格视图 -->
      <div class="cr-card" id="panGridView">
        <% if (folders.length === 0 && personalFiles.length === 0) { %>
          <div class="cr-empty">
            <img src="/icons/empty.svg" width="56" height="56" alt="">
            <p>空空如也，上传文件或新建一个文件夹吧</p>
          </div>
        <% } else { %>
          <div class="cr-grid" id="crGrid">
            <% folders.forEach(function(f) { %>
              <div class="cr-gcard pan-g-item" data-key="folder:<%= f.id %>" data-kind="folder" data-id="<%= f.id %>" data-name="<%= f.name %>" data-size="0" data-time="<%= tsOf(f.created_at) %>" data-owner="<%= _ownerName %>" data-shared="0" data-starred="<%= (starredKeys && starredKeys['folder:' + f.id]) ? 1 : 0 %>" data-tags="">
                <input type="checkbox" class="cr-gcard-check cr-row-check" data-kind="folder" data-id="<%= f.id %>" data-name="<%= f.name %>" title="选择">
                <a class="cr-gcard-ico" href="/dashboard?folder=<%= f.id %>" title="打开文件夹">
                  <span class="cr-fi cr-fi--lg cr-fi--folder"><img src="/icons/folder.svg" width="28" height="28" alt="文件夹"></span>
                </a>
                <a class="cr-gcard-name pan-g-name" href="/dashboard?folder=<%= f.id %>"><%= f.name %></a>
                <% if (starredKeys && starredKeys['folder:' + f.id]) { %><span class="cr-star-mark" title="已收藏">★</span><% } %>
                <div class="cr-gcard-meta"><%= new Date(f.created_at).toLocaleDateString('zh-CN') %></div>
                <div class="cr-gcard-ops">
                  <a class="cr-op" href="/dashboard?folder=<%= f.id %>" title="打开"><img src="/icons/folder-open.svg" width="16" height="16" alt="打开"></a>
                  <button type="button" class="cr-op" data-menu-btn title="更多操作" aria-label="更多操作"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></button>
                </div>
              </div>
            <% }) %>
            <% personalFiles.forEach(function(file) { %>
              <div class="cr-gcard pan-g-item" data-key="file:<%= file.id %>" data-kind="file" data-id="<%= file.id %>" data-name="<%= file.filename %>" data-size="<%= file.file_size || 0 %>" data-time="<%= tsOf(file.uploaded_at) %>" data-owner="<%= _ownerName %>" data-shared="0" data-starred="<%= (starredKeys && starredKeys['file:' + file.id]) ? 1 : 0 %>" data-tags="<%= (fileTags && fileTags[file.id]) ? fileTags[file.id].join(',') : '' %>">
                <input type="checkbox" class="cr-gcard-check cr-row-check" data-kind="file" data-id="<%= file.id %>" data-name="<%= file.filename %>" title="选择">
                <a class="cr-gcard-ico" href="/download/<%= file.id %>" title="点击下载">
                  <span class="cr-fi cr-fi--lg cr-fi--<%= fileTint(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="28" height="28" alt=""></span>
                </a>
                <a class="cr-gcard-name pan-g-name" href="/download/<%= file.id %>" title="<%= file.filename %>"><%= file.filename %></a>
                <% if (starredKeys && starredKeys['file:' + file.id]) { %><span class="cr-star-mark" title="已收藏">★</span><% } %>
                <div class="cr-gcard-meta"><%= formatFileSize(file.file_size) %></div>
                <div class="cr-gcard-ops">
                  <a class="cr-op" href="/download/<%= file.id %>" title="下载"><img src="/icons/download.svg" width="16" height="16" alt="下载"></a>
                  <button type="button" class="cr-op" data-menu-btn title="更多操作" aria-label="更多操作"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></button>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="cr-empty" id="crGridEmpty" style="display:none;">
            <img src="/icons/empty.svg" width="56" height="56" alt="">
            <p id="crGridEmptyText">当前筛选条件下没有内容</p>
          </div>
        <% } %>
      </div>

      <!-- 列表视图 -->
      <div class="cr-card" id="panListView" style="display:none">
        <% if (folders.length === 0 && personalFiles.length === 0) { %>
          <div class="cr-empty">
            <img src="/icons/empty.svg" width="56" height="56" alt="">
            <p>空空如也，上传文件或新建一个文件夹吧</p>
          </div>
        <% } else { %>
          <div class="cr-table-scroll">
            <table class="cr-table">
              <thead>
                <tr>
                  <th class="cr-col-check"><input type="checkbox" id="crCheckAll" title="全选" aria-label="全选"></th>
                  <th class="cr-th-sort" data-sort="name">名称<span class="cr-sort-ico"></span></th>
                  <th class="cr-col-size cr-th-sort" data-sort="size">大小<span class="cr-sort-ico"></span></th>
                  <th class="cr-col-time cr-th-sort" data-sort="time">修改时间<span class="cr-sort-ico"></span></th>
                  <th class="cr-col-ops">操作</th>
                </tr>
              </thead>
              <tbody id="crListBody">
                <% folders.forEach(function(f) { %>
                  <tr class="pan-g-item" data-key="folder:<%= f.id %>" data-kind="folder" data-id="<%= f.id %>" data-name="<%= f.name %>" data-size="0" data-time="<%= tsOf(f.created_at) %>" data-owner="<%= _ownerName %>" data-shared="0" data-starred="<%= (starredKeys && starredKeys['folder:' + f.id]) ? 1 : 0 %>" data-tags="">
                    <td class="cr-col-check"><input type="checkbox" class="cr-row-check" data-kind="folder" data-id="<%= f.id %>" data-name="<%= f.name %>" aria-label="选择"></td>
                    <td>
                      <div class="cr-name">
                        <span class="cr-fi cr-fi--folder"><img src="/icons/folder.svg" width="20" height="20" alt="文件夹"></span>
                        <a class="cr-name-text pan-list-link" href="/dashboard?folder=<%= f.id %>" title="<%= f.name %>"><%= f.name %></a>
                        <% if (starredKeys && starredKeys['folder:' + f.id]) { %><span class="cr-star-mark" title="已收藏">★</span><% } %>
                      </div>
                    </td>
                    <td class="cr-col-size">—</td>
                    <td class="cr-col-time"><%= new Date(f.created_at).toLocaleDateString('zh-CN') %></td>
                    <td class="cr-col-ops">
                      <div class="cr-row-ops">
                        <a class="cr-op" href="/dashboard?folder=<%= f.id %>" title="打开"><img src="/icons/folder-open.svg" width="16" height="16" alt="打开"></a>
                        <button type="button" class="cr-op" data-menu-btn title="更多操作" aria-label="更多操作"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
                <% personalFiles.forEach(function(file) { %>
                  <tr class="pan-g-item" data-key="file:<%= file.id %>" data-kind="file" data-id="<%= file.id %>" data-name="<%= file.filename %>" data-size="<%= file.file_size || 0 %>" data-time="<%= tsOf(file.uploaded_at) %>" data-owner="<%= _ownerName %>" data-shared="0" data-starred="<%= (starredKeys && starredKeys['file:' + file.id]) ? 1 : 0 %>" data-tags="<%= (fileTags && fileTags[file.id]) ? fileTags[file.id].join(',') : '' %>">
                    <td class="cr-col-check"><input type="checkbox" class="cr-row-check" data-kind="file" data-id="<%= file.id %>" data-name="<%= file.filename %>" aria-label="选择"></td>
                    <td>
                      <div class="cr-name">
                        <span class="cr-fi cr-fi--<%= fileTint(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="20" height="20" alt=""></span>
                        <a class="cr-name-text pan-list-link" href="/download/<%= file.id %>" title="<%= file.filename %>"><%= file.filename %></a>
                        <% if (starredKeys && starredKeys['file:' + file.id]) { %><span class="cr-star-mark" title="已收藏">★</span><% } %>
                      </div>
                    </td>
                    <td class="cr-col-size"><%= formatFileSize(file.file_size) %></td>
                    <td class="cr-col-time"><%= new Date(file.uploaded_at).toLocaleString('zh-CN') %></td>
                    <td class="cr-col-ops">
                      <div class="cr-row-ops">
                        <button type="button" class="cr-op" title="预览" onclick="openPreview(<%= file.id %>, null)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.6"/></svg></button>
                        <a class="cr-op" href="/download/<%= file.id %>" title="下载"><img src="/icons/download.svg" width="16" height="16" alt="下载"></a>
                        <button type="button" class="cr-op" data-menu-btn title="更多操作" aria-label="更多操作"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="cr-empty" id="crListEmpty" style="display:none;">
            <img src="/icons/empty.svg" width="56" height="56" alt="">
            <p>当前筛选条件下没有内容</p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ==================== 收藏（阶段一） ==================== -->
    <section id="pan-starred" class="pan-section" style="display:none">
      <div class="cr-card">
        <div class="cr-card-head">
          <h2>★ 收藏</h2>
          <span class="cr-spring"></span>
          <span class="cr-hint">共 <%= (typeof starredItems !== 'undefined' ? starredItems.length : 0) %> 项</span>
        </div>
        <div class="cr-card-body">
          <% if (typeof starredItems === 'undefined' || !starredItems.length) { %>
            <div class="cr-empty"><img src="/icons/empty.svg" width="56" height="56" alt=""><p>还没有收藏任何内容，可在文件条目的「更多操作」中收藏</p></div>
          <% } else { %>
            <div class="cr-table-scroll">
              <table class="cr-table">
                <thead><tr><th>名称</th><th class="cr-col-size">大小</th><th class="cr-col-time">时间</th><th class="cr-col-ops">操作</th></tr></thead>
                <tbody>
                  <% starredItems.forEach(function(it) { %>
                    <tr>
                      <td>
                        <div class="cr-name">
                          <span class="cr-fi cr-fi--<%= it.kind === 'folder' ? 'folder' : 'other' %>"><img src="<%= it.kind === 'folder' ? '/icons/folder.svg' : '/icons/file-generic.svg' %>" width="20" height="20" alt=""></span>
                          <% if (it.kind === 'folder') { %>
                            <a class="cr-name-text" href="/dashboard?folder=<%= it.id %>" title="<%= it.name %>"><%= it.name %></a>
                          <% } else { %>
                            <span class="cr-name-text" title="<%= it.name %>"><%= it.name %></span>
                          <% } %>
                        </div>
                      </td>
                      <td class="cr-col-size"><%= it.kind === 'folder' ? '—' : formatFileSize(it.size) %></td>
                      <td class="cr-col-time"><%= it.ts || '—' %></td>
                      <td class="cr-col-ops">
                        <div class="cr-row-ops">
                          <% if (it.kind === 'folder') { %>
                            <a class="cr-btn cr-btn-ghost cr-btn-sm" href="/dashboard?folder=<%= it.id %>">打开</a>
                          <% } else { %>
                            <a class="cr-btn cr-btn-ghost cr-btn-sm" href="/download/<%= it.id %>">下载</a>
                          <% } %>
                          <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-unstar="<%= it.kind %>:<%= it.id %>">取消收藏</button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- ==================== 最近访问（阶段一） ==================== -->
    <section id="pan-recent" class="pan-section" style="display:none">
      <div class="cr-card">
        <div class="cr-card-head">
          <h2>最近访问</h2>
          <span class="cr-spring"></span>
          <span class="cr-hint">最近打开的文件夹 / 预览过的文件（最多 50 条）</span>
        </div>
        <div class="cr-card-body">
          <% if (typeof recentItems === 'undefined' || !recentItems.length) { %>
            <div class="cr-empty"><img src="/icons/empty.svg" width="56" height="56" alt=""><p>暂无访问记录</p></div>
          <% } else { %>
            <div class="cr-table-scroll">
              <table class="cr-table">
                <thead><tr><th>名称</th><th class="cr-col-size">大小</th><th class="cr-col-time">访问时间</th><th class="cr-col-ops">操作</th></tr></thead>
                <tbody>
                  <% recentItems.forEach(function(it) { %>
                    <tr>
                      <td>
                        <div class="cr-name">
                          <span class="cr-fi cr-fi--<%= it.kind === 'folder' ? 'folder' : 'other' %>"><img src="<%= it.kind === 'folder' ? '/icons/folder.svg' : '/icons/file-generic.svg' %>" width="20" height="20" alt=""></span>
                          <% if (it.kind === 'folder') { %>
                            <a class="cr-name-text" href="/dashboard?folder=<%= it.id %>" title="<%= it.name %>"><%= it.name %></a>
                          <% } else { %>
                            <span class="cr-name-text" title="<%= it.name %>"><%= it.name %></span>
                          <% } %>
                        </div>
                      </td>
                      <td class="cr-col-size"><%= it.kind === 'folder' ? '—' : formatFileSize(it.size) %></td>
                      <td class="cr-col-time"><%= it.viewed_at || '—' %></td>
                      <td class="cr-col-ops">
                        <div class="cr-row-ops">
                          <% if (it.kind === 'folder') { %>
                            <a class="cr-btn cr-btn-ghost cr-btn-sm" href="/dashboard?folder=<%= it.folder_id ? it.folder_id : '' %>">所在目录</a>
                          <% } else { %>
                            <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-preview="<%= it.id %>">预览</button>
                            <a class="cr-btn cr-btn-ghost cr-btn-sm" href="/download/<%= it.id %>">下载</a>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- ==================== 团队空间 ==================== -->
    <section id="pan-teams" class="pan-section" style="display:none">
      <div class="cr-card">
        <div class="cr-card-head">
          <h2><img src="/icons/users.svg" width="18" height="18" alt="">团队空间</h2>
          <span class="cr-spring"></span>
          <span class="cr-hint">我的 UID：<span class="cr-uid"><%= currentUser.uid %></span></span>
        </div>
        <div class="cr-card-body">
          <% if (typeof teamSuccess !== 'undefined' && teamSuccess) { %>
            <div class="cr-alert cr-alert-success">
              <img src="/icons/check.svg" width="18" height="18" alt="">
              <span><%= teamSuccess %></span>
            </div>
          <% } %>
          <% if (typeof teamError !== 'undefined' && teamError) { %>
            <div class="cr-alert cr-alert-error">
              <img src="/icons/warning.svg" width="18" height="18" alt="">
              <span><%= teamError %></span>
            </div>
          <% } %>

          <% if (!hasTeam) { %>
            <p class="cr-hint" style="margin-bottom:16px;">您还未加入任何团队。将您的 UID 告诉他人，他人即可加入您创建的团队；或输入团队长的 UID 加入已有团队。</p>
            <div class="cr-grid-2">
              <div class="cr-block">
                <div class="cr-block-head"><h3><img src="/icons/plus.svg" width="18" height="18" alt="">创建团队</h3></div>
                <form action="/team/create" method="POST">
                  <div class="cr-field">
                    <input class="cr-input" type="text" name="name" placeholder="团队名称" required>
                  </div>
                  <button type="submit" class="cr-btn cr-btn-primary">创建团队</button>
                </form>
              </div>
              <div class="cr-block">
                <div class="cr-block-head"><h3><img src="/icons/key.svg" width="18" height="18" alt="">加入团队</h3></div>
                <form action="/team/join" method="POST">
                  <div class="cr-field">
                    <input class="cr-input" type="text" name="ownerUid" placeholder="团队长的 UID" required style="text-transform: uppercase;">
                  </div>
                  <div class="cr-field">
                    <input class="cr-input" type="password" name="password" placeholder="团队密码（若团队设置了密码）">
                  </div>
                  <button type="submit" class="cr-btn cr-btn-primary">加入团队</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <% teams.forEach(function(team) { %>
              <div class="cr-block">
                <div class="cr-block-head">
                  <h3><img src="/icons/folder.svg" width="18" height="18" alt=""><%= team.name %></h3>
                  <% if (team.isOwner) { %><span class="cr-tag cr-tag-primary">我是团队长</span><% } %>
                  <span class="cr-spring"></span>
                  <span class="cr-hint">团队长：<%= team.owner_name %>（UID: <%= team.owner_uid %>）</span>
                </div>

                <form action="/team/<%= team.id %>/upload" method="POST" enctype="multipart/form-data" style="margin-bottom:16px;">
                  <div class="file-input-wrapper">
                    <input type="file" name="file" id="teamFile<%= team.id %>" required>
                    <label for="teamFile<%= team.id %>" class="file-input-label">
                      <span class="file-label-text"><img src="/icons/upload.svg" width="16" height="16" alt="">选择文件</span>
                      <span class="file-hint">上传到团队</span>
                    </label>
                  </div>
                  <div style="display:flex;gap:10px;align-items:center;margin-top:10px;flex-wrap:wrap;">
                    <button type="submit" class="cr-btn cr-btn-primary cr-btn-sm">上传到团队</button>
                  </div>
                  <div class="upload-progress" style="display:none; margin-top:10px;">
                    <div class="progress-track"><div class="progress-bar"></div></div>
                    <div class="progress-info">
                      <span class="progress-pct">0%</span>
                      <span class="progress-speed">--</span>
                      <span class="progress-eta"></span>
                    </div>
                  </div>
                </form>

                <% if (team.files.length === 0) { %>
                  <p class="cr-hint">团队文件夹暂无文件</p>
                <% } else { %>
                  <table class="file-table">
                    <thead>
                      <tr>
                        <th>文件名</th>
                        <th>上传者</th>
                        <th>大小</th>
                        <th>上传时间</th>
                        <th>操作</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% team.files.forEach(function(file) { %>
                        <tr>
                          <td>
                            <div class="file-name">
                              <span class="cr-fi cr-fi--<%= fileTint(file.filename) %>"><img src="<%= fileIconPath(file.filename) %>" width="20" height="20" alt=""></span>
                              <span class="cr-name-text" title="<%= file.filename %>"><%= file.filename %></span>
                            </div>
                          </td>
                          <td class="pan-list-sub"><%= file.uploader_name %></td>
                          <td class="pan-list-sub"><%= formatFileSize(file.file_size) %></td>
                          <td class="pan-list-sub"><%= new Date(file.uploaded_at).toLocaleString('zh-CN') %></td>
                          <td>
                            <div class="file-actions">
                              <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" onclick="openPreview(<%= file.id %>, <%= team.id %>)">预览</button>
                              <a class="cr-btn cr-btn-ghost cr-btn-sm" href="/team/<%= team.id %>/download/<%= file.id %>">下载</a>
                              <% if (file.user_id === currentUser.id) { %>
                                <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-fid="<%= file.id %>" data-name="<%= file.filename %>" onclick="openShareModal(this.dataset.fid, this.dataset.name)"><img src="/icons/share.svg" width="14" height="14" alt="">分享</button>
                              <% } %>
                              <form action="/delete/<%= file.id %>" method="POST" style="display:inline;" data-confirm="确定删除该团队文件？">
                                <button type="submit" class="cr-btn cr-btn-danger cr-btn-sm">删除</button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                <% } %>

                <% if (team.isOwner) { %>
                  <div class="cr-block-sub">
                    <div class="cr-block-head"><h4><img src="/icons/users.svg" width="16" height="16" alt="">团员管理</h4></div>
                    <form action="/team/<%= team.id %>/add-member" method="POST" class="cr-inline-form">
                      <input class="cr-input" type="text" name="targetUid" placeholder="输入用户 UID 添加团员" required style="text-transform: uppercase;">
                      <button type="submit" class="cr-btn cr-btn-primary cr-btn-sm">添加团员</button>
                    </form>
                    <table class="file-table">
                      <thead>
                        <tr><th>用户名</th><th>UID</th><th>操作</th></tr>
                      </thead>
                      <tbody>
                        <% team.members.forEach(function(m) { %>
                          <tr>
                            <td>
                              <%= m.username %>
                              <% if (m.uid === team.owner_uid) { %><span class="cr-tag cr-tag-primary" style="margin-left:6px;">团队长</span><% } %>
                            </td>
                            <td class="cr-mono"><%= m.uid %></td>
                            <td>
                              <% if (m.uid !== team.owner_uid) { %>
                                <form action="/team/<%= team.id %>/remove-member" method="POST" style="display:inline;" data-confirm="确定移除团员 <%= m.username %>？">
                                  <input type="hidden" name="memberUserId" value="<%= m.id %>">
                                  <button type="submit" class="cr-btn cr-btn-danger cr-btn-sm">移除</button>
                                </form>
                              <% } else { %>
                                <span class="cr-muted">—</span>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>

                <div class="cr-block-sub">
                  <form action="/team/<%= team.id %>/leave" method="POST" data-confirm="确定退出该团队？退出后将无法访问团队文件夹。">
                    <button type="submit" class="cr-btn cr-btn-ghost cr-btn-sm">退出团队</button>
                  </form>
                </div>

                <% if (team.isOwner) { %>
                  <div class="cr-danger-zone">
                    <p><img src="/icons/warning.svg" width="14" height="14" alt=""> 解散团队将永久删除团队所有文件和成员关系，此操作不可恢复。</p>
                    <button type="button" class="cr-btn cr-btn-danger cr-btn-sm" onclick="document.getElementById('dissolveForm<%= team.id %>').style.display='block'">解散团队</button>
                    <div id="dissolveForm<%= team.id %>" style="display:none; margin-top:10px;">
                      <form action="/team/<%= team.id %>/dissolve" method="POST" data-confirm="确定解散团队？所有团队文件将被永久删除，此操作不可恢复！" data-confirm-danger="1">
                        <div class="cr-field">
                          <input class="cr-input" type="password" name="password" required placeholder="请输入您的账户密码">
                        </div>
                        <button type="submit" class="cr-btn cr-btn-danger cr-btn-sm">确认解散</button>
                        <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" onclick="document.getElementById('dissolveForm<%= team.id %>').style.display='none'">取消</button>
                      </form>
                    </div>
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

    <!-- ==================== 账户设置 ==================== -->
    <section id="pan-account" class="pan-section" style="display:none">
      <% if (typeof passwordSuccess !== 'undefined' && passwordSuccess) { %>
        <div class="cr-alert cr-alert-success">
          <img src="/icons/check.svg" width="18" height="18" alt="">
          <span><%= passwordSuccess %></span>
        </div>
      <% } %>
      <% if (typeof passwordError !== 'undefined' && passwordError) { %>
        <div class="cr-alert cr-alert-error">
          <img src="/icons/warning.svg" width="18" height="18" alt="">
          <span><%= passwordError %></span>
        </div>
      <% } %>
      <% if (typeof deleteError !== 'undefined' && deleteError) { %>
        <div class="cr-alert cr-alert-error">
          <img src="/icons/warning.svg" width="18" height="18" alt="">
          <span><%= deleteError %></span>
        </div>
      <% } %>

      <!-- 个人资料 -->
      <div class="cr-card cr-set-group">
        <div class="cr-card-head">
          <h2><img src="/icons/user.svg" width="18" height="18" alt="">个人资料</h2>
        </div>
        <div class="cr-card-body">
          <div class="cr-profile">
            <div style="text-align:center;">
              <img id="profileAvatar" class="cr-avatar-lg" src="<%= currentUser.avatar ? ('/avatar/' + currentUser.uid) : '/icons/user.svg' %>" alt="头像">
              <div style="margin-top:8px;">
                <label for="avatarInput" style="cursor:pointer;font-size:12.5px;">更换头像</label>
                <input type="file" id="avatarInput" accept="image/*" style="display:none;">
              </div>
            </div>
            <div class="cr-profile-info">
              <p>登录名：<b><%= currentUser.username %></b>（不可修改）</p>
              <p>团队 ID：<b class="cr-mono"><%= currentUser.uid %></b></p>
              <div class="cr-inline-form" style="margin-bottom:0;">
                <input class="cr-input" type="text" id="nicknameInput" maxlength="20" value="<%= currentUser.nickname || currentUser.username %>" placeholder="昵称（≤20字）">
                <button type="button" class="cr-btn cr-btn-primary" id="saveNicknameBtn">保存昵称</button>
              </div>
              <div class="cr-profile-msg" id="profileMsg"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 安全 -->
      <div class="cr-card cr-set-group">
        <div class="cr-card-head">
          <h2><img src="/icons/lock.svg" width="18" height="18" alt="">安全</h2>
        </div>
        <div class="cr-card-body">
          <div class="cr-block-head" style="margin-bottom:6px;">
            <h4>登录密码</h4>
            <span class="cr-spring"></span>
            <button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" id="changePasswordBtn">修改密码</button>
          </div>
          <p class="cr-hint">修改密码需验证原密码，修改后其它设备需重新登录。</p>
          <div class="cr-danger-zone">
            <p><img src="/icons/warning.svg" width="14" height="14" alt=""> 注销账户将永久删除您的账户与所有个人文件，此操作不可恢复。</p>
            <button type="button" class="cr-btn cr-btn-danger cr-btn-sm" id="deleteAccountBtn"><img src="/icons/trash.svg" width="14" height="14" alt="">注销账户</button>
          </div>
        </div>
      </div>

      <!-- 外观 -->
      <div class="cr-card cr-set-group">
        <div class="cr-card-head">
          <h2><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M10.34 3.36A8.8 8.8 0 1 0 20.64 13.66A7.4 7.4 0 0 1 10.34 3.36z"/></svg>外观</h2>
        </div>
        <div class="cr-card-body">
          <p class="cr-hint" style="margin-bottom:12px;">界面主题（保存后立即生效，并同步到其它页面）。</p>
          <div class="cr-radio-cards" id="crThemeCards">
            <button type="button" class="cr-radio-card" data-theme-choice="light">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2z"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M5.2 18.8l1.6-1.6M17.2 6.8l1.6-1.6"/></g></svg>
              <span>浅色</span>
            </button>
            <button type="button" class="cr-radio-card" data-theme-choice="dark">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M10.34 3.36A8.8 8.8 0 1 0 20.64 13.66A7.4 7.4 0 0 1 10.34 3.36z"/></svg>
              <span>深色</span>
            </button>
            <button type="button" class="cr-radio-card" data-theme-choice="system">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4.4a7.6 7.6 0 1 0 0 15.2z"/><circle cx="12" cy="12" r="7.6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              <span>跟随系统</span>
            </button>
          </div>
          <div class="cr-profile-msg" id="themeMsg"></div>
        </div>
      </div>

      <!-- 关于 -->
      <div class="cr-card cr-set-group">
        <div class="cr-card-head">
          <h2><img src="/icons/cloud.svg" width="18" height="18" alt="">关于</h2>
        </div>
        <div class="cr-card-body">
          <div class="cr-kv"><span class="cr-kv-k">站点</span><span class="cr-kv-v">CC网盘</span></div>
          <div class="cr-kv"><span class="cr-kv-k">存储</span><span class="cr-kv-v">对象存储直传（分片并发上传）</span></div>
          <div class="cr-kv"><span class="cr-kv-k">协议</span><span class="cr-kv-v"><a href="/agreement" target="_blank" rel="noopener">用户协议</a> · <a href="/privacy" target="_blank" rel="noopener">隐私政策</a></span></div>
          <div class="cr-kv"><span class="cr-kv-k">账户</span><span class="cr-kv-v"><%= currentUser.username %>（<%= currentUser.role === 'admin' ? '管理员' : '普通用户' %>）</span></div>
        </div>
      </div>
    </section>
  </div><!-- /.cr-content -->

<!-- ==================== 详情面板（右侧滑出） ==================== -->
<aside class="cr-detail" id="crDetail" aria-hidden="true">
  <div class="cr-detail-head">
    <img src="/icons/file-generic.svg" width="18" height="18" alt="" id="crDetailHeadIco">
    <span>详细信息</span>
    <span class="cr-spring"></span>
    <button type="button" class="cr-icon-btn" id="crDetailClose" title="关闭" aria-label="关闭">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M6.6 6.6a1.2 1.2 0 0 1 1.7 0L12 10.3l3.7-3.7a1.2 1.2 0 1 1 1.7 1.7L13.7 12l3.7 3.7a1.2 1.2 0 0 1-1.7 1.7L12 13.7l-3.7 3.7a1.2 1.2 0 0 1-1.7-1.7L10.3 12 6.6 8.3a1.2 1.2 0 0 1 0-1.7z"/></svg>
    </button>
  </div>
  <div class="cr-detail-body">
    <div class="cr-detail-preview" id="crDetailPreview"><img src="/icons/file-generic.svg" width="56" height="56" alt=""></div>
    <div class="cr-detail-name" id="crDetailName">—</div>
    <div class="cr-detail-row"><span class="cr-detail-k">类型</span><span class="cr-detail-v" id="crDetailType">—</span></div>
    <div class="cr-detail-row"><span class="cr-detail-k">大小</span><span class="cr-detail-v" id="crDetailSize">—</span></div>
    <div class="cr-detail-row"><span class="cr-detail-k">修改时间</span><span class="cr-detail-v" id="crDetailTime">—</span></div>
    <div class="cr-detail-row"><span class="cr-detail-k">上传者</span><span class="cr-detail-v" id="crDetailOwner">—</span></div>
    <div class="cr-detail-row"><span class="cr-detail-k">分享状态</span><span class="cr-detail-v" id="crDetailShared">—</span></div>
    <div class="cr-detail-rename">
      <input class="cr-input" type="text" id="crDetailRenameInput" maxlength="200" placeholder="输入新名称">
      <button type="button" class="cr-btn cr-btn-primary" id="crDetailRenameBtn">保存名称</button>
    </div>
    <div class="cr-detail-actions" id="crDetailActions"></div>
  </div>
</aside>

<!-- ==================== 上传任务面板 ==================== -->
<div class="cr-up" id="crUploadPanel" hidden>
