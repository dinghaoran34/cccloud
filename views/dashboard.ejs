    var key = t.dataset.kind + ':' + t.dataset.id;
    if (t.checked) { sel[key] = { kind: t.dataset.kind, id: t.dataset.id, name: t.dataset.name }; }
    else { delete sel[key]; }
    syncChecks();
    updateSelBar();
  });

  if (checkAll) {
    checkAll.addEventListener('change', function() {
      var boxes = visibleChecks();
      for (var i = 0; i < boxes.length; i++) {
        var b = boxes[i];
        var key = b.dataset.kind + ':' + b.dataset.id;
        if (checkAll.checked) { sel[key] = { kind: b.dataset.kind, id: b.dataset.id, name: b.dataset.name }; }
        else { delete sel[key]; }
      }
      syncChecks();
      updateSelBar();
    });
  }

  function selSetAll(on) {
    var boxes = visibleChecks();
    for (var i = 0; i < boxes.length; i++) {
