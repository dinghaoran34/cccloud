  // ==================== 排序 / 筛选 ====================
  var SORT_KEY = 'cr_sort', FILTER_KEY = 'cr_filter';
  var sortState = { key: 'name', dir: 1 };
  var filterState = 'all';
  try {
    var _s = JSON.parse(localStorage.getItem(SORT_KEY) || 'null');
    if (_s && (_s.key === 'name' || _s.key === 'size' || _s.key === 'time')) { sortState = _s; }
    var _f = localStorage.getItem(FILTER_KEY);
    if (_f === 'folder' || _f === 'file' || _f === 'starred') { filterState = _f; }
  } catch (e) { }

  function fmtSize(bytes) {
    if (typeof formatFileSize === 'function') { return formatFileSize(Number(bytes) || 0); }
    bytes = Number(bytes) || 0;
    if (bytes < 1024) { return bytes + ' B'; }
    if (bytes < 1048576) { return (bytes / 1024).toFixed(1) + ' KB'; }
    if (bytes < 1073741824) { return (bytes / 1048576).toFixed(1) + ' MB'; }
    return (bytes / 1073741824).toFixed(1) + ' GB';
  }
  function fmtTime(ms) {
    if (!ms) { return '—'; }
    try { return new Date(ms).toLocaleString('zh-CN'); } catch (e) { return '—'; }
  }

  function rowItems(root) {
    if (!root) { return []; }
    return Array.prototype.slice.call(root.querySelectorAll('.pan-g-item'));
  }

  function cmpItems(a, b) {
    var ak = a.dataset.kind, bk = b.dataset.kind;
    if (ak !== bk) { return ak === 'folder' ? -1 : 1; }   // 文件夹优先
    var key = sortState.key, r = 0;
    if (key === 'size') { r = Number(a.dataset.size || 0) - Number(b.dataset.size || 0); }
    else if (key === 'time') { r = Number(a.dataset.time || 0) - Number(b.dataset.time || 0); }
    else {
      r = String(a.dataset.name || '').localeCompare(String(b.dataset.name || ''), 'zh-CN', { numeric: true, sensitivity: 'base' });
    }
    if (r === 0) {
      r = String(a.dataset.name || '').localeCompare(String(b.dataset.name || ''), 'zh-CN', { numeric: true });
    }
    return r * (sortState.dir > 0 ? 1 : -1);
  }

  function syncSortUI() {
    Array.prototype.forEach.call(document.querySelectorAll('#crSortSeg .cr-seg-btn'), function (b) {
      b.classList.toggle('is-active', b.dataset.sort === sortState.key);
    });
    Array.prototype.forEach.call(document.querySelectorAll('#crFilterSeg .cr-seg-btn'), function (b) {
      b.classList.toggle('is-active', b.dataset.filter === filterState);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.cr-th-sort'), function (th) {
      th.classList.remove('is-asc', 'is-desc');
      if (th.dataset.sort === sortState.key) {
        th.classList.add(sortState.dir > 0 ? 'is-asc' : 'is-desc');
      }
    });
    var dirBtn = document.getElementById('crSortDir');
    if (dirBtn) { dirBtn.textContent = (sortState.dir > 0 ? '▲ 升序' : '▼ 降序'); }
  }

  function applySortFilter() {
    var grid = document.getElementById('crGrid');
    var body = document.getElementById('crListBody');
    [grid, body].forEach(function (root) {
      var items = rowItems(root);
      items.sort(cmpItems);
      items.forEach(function (el) { root.appendChild(el); });
      var visible = 0;
      items.forEach(function (el) {
        var show;
        if (filterState === 'starred') { show = el.dataset.starred === '1'; }
        else { show = (filterState === 'all' || el.dataset.kind === filterState); }
        el.style.display = show ? '' : 'none';
        if (show) { visible++; }
      });
      var emptyBox = root === grid ? document.getElementById('crGridEmpty') : document.getElementById('crListEmpty');
      if (emptyBox) {
        emptyBox.style.display = visible ? 'none' : '';
        var txt = emptyBox.querySelector('p');
        if (txt) {
          txt.textContent = filterState === 'folder' ? '当前目录没有文件夹'
            : (filterState === 'file' ? '当前目录没有文件'
            : (filterState === 'starred' ? '当前目录没有收藏项（可在条目菜单中收藏）' : '当前筛选条件下没有内容'));
        }
      }
    });
    syncSortUI();
  }

  Array.prototype.forEach.call(document.querySelectorAll('#crSortSeg .cr-seg-btn'), function (b) {
    b.addEventListener('click', function () {
      var k = b.dataset.sort;
      if (sortState.key === k) { sortState.dir = -sortState.dir; }
      else { sortState.key = k; sortState.dir = (k === 'name' ? 1 : -1); }
      try { localStorage.setItem(SORT_KEY, JSON.stringify(sortState)); } catch (e) { }
      applySortFilter();
    });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.cr-th-sort'), function (th) {
    th.addEventListener('click', function () {
      var k = th.dataset.sort;
      if (sortState.key === k) { sortState.dir = -sortState.dir; }
      else { sortState.key = k; sortState.dir = 1; }
      try { localStorage.setItem(SORT_KEY, JSON.stringify(sortState)); } catch (e) { }
      applySortFilter();
    });
  });
  var dirToggle = document.getElementById('crSortDir');
  if (dirToggle) {
    dirToggle.addEventListener('click', function () {
      sortState.dir = -sortState.dir;
      try { localStorage.setItem(SORT_KEY, JSON.stringify(sortState)); } catch (e) { }
      applySortFilter();
    });
  }
  Array.prototype.forEach.call(document.querySelectorAll('#crFilterSeg .cr-seg-btn'), function (b) {
    b.addEventListener('click', function () {
      filterState = b.dataset.filter || 'all';
      try { localStorage.setItem(FILTER_KEY, filterState); } catch (e) { }
      applySortFilter();
    });
  });
  applySortFilter();

