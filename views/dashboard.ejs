  var floatMenu = document.createElement('div');
  floatMenu.className = 'cr-menu cr-menu--float';
  floatMenu.id = 'crFloatMenu';
  document.body.appendChild(floatMenu);
  var floatOwner = null;   // 触发菜单的条目

  function menuBtn(act, label, ico, opt) {
    opt = opt || {};
    return '<button type="button" class="cr-menu-item' + (opt.danger ? ' is-danger' : '') + '"'
      + (opt.disabled ? ' disabled' : '') + ' data-act="' + act + '">'
      + (ICO[ico] || '') + '<span>' + label + '</span></button>';
  }

  function buildItemMenu(item) {
    var isFile = item.dataset.kind === 'file';
    var shared = item.dataset.shared === '1';
    var starred = item.dataset.starred === '1';
    var name = item.dataset.name || '';
    var isZip = isFile && /\.zip$/i.test(name);
    var html = '<div class="cr-menu-head"><b>' + crEsc(name) + '</b><span>'
      + (isFile ? '文件' : '文件夹') + (shared ? ' · 已分享' : '') + (starred ? ' · 已收藏' : '') + '</span></div>';
    if (!isFile) { html += menuBtn('open', '打开', 'open'); }
    if (isFile) {
      html += menuBtn('preview', '预览', 'eye');
      html += menuBtn('download', '下载', 'download');
    }
    html += menuBtn('detail', '详细信息', 'info');
    html += menuBtn('star', starred ? '取消收藏' : '收藏', 'star');
    html += '<div class="cr-menu-sep"></div>';
    html += menuBtn('share', '分享', 'share');
    html += menuBtn('rename', '重命名', 'edit');
    html += menuBtn('move', '移动到…', 'move');
    html += menuBtn('copyto', '复制到…', 'copyTo');
    html += menuBtn('copy', '复制（加入剪贴板）', 'copy');
    html += menuBtn('cut', '剪切（加入剪贴板）', 'cut');
    if (isFile) {
      html += '<div class="cr-menu-sep"></div>';
      html += menuBtn('tag', '标签', 'tag');
      html += menuBtn('versions', '历史版本', 'history');
      if (isZip) { html += menuBtn('unzip', '解压到当前文件夹', 'archive'); }
    } else {
      html += '<div class="cr-menu-sep"></div>';
      html += menuBtn('zip', '打包下载(zip)', 'archive');
    }
    html += '<div class="cr-menu-sep"></div>';
    html += menuBtn('newfolder', '新建文件夹', 'plus');
    html += menuBtn('upload', '上传文件', 'upload');
    html += menuBtn('uploaddir', '上传文件夹', 'folder');
    html += '<div class="cr-menu-sep"></div>';
    html += menuBtn('delete', '删除', 'trash', { danger: true });
    return html;
  }

  function buildBlankMenu() {
    var clip = getClip();
    var html = '<div class="cr-menu-head"><b>当前目录</b><span>空白处操作</span></div>'
      + menuBtn('newfolder', '新建文件夹', 'plus')
      + menuBtn('upload', '上传文件', 'upload')
      + menuBtn('uploaddir', '上传文件夹', 'folder');
    if (clip && clip.items && clip.items.length) {
      html += '<div class="cr-menu-sep"></div>'
        + menuBtn('paste', '粘贴到当前文件夹（' + clip.items.length + ' 项 · ' + (clip.mode === 'cut' ? '剪切' : '复制') + '）', 'paste');
    }
    html += '<div class="cr-menu-sep"></div>'
      + menuBtn('selectall', '全选', 'check')
      + menuBtn('refresh', '刷新列表', 'refresh');
    return html;
  }

  // ==================== 剪贴板（复制/剪切到目录） ====================
  var CLIP_KEY = 'cr_clip';
  function getClip() {
    try {
      var c = JSON.parse(localStorage.getItem(CLIP_KEY) || 'null');
      if (!c || !c.items || !c.items.length) { return null; }
      return c;
    } catch (e) { return null; }
  }
  function setClip(c) {
    try {
      if (c && c.items && c.items.length) { localStorage.setItem(CLIP_KEY, JSON.stringify(c)); }
      else { localStorage.removeItem(CLIP_KEY); }
    } catch (e) { }
  }
  function addToClip(mode, items) {
    var clip = getClip() || { mode: mode, items: [] };
    clip.mode = mode;
    items.forEach(function (it) {
      if (!clip.items.some(function (x) { return x.kind === it.kind && String(x.id) === String(it.id); })) {
        clip.items.push({ kind: it.kind, id: it.id, name: it.name });
      }
    });
    setClip(clip);
    crToast((mode === 'cut' ? '已剪切 ' : '已复制 ') + items.length + ' 项到剪贴板' + (mode === 'cut' ? '，进入目标文件夹后粘贴' : '，进入目标文件夹后粘贴'));
  }
  function pasteClip(targetFolderId) {
    var clip = getClip();
    if (!clip || !clip.items.length) { crToast('剪贴板为空'); return; }
    var target = targetFolderId ? Number(targetFolderId) : 0;
    var jobs = clip.items.map(function (it) {
      var isFolder = it.kind === 'folder';
      var url = clip.mode === 'cut'
        ? (isFolder ? '/api/folder/move' : '/api/file/move')
        : (isFolder ? '/api/folder/copy' : '/api/file/copy');
      var body = isFolder ? { id: Number(it.id), parentId: target } : { id: Number(it.id), folderId: target };
      return fetch(url, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(function (r) { return r.json(); });
    });
    Promise.all(jobs).then(function (res) {
      var bad = res.filter(function (x) { return !x || !x.ok; });
      if (bad.length) {
        crAlert('有 ' + bad.length + ' 项失败：' + ((bad[0] && bad[0].error) || '未知错误'));
        return;
      }
      if (clip.mode === 'cut') { setClip(null); }
      crToast((clip.mode === 'cut' ? '已移动 ' : '已复制 ') + res.length + ' 项', 'success');
      setTimeout(function () { location.reload(); }, 700);
    }).catch(function (err) { crAlert('粘贴失败：' + err.message); });
  }

  function placeFloatMenu(x, y) {
    floatMenu.style.left = '0px';
    floatMenu.style.top = '0px';
    var w = floatMenu.offsetWidth, h = floatMenu.offsetHeight;
    var vw = window.innerWidth, vh = window.innerHeight;
    if (x + w + 8 > vw) { x = Math.max(8, vw - w - 8); }
    if (y + h + 8 > vh) { y = Math.max(8, vh - h - 8); }
    floatMenu.style.left = x + 'px';
    floatMenu.style.top = y + 'px';
  }

  function openFloatMenu(html, x, y) {
    floatMenu.innerHTML = html;
    floatMenu.classList.add('is-open');
    placeFloatMenu(x, y);
  }
  function closeFloatMenu() {
    floatMenu.classList.remove('is-open');
    floatOwner = null;
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('[data-menu-btn]') : null;
    if (btn) {
      e.preventDefault();
      var item = btn.closest('.pan-g-item');
      var rect = btn.getBoundingClientRect();
      closeFloatMenu();
      floatOwner = item;
      var html = item ? buildItemMenu(item) : buildBlankMenu();
      var x = rect.right - 196, y = rect.bottom + 6;
      setTimeout(function () { openFloatMenu(html, Math.max(8, x), y); }, 0);
      return;
    }
    if (!floatMenu.contains(e.target)) { closeFloatMenu(); }
  });

  document.addEventListener('contextmenu', function (e) {
    var host = e.target.closest ? e.target.closest('#pan-files') : null;
    if (!host) { return; }
    e.preventDefault();
    var item = e.target.closest('.pan-g-item');
    // 注意：closeFloatMenu() 会清空 floatOwner，必须先关闭再赋值，
    // 否则右键菜单里的条目动作会因 floatOwner 为空而全部失效
    closeFloatMenu();
    floatOwner = item;
    var html = item ? buildItemMenu(item) : buildBlankMenu();
    setTimeout(function () { openFloatMenu(html, e.clientX, e.clientY); }, 0);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeFloatMenu(); closeDetail(); }
  });
  window.addEventListener('scroll', function (e) {
    // 菜单自身滚动（内容超出 max-height）不应关闭菜单，否则短视口下无法点到末尾项
    if (floatMenu && (e.target === floatMenu || (e.target && floatMenu.contains(e.target)))) { return; }
    closeFloatMenu();
  }, true);

  floatMenu.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-act]') : null;
    if (!b || b.disabled) { return; }
    var item = floatOwner;
    var act = b.dataset.act;
    closeFloatMenu();
    doMenuAction(act, item);
  });

  function clickDownload(href) {
    var a = document.createElement('a');
    a.href = href;
    a.rel = 'noopener';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  function confirmDeleteItem(kind, id, name) {
    crConfirm({
      title: kind === 'folder' ? '删除文件夹' : '删除文件',
      message: kind === 'folder'
        ? ('确定删除文件夹「' + name + '」？内部所有文件和子文件夹都会一并删除（可在回收站恢复）。')
        : ('确定删除「' + name + '」？删除后可在回收站恢复。'),
      danger: true,
      okText: '确认删除'
    }).then(function (ok) {
      if (!ok) { return; }
      var url = kind === 'folder' ? '/folder/' + id + '/delete' : '/delete/' + id;
      fetch(url, { method: 'POST', credentials: 'same-origin' }).then(function (r) {
        if (!r.ok) { crToast('删除失败（HTTP ' + r.status + '）', 'error'); return; }
        crToast('已删除', 'success');
        setTimeout(function () { location.reload(); }, 600);
      }).catch(function () { crToast('网络错误，删除失败', 'error'); });
    });
  }

  function doMenuAction(act, item) {
    if (act === 'newfolder') { openNewFolderModal(); return; }
    if (act === 'upload') { var fi = document.getElementById('panFileInput'); if (fi) { fi.click(); } return; }
    if (act === 'uploaddir') { var di = document.getElementById('panDirInput'); if (di) { di.click(); } return; }
    if (act === 'refresh') { location.reload(); return; }
    if (act === 'selectall') { selSetAll(true); return; }
    if (act === 'paste') { pasteClip(FOLDER_ID || 0); return; }
    if (!item) { return; }
    var kind = item.dataset.kind, id = item.dataset.id, name = item.dataset.name || '';
    if (act === 'open') { location.href = '/dashboard?folder=' + encodeURIComponent(id); return; }
    if (act === 'preview') { openPreview(id, null); return; }
    if (act === 'download') { clickDownload('/download/' + id); return; }
    if (act === 'share') { openShareModal(id, name, kind); return; }
    if (act === 'rename') { openRename(kind, id, name); return; }
    if (act === 'move') { openMoveModal([{ kind: kind, id: id, name: name }], 'move'); return; }
    if (act === 'copyto') { openMoveModal([{ kind: kind, id: id, name: name }], 'copy'); return; }
    if (act === 'copy') { addToClip('copy', [{ kind: kind, id: id, name: name }]); return; }
    if (act === 'cut') { addToClip('cut', [{ kind: kind, id: id, name: name }]); return; }
    if (act === 'delete') { confirmDeleteItem(kind, id, name); return; }
    if (act === 'detail') { openDetail(item); return; }
    if (act === 'star') { toggleStar(item); return; }
    if (act === 'tag') { openTagModal(id, name); return; }
    if (act === 'versions') { openVersionsModal(id, name); return; }
    if (act === 'unzip') { unzipFile(id, name); return; }
    if (act === 'zip') { downloadZip([], [id]); return; }
  }

  // ==================== 收藏（星标） ====================
  function toggleStar(item) {
    var kind = item.dataset.kind, id = item.dataset.id;
    fetch('/api/star/toggle', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: kind, id: Number(id) })
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (!j || !j.ok) { crAlert((j && j.error) || '操作失败'); return; }
      item.dataset.starred = j.starred ? '1' : '0';
      var mark = item.querySelector('.cr-star-mark');
      if (j.starred && !mark) {
        mark = document.createElement('span');
        mark.className = 'cr-star-mark';
        mark.title = '已收藏';
        mark.textContent = '★';
        var nameEl = item.querySelector('.cr-name') || item.querySelector('.cr-gcard-name');
        if (nameEl && nameEl.parentNode) { nameEl.parentNode.insertBefore(mark, nameEl.nextSibling); }
        else { item.appendChild(mark); }
      } else if (!j.starred && mark) {
        mark.parentNode.removeChild(mark);
      }
      applySortFilter();
      crToast(j.starred ? '已收藏' : '已取消收藏', 'success');
    }).catch(function (err) { crAlert('操作失败：' + err.message); });
  }

  // 收藏页 / 最近访问页的取消收藏按钮
  document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-unstar]') : null;
    if (!b) { return; }
    var parts = String(b.dataset.unstar).split(':');
    fetch('/api/star/toggle', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: parts[0], id: Number(parts[1]) })
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (j && j.ok) { crToast('已取消收藏', 'success'); setTimeout(function () { location.reload(); }, 600); }
      else { crAlert((j && j.error) || '操作失败'); }
    }).catch(function (err) { crAlert('操作失败：' + err.message); });
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-preview]') : null;
    if (!b) { return; }
    openPreview(b.dataset.preview, null);
  });

  // ==================== 右侧详情面板 ====================
  var detailEl = document.getElementById('crDetail');
  var detailItem = null;

  function openDetail(item) {
    if (!detailEl || !item) { return; }
    detailItem = item;
    var isFile = item.dataset.kind === 'file';
    var name = item.dataset.name || '';
    var icoImg = item.querySelector('.cr-fi img') || item.querySelector('img');
    var icoSrc = icoImg ? icoImg.getAttribute('src') : '/icons/file-generic.svg';
    document.getElementById('crDetailPreview').innerHTML = '<img src="' + icoSrc + '" width="56" height="56" alt="">';
    document.getElementById('crDetailHeadIco').src = icoSrc;
    document.getElementById('crDetailName').textContent = name;
    document.getElementById('crDetailType').textContent = isFile
      ? (name.indexOf('.') > 0 ? name.split('.').pop().toUpperCase() + ' 文件' : '文件')
      : '文件夹';
    document.getElementById('crDetailSize').textContent = isFile ? fmtSize(item.dataset.size) : '—';
    document.getElementById('crDetailTime').textContent = fmtTime(Number(item.dataset.time || 0));
    document.getElementById('crDetailOwner').textContent = item.dataset.owner || '—';
    document.getElementById('crDetailShared').textContent = item.dataset.shared === '1' ? '已生成分享链接' : '未分享';

    var rn = document.getElementById('crDetailRenameInput');
    rn.value = name;
    rn.dataset.kind = item.dataset.kind;
    rn.dataset.id = item.dataset.id;

    var actions = '';
    if (isFile) {
      actions += '<button type="button" class="cr-btn cr-btn-primary cr-btn-sm" data-dact="download">下载</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="preview">预览</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="share">分享</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="tag">标签</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="versions">历史版本</button>';
    } else {
      actions += '<button type="button" class="cr-btn cr-btn-primary cr-btn-sm" data-dact="open">打开文件夹</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="share">分享</button>';
      actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="zip">打包下载</button>';
    }
    actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="star">'
      + (item.dataset.starred === '1' ? '取消收藏' : '收藏') + '</button>';
    actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="move">移动到</button>';
    actions += '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-dact="copyto">复制到</button>';
    actions += '<button type="button" class="cr-btn cr-btn-danger cr-btn-sm" data-dact="delete">删除</button>';
    document.getElementById('crDetailActions').innerHTML = actions;

    detailEl.classList.add('is-open');
    detailEl.setAttribute('aria-hidden', 'false');
  }

  function closeDetail() {
    if (!detailEl) { return; }
    detailEl.classList.remove('is-open');
    detailEl.setAttribute('aria-hidden', 'true');
    detailItem = null;
  }

  if (detailEl) {
    document.getElementById('crDetailClose').addEventListener('click', closeDetail);
    document.getElementById('crDetailActions').addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-dact]') : null;
      if (!b || !detailItem) { return; }
      var kind = detailItem.dataset.kind, id = detailItem.dataset.id, name = detailItem.dataset.name || '';
      var act = b.dataset.dact;
      if (act === 'download') { clickDownload('/download/' + id); }
      else if (act === 'preview') { openPreview(id, null); }
      else if (act === 'share') { openShareModal(id, name, kind); }
      else if (act === 'open') { location.href = '/dashboard?folder=' + encodeURIComponent(id); }
      else if (act === 'move') { openMoveModal([{ kind: kind, id: id, name: name }], 'move'); }
      else if (act === 'copyto') { openMoveModal([{ kind: kind, id: id, name: name }], 'copy'); }
      else if (act === 'delete') { confirmDeleteItem(kind, id, name); }
      else if (act === 'star') { toggleStar(detailItem); openDetail(detailItem); }
      else if (act === 'tag') { openTagModal(id, name); }
      else if (act === 'versions') { openVersionsModal(id, name); }
      else if (act === 'zip') { downloadZip([], [Number(id)]); }
    });
    document.getElementById('crDetailRenameBtn').addEventListener('click', function () {
      if (!detailItem) { return; }
      var input = document.getElementById('crDetailRenameInput');
      var newName = (input.value || '').trim();
      if (!newName) { crAlert('名称不能为空'); return; }
      if (newName === detailItem.dataset.name) { crToast('名称未变化'); return; }
      var kind = detailItem.dataset.kind, id = detailItem.dataset.id;
      var fd = new URLSearchParams();
      fd.append('name', newName);
      fetch('/' + kind + '/' + id + '/rename', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: fd.toString()
      }).then(function (r) {
        if (!r.ok) { throw new Error('HTTP ' + r.status); }
        crToast('已重命名', 'success');
        setTimeout(function () { location.reload(); }, 600);
      }).catch(function (err) { crAlert('重命名失败：' + err.message); });
    });
  }

  // ==================== 移动到（目录树，懒加载 /api/list） ====================
  var moveModal = document.getElementById('crMoveModal');
  var moveTree = document.getElementById('crMoveTree');
  var moveCurrent = [];
  var moveTarget = { id: '', name: '全部文件' };
  var moveMode = 'move';   // move | copy

  function moveRowHtml(f, depth) {
    return '<button type="button" class="cr-menu-item" data-pick="' + f.id + '" data-pname="' + crEsc(f.name) + '" style="padding-left:' + (8 + depth * 16) + 'px">'
      + '<span class="move-caret" data-exp="' + f.id + '" style="width:14px;flex:none;text-align:center;opacity:.6;">▸</span>'
      + ICO.folder + '<span class="cr-truncate">' + crEsc(f.name) + '</span></button>';
  }

  function markPicked(id) {
    Array.prototype.forEach.call(moveTree.querySelectorAll('[data-pick]'), function (b) {
      if (b.dataset.pick === String(id)) {
        b.style.background = 'var(--cr-primary-weak)';
        b.style.color = 'var(--cr-primary)';
      } else {
        b.style.background = '';
        b.style.color = '';
      }
    });
  }

  function loadMoveTree() {
    moveTree.innerHTML = '<div class="cr-loading"><span class="cr-spin"></span>正在加载目录…</div>';
    fetch('/api/list', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
      if (!j || !j.ok) { throw new Error((j && j.error) || '加载失败'); }
      var folders = j.folders || [];
      var html = '<button type="button" class="cr-menu-item" data-pick="" data-pname="全部文件" style="padding-left:8px">'
        + '<span style="width:14px;flex:none"></span>' + ICO.folder + '<span>全部文件（根目录）</span></button>';
      folders.forEach(function (f) { html += moveRowHtml(f, 1); });
      moveTree.innerHTML = html;
      moveTarget = { id: '', name: '全部文件' };
      markPicked('');
    }).catch(function (err) {
      moveTree.innerHTML = '<div class="cr-empty" style="padding:22px;"><p>目录加载失败：' + crEsc(err.message) + '</p></div>';
    });
  }

  if (moveModal) {
    moveTree.addEventListener('click', function (e) {
      var caret = e.target.closest ? e.target.closest('[data-exp]') : null;
      if (caret) {
        e.stopPropagation();
        var fid = caret.dataset.exp;
        var row = caret.closest('[data-pick]');
        var wrap = row.nextSibling;
        if (wrap && wrap.classList && wrap.classList.contains('move-children')) {
          wrap.parentNode.removeChild(wrap);
          caret.textContent = '▸';
          return;
        }
        caret.textContent = '▾';
        var box = document.createElement('div');
        box.className = 'move-children';
        box.innerHTML = '<div class="cr-loading" style="padding:10px;"><span class="cr-spin"></span></div>';
        row.parentNode.insertBefore(box, row.nextSibling);
        var depth = Math.round((parseInt(row.style.paddingLeft, 10) - 8) / 16) + 1;
        fetch('/api/list?folderId=' + encodeURIComponent(fid), { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            var folders = (j && j.folders) || [];
            if (!folders.length) { box.innerHTML = '<div class="cr-menu-tip">（无子文件夹）</div>'; return; }
            box.innerHTML = folders.map(function (f) { return moveRowHtml(f, depth); }).join('');
          })
          .catch(function () { box.innerHTML = '<div class="cr-menu-tip" style="color:var(--cr-danger);">加载失败</div>'; });
        return;
      }
      var pick = e.target.closest ? e.target.closest('[data-pick]') : null;
      if (pick) {
        moveTarget = { id: pick.dataset.pick, name: pick.dataset.pname };
        markPicked(pick.dataset.pick);
      }
    });
    document.getElementById('crMoveCancel').addEventListener('click', function () { moveModal.style.display = 'none'; });
    moveModal.addEventListener('click', function (e) { if (e.target === moveModal) { moveModal.style.display = 'none'; } });
    document.getElementById('crMoveNewFolder').addEventListener('change', function () {
      document.getElementById('crMoveNewFolderRow').style.display = this.checked ? '' : 'none';
      if (this.checked) { setTimeout(function () { document.getElementById('crMoveNewFolderName').focus(); }, 30); }
    });
    document.getElementById('crMoveOk').addEventListener('click', function () {
      if (!moveCurrent.length) { moveModal.style.display = 'none'; return; }
      var target = moveTarget.id ? Number(moveTarget.id) : 0;
      var useNew = document.getElementById('crMoveNewFolder').checked;
      var newName = useNew ? (document.getElementById('crMoveNewFolderName').value || '').trim() : '';
      if (useNew && !newName) { crAlert('请输入新文件夹名称'); return; }

      var btn = this;
      btn.disabled = true;
      function finish(folderId) {
        var jobs = moveCurrent.map(function (it) {
          var url = it.kind === 'folder'
            ? (moveMode === 'copy' ? '/api/folder/copy' : '/api/folder/move')
            : (moveMode === 'copy' ? '/api/file/copy' : '/api/file/move');
          var body = it.kind === 'folder'
            ? { id: Number(it.id), parentId: folderId }
            : { id: Number(it.id), folderId: folderId };
          return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          }).then(function (r) { return r.json(); });
        });
        Promise.all(jobs).then(function (res) {
          btn.disabled = false;
          var bad = res.filter(function (x) { return !x || !x.ok; });
          if (bad.length) {
            crAlert('有 ' + bad.length + ' 项' + (moveMode === 'copy' ? '复制' : '移动') + '失败：' + ((bad[0] && bad[0].error) || '未知错误'));
            return;
          }
          moveModal.style.display = 'none';
          crToast((moveMode === 'copy' ? '已复制 ' : '已移动 ') + res.length + ' 项', 'success');
          setTimeout(function () { location.reload(); }, 700);
        }).catch(function (err) {
          btn.disabled = false;
          crAlert((moveMode === 'copy' ? '复制失败：' : '移动失败：') + err.message);
        });
      }

      if (useNew) {
        fetch('/api/folder/create', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: newName, parentId: target || null })
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (!j || !j.ok) { btn.disabled = false; crAlert((j && j.error) || '新建文件夹失败'); return; }
          finish(j.id ? Number(j.id) : target);
        }).catch(function (err) { btn.disabled = false; crAlert('新建文件夹失败：' + err.message); });
      } else {
        finish(target);
      }
    });
  }

  function openMoveModal(items, mode) {
    moveCurrent = items || [];
    moveMode = mode === 'copy' ? 'copy' : 'move';
    if (!moveModal || !moveCurrent.length) { return; }
    var kinds = { folder: 0, file: 0 };
    moveCurrent.forEach(function (it) { kinds[it.kind] = (kinds[it.kind] || 0) + 1; });
    document.getElementById('crMoveTip').textContent = '将 ' + moveCurrent.length + ' 项（文件夹 '
      + (kinds.folder || 0) + ' · 文件 ' + (kinds.file || 0) + '）' + (moveMode === 'copy' ? '复制' : '移动') + '到：';
    var okBtn = document.getElementById('crMoveOk');
    if (okBtn) { okBtn.textContent = moveMode === 'copy' ? '复制到这里' : '移动到这里'; }
    document.getElementById('crMoveNewFolder').checked = false;
    document.getElementById('crMoveNewFolderRow').style.display = 'none';
    document.getElementById('crMoveNewFolderName').value = '';
    moveModal.style.display = 'flex';
    loadMoveTree();
  }
  window.openMoveModal = openMoveModal;

  // ==================== 打包下载（服务端流式 ZIP） ====================
  function downloadZip(fileIds, folderIds) {
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/api/download/zip';
    form.style.display = 'none';
    (fileIds || []).forEach(function (id) {
      var i = document.createElement('input');
      i.type = 'hidden'; i.name = 'fileIds'; i.value = String(id);
      form.appendChild(i);
    });
    (folderIds || []).forEach(function (id) {
      var i = document.createElement('input');
      i.type = 'hidden'; i.name = 'folderIds'; i.value = String(id);
      form.appendChild(i);
    });
    document.body.appendChild(form);
    form.submit();
    crToast('正在服务端打包，浏览器将自动开始下载…');
    setTimeout(function () { if (form.parentNode) { form.parentNode.removeChild(form); } }, 3000);
  }
  window.crDownloadZip = downloadZip;

  // ==================== 解压 ZIP 到当前文件夹 ====================
  function unzipFile(id, name) {
    crConfirm({
      title: '解压到当前文件夹',
      message: '将解压「' + name + '」到当前文件夹，压缩包内的目录结构会被还原。压缩包会保留，可自行删除。',
      okText: '开始解压'
    }).then(function (ok) {
      if (!ok) { return; }
      crToast('正在解压…');
      fetch('/api/file/unzip', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), folderId: FOLDER_ID || null })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.ok) { crAlert((j && j.error) || '解压失败'); return; }
        crToast('解压完成，共 ' + j.count + ' 个文件' + (j.skipped ? '（跳过 ' + j.skipped + ' 项）' : ''), 'success');
        setTimeout(function () { location.reload(); }, 900);
      }).catch(function (err) { crAlert('解压失败：' + err.message); });
    });
  }

  // ==================== 标签管理弹窗 ====================
  var tagModal = document.getElementById('crTagModal');
  var tagListEl = document.getElementById('crTagList');
  var tagFileId = null;
  var tagChecked = {};
  var TAG_COLORS = ['#2b7de9', '#22c55e', '#f59e0b', '#e5484d', '#8b5cf6', '#14b8a6'];

  function renderTagList(tags) {
    if (!tags.length) {
      tagListEl.innerHTML = '<div class="cr-menu-tip">还没有标签，先创建一个吧</div>';
      return;
    }
    tagListEl.innerHTML = tags.map(function (t) {
      var on = !!tagChecked[t.id];
      return '<label class="cr-check cr-tag-row">'
        + '<input type="checkbox" data-tagid="' + t.id + '"' + (on ? ' checked' : '') + '>'
        + '<span class="cr-chip-dot" style="background:' + crEsc(t.color || '#2b7de9') + '"></span>'
        + '<span>' + crEsc(t.name) + '</span>'
        + '<button type="button" class="cr-tag-del" data-tagdel="' + t.id + '" title="删除标签">✕</button>'
        + '</label>';
    }).join('');
  }

  function loadTagModal() {
    tagListEl.innerHTML = '<div class="cr-loading"><span class="cr-spin"></span>加载中…</div>';
    fetch('/api/tag/list', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
      if (!j || !j.ok) { tagListEl.innerHTML = '<div class="cr-menu-tip">加载失败</div>'; return; }
      renderTagList(j.tags || []);
    }).catch(function () { tagListEl.innerHTML = '<div class="cr-menu-tip">加载失败</div>'; });
  }

  function openTagModal(fileId, name) {
    if (!tagModal) { return; }
    tagFileId = fileId;
    tagChecked = {};
    var item = document.querySelector('.pan-g-item[data-kind="file"][data-id="' + fileId + '"]');
    var cur = (item && item.dataset.tags) ? item.dataset.tags.split(',') : [];
    cur.forEach(function (t) { if (t) { tagChecked[Number(t)] = true; } });
    document.getElementById('crTagFileName').textContent = name || '';
    tagModal.style.display = 'flex';
    loadTagModal();
  }
  window.openTagModal = openTagModal;

  if (tagModal) {
    tagListEl.addEventListener('change', function (e) {
      var cb = e.target.closest ? e.target.closest('[data-tagid]') : null;
      if (!cb) { return; }
      var id = Number(cb.dataset.tagid);
      if (cb.checked) { tagChecked[id] = true; } else { delete tagChecked[id]; }
    });
    tagListEl.addEventListener('click', function (e) {
      var del = e.target.closest ? e.target.closest('[data-tagdel]') : null;
      if (!del) { return; }
      var id = Number(del.dataset.tagdel);
      crConfirm({ title: '删除标签', message: '删除该标签？会同时移除所有文件上的此标签。', danger: true, okText: '确认删除' }).then(function (ok) {
        if (!ok) { return; }
        fetch('/api/tag/delete', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id })
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (j && j.ok) { delete tagChecked[id]; loadTagModal(); crToast('已删除标签', 'success'); }
          else { crAlert((j && j.error) || '删除失败'); }
        });
      });
    });
    document.getElementById('crTagNewBtn').addEventListener('click', function () {
      var input = document.getElementById('crTagNewName');
      var name = (input.value || '').trim();
      if (!name) { crAlert('请输入标签名称'); return; }
      var color = TAG_COLORS[Math.floor(Math.random() * TAG_COLORS.length)];
      fetch('/api/tag/create', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, color: color })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.ok) { crAlert((j && j.error) || '创建失败'); return; }
        tagChecked[j.tag.id] = true;
        input.value = '';
        loadTagModal();
      }).catch(function (err) { crAlert('创建失败：' + err.message); });
    });
    document.getElementById('crTagCancel').addEventListener('click', function () { tagModal.style.display = 'none'; });
    tagModal.addEventListener('click', function (e) { if (e.target === tagModal) { tagModal.style.display = 'none'; } });
    document.getElementById('crTagSave').addEventListener('click', function () {
      var ids = Object.keys(tagChecked).map(Number);
      fetch('/api/tag/assign', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fileId: Number(tagFileId), tagIds: ids })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.ok) { crAlert((j && j.error) || '保存失败'); return; }
        tagModal.style.display = 'none';
        crToast('标签已保存', 'success');
        setTimeout(function () { location.reload(); }, 700);
      }).catch(function (err) { crAlert('保存失败：' + err.message); });
    });
  }

  // ==================== 历史版本弹窗 ====================
  var verModal = document.getElementById('crVerModal');
  function openVersionsModal(fileId, name) {
    if (!verModal) { return; }
    document.getElementById('crVerFileName').textContent = name || '';
    var listEl = document.getElementById('crVerList');
    listEl.innerHTML = '<div class="cr-loading"><span class="cr-spin"></span>加载中…</div>';
    verModal.style.display = 'flex';
    fetch('/api/file/versions?id=' + encodeURIComponent(fileId), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.ok) { listEl.innerHTML = '<div class="cr-menu-tip">加载失败</div>'; return; }
        var rows = '<div class="cr-ver-row cr-ver-cur"><span class="cr-ver-tag">当前</span>'
          + '<span class="cr-ver-size">' + fmtSize(j.file.file_size) + '</span>'
          + '<span class="cr-ver-time">' + crEsc(j.file.uploaded_at || '') + '</span>'
          + '<span class="cr-ver-ops"><a class="cr-btn cr-btn-ghost cr-btn-sm" href="/download/' + j.file.id + '">下载</a></span></div>';
        if (!j.versions.length) {
          rows += '<div class="cr-menu-tip">暂无历史版本（同名文件重新上传后会自动保留旧版本）</div>';
        } else {
          j.versions.forEach(function (v) {
            rows += '<div class="cr-ver-row"><span class="cr-ver-tag">V</span>'
              + '<span class="cr-ver-size">' + fmtSize(v.file_size) + '</span>'
              + '<span class="cr-ver-time">' + crEsc(v.created_at || '') + '</span>'
              + '<span class="cr-ver-ops">'
              + '<a class="cr-btn cr-btn-ghost cr-btn-sm" href="/api/file/version/download?id=' + v.id + '">下载此版本</a>'
              + '<button type="button" class="cr-btn cr-btn-ghost cr-btn-sm" data-verrestore="' + v.id + '">恢复此版本</button>'
              + '</span></div>';
          });
        }
        listEl.innerHTML = rows;
      }).catch(function () { listEl.innerHTML = '<div class="cr-menu-tip">加载失败</div>'; });
  }
  if (verModal) {
    document.getElementById('crVerClose').addEventListener('click', function () { verModal.style.display = 'none'; });
    verModal.addEventListener('click', function (e) { if (e.target === verModal) { verModal.style.display = 'none'; } });
    document.getElementById('crVerList').addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-verrestore]') : null;
      if (!b) { return; }
      crConfirm({
        title: '恢复历史版本',
        message: '将把该历史版本恢复为当前版本（当前版本会转入历史记录）。确定继续？',
        okText: '确认恢复'
      }).then(function (ok) {
        if (!ok) { return; }
        fetch('/api/file/version/restore', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(b.dataset.verrestore) })
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (!j || !j.ok) { crAlert((j && j.error) || '恢复失败'); return; }
          verModal.style.display = 'none';
          crToast('已恢复该版本', 'success');
          setTimeout(function () { location.reload(); }, 800);
        }).catch(function (err) { crAlert('恢复失败：' + err.message); });
      });
    });
  }

  // ==================== 外观设置（写入既有 cr_theme，复用 cr-theme.js） ====================
  var themeCards = document.getElementById('crThemeCards');
  function themeChoice() {
    try {
      var v = localStorage.getItem('cr_theme');
      return (v === 'light' || v === 'dark') ? v : 'system';
    } catch (e) { return 'system'; }
  }
  function syncThemeCards() {
    if (!themeCards) { return; }
    var cur = themeChoice();
    Array.prototype.forEach.call(themeCards.querySelectorAll('[data-theme-choice]'), function (b) {
      b.classList.toggle('is-active', b.dataset.themeChoice === cur);
    });
  }
  if (themeCards) {
    themeCards.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-theme-choice]') : null;
      if (!b) { return; }
      var v = b.dataset.themeChoice;
      if (typeof window.crSetTheme === 'function') {
        window.crSetTheme(v);
      } else {
        try {
          if (v === 'system') { localStorage.removeItem('cr_theme'); } else { localStorage.setItem('cr_theme', v); }
        } catch (e2) { }
        if (v === 'system') { document.documentElement.removeAttribute('data-theme'); }
        else { document.documentElement.setAttribute('data-theme', v); }
      }
      syncThemeCards();
      var msg = document.getElementById('themeMsg');
      if (msg) {
        msg.style.color = 'var(--cr-success)';
        msg.textContent = '已切换为「' + (v === 'light' ? '浅色' : (v === 'dark' ? '深色' : '跟随系统')) + '」';
        setTimeout(function () { msg.textContent = ''; }, 2200);
      }
    });
    syncThemeCards();
    document.addEventListener('cr:themechange', syncThemeCards);
  }

  // ==================== 顶栏「新建」下拉（新建文件夹 / 上传文件 / 上传文件夹） ====================
  (function () {
    var btn = document.getElementById('crNewBtn');
    var menu = document.getElementById('crNewMenu');
    if (!btn || !menu) { return; }
    function closeMenu() {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (menu.classList.contains('is-open')) { closeMenu(); return; }
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('click', function (e) {
      var it = e.target.closest ? e.target.closest('[data-new]') : null;
      if (!it) { return; }
      var act = it.getAttribute('data-new');
      closeMenu();
      if (act === 'folder') { openNewFolderModal(); return; }
      if (act === 'upload') { var fi = document.getElementById('panFileInput'); if (fi) { fi.click(); } return; }
      if (act === 'uploaddir') { var di = document.getElementById('panDirInput'); if (di) { di.click(); } return; }
    });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('is-open') && !menu.contains(e.target) && e.target !== btn) { closeMenu(); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeMenu(); } });
    window.addEventListener('scroll', function () { closeMenu(); }, true);
  })();
})();
</script>

<script>
(function() {
  // ===== 文件预览 =====
  var pvModal = document.getElementById('previewModal');
  window.openPreview = function(fid, teamId) {
    var api = (teamId ? '/team/' + teamId + '/preview/' + fid : '/preview/' + fid) + '?office=1';
    var dl = teamId ? '/team/' + teamId + '/download/' + fid : '/download/' + fid;
    var body = document.getElementById('pvBody');
    var openBtn = document.getElementById('pvOpen');
    var dlBtn = document.getElementById('pvDl');
    body.innerHTML = '<p style="color:#8a99ab;padding:40px;">加载中…</p>';
    openBtn.style.display = 'none'; dlBtn.style.display = 'none';
    document.getElementById('pvTitle').textContent = '预览';
    pvModal.style.display = 'flex';
    fetch(api).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) {
        body.innerHTML = '<div style="padding:50px 20px;color:#dfe7ef;"><div style="font-size:40px;">📄</div><p style="margin-top:10px;">' + (d.unsupported ? '该格式暂不支持在线预览' : (d.error || '预览失败')) + '</p></div>';
        dlBtn.href = dl; dlBtn.style.display = 'inline-block';
        return;
      }
      document.getElementById('pvTitle').textContent = d.name;
      var inner = '';
      if (d.kind === 'image') inner = '<img src="' + d.url + '" style="max-width:100%;max-height:66vh;display:block;margin:0 auto;" alt="">';
      else if (d.kind === 'pdf') inner = '<iframe src="' + d.url + '" style="width:100%;height:64vh;border:none;background:#fff;display:block;"></iframe>';
      else if (d.kind === 'video') inner = '<video src="' + d.url + '" controls autoplay preload="metadata" playsinline style="width:100%;max-height:64vh;background:#000;display:block;"></video>';
      else if (d.kind === 'audio') inner = '<audio src="' + d.url + '" controls autoplay preload="metadata" style="width:100%;display:block;margin-top:20vh;"></audio>';
      else if (d.kind === 'office') {
        // Office 文档：服务端本地解析预览，在新页面打开完整预览页
        var officeUrl = d.officeUrl || d.url || ('/office/' + fid);
        inner = '<div style="padding:44px 20px;text-align:center;color:#dfe7ef;">'
          + '<div style="font-size:40px;">📄</div>'
          + '<p style="margin:10px 0 16px;">' + (d.tooLarge ? '文件较大，建议下载后查看；仍可打开服务端在线预览（可能较慢）。' : 'Office 文档由 CC网盘服务端本地解析，将在新页面打开预览。') + '</p>'
          + '<a class="cr-btn cr-btn-primary" href="' + officeUrl + '" target="_blank" rel="noopener">打开在线预览</a></div>';
        body.innerHTML = inner;
        openBtn.href = officeUrl; openBtn.style.display = 'inline-block';
        dlBtn.href = dl; dlBtn.style.display = 'inline-block';
        return;
      }
      else if (d.kind === 'text') {
        // 文本类：走服务端读取（上限 2MB），避免浏览器直接渲染 S3 预签名页面
        inner = '<pre class="cr-textview">加载中…</pre>';
        body.innerHTML = inner;
        openBtn.href = d.url; openBtn.style.display = 'inline-block';
        dlBtn.href = dl; dlBtn.style.display = 'inline-block';
        fetch('/preview/' + fid + '/text', { credentials: 'same-origin' }).then(function (r2) { return r2.json(); }).then(function (t) {
          var pre = body.querySelector('.cr-textview');
          if (!t || !t.ok) {
            if (pre) { pre.textContent = (t && t.error) || '文本内容读取失败，请下载查看'; }
            return;
          }
          if (pre) {
            pre.textContent = t.text || '（空文件）';
            if (t.truncated) {
              var tip = document.createElement('div');
              tip.className = 'cr-hint';
              tip.style.marginTop = '8px';
              tip.textContent = '文件较大，仅显示前 2MB 内容，完整内容请下载查看。';
              pre.parentNode.insertBefore(tip, pre.nextSibling);
            }
          }
        }).catch(function () {
          var pre = body.querySelector('.cr-textview');
          if (pre) { pre.textContent = '文本内容读取失败，请下载查看'; }
        });
        return;
      }
      body.innerHTML = inner;
      openBtn.href = d.url; openBtn.style.display = 'inline-block';
      dlBtn.href = dl; dlBtn.style.display = 'inline-block';
    }).catch(function() {
      body.innerHTML = '<div style="padding:50px 20px;color:#dfe7ef;">预览失败，请下载查看</div>';
      dlBtn.href = dl; dlBtn.style.display = 'inline-block';
    });
  };
  window.closePreview = function() { pvModal.style.display = 'none'; };
  pvModal.addEventListener('click', function(e) { if (e.target === pvModal) closePreview(); });

  // ===== 分享链接 =====
  var modal = document.getElementById('shareModal');
  var currentShareFileId = null;
  var currentShareKind = 'file';
  var shareExpireDays = 0;
  var shareCodeMode = 'keep';

  function syncShareSegs() {
    Array.prototype.forEach.call(document.querySelectorAll('#crShareExpire .cr-seg-btn'), function (b) {
      b.classList.toggle('is-active', Number(b.dataset.exp) === shareExpireDays);
    });
    Array.prototype.forEach.call(document.querySelectorAll('#crShareCodeMode .cr-seg-btn'), function (b) {
      b.classList.toggle('is-active', b.dataset.code === shareCodeMode);
    });
    var inp = document.getElementById('crShareCodeInput');
    if (inp) { inp.style.display = shareCodeMode === 'custom' ? '' : 'none'; }
  }

  function shareMetaText(data) {
    var t = '当前：' + (data.expiresAt ? ('有效期至 ' + data.expiresAt) : '永久有效') + ' · 已下载 ' + (data.downloadCount || 0) + ' 次';
    document.getElementById('shareMetaText').textContent = t;
  }

  function renderShareResult(data) {
    var url = window.location.origin + data.url;
    document.getElementById('shareLinkInput').value = url;
    document.getElementById('sharePwdInput').value = data.password ? data.password : '（无）';
    document.getElementById('shareModalTitle').innerHTML = '<img src="/icons/share.svg" width="18" height="18" alt="">'
      + (data.kind === 'folder' ? '分享文件夹' : '分享文件');
    if (data.expiresAt) { shareExpireDays = 0; }
    shareMetaText(data);
    syncShareSegs();
  }

  function requestShare(extra) {
    var body = { fileId: null, folderId: null };
    if (currentShareKind === 'folder') { body.folderId = currentShareFileId; }
    else { body.fileId = currentShareFileId; }
    Object.keys(extra || {}).forEach(function (k) { body[k] = extra[k]; });
    return fetch('/share/create', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (resp) {
      if (!resp.ok) return resp.json().then(function (d) { throw new Error(d.error || '生成失败'); });
      return resp.json();
    });
  }

  window.openShareModal = function (id, name, kind) {
    currentShareFileId = id;
    currentShareKind = kind === 'folder' ? 'folder' : 'file';
    shareExpireDays = 0;
    shareCodeMode = 'keep';
    syncShareSegs();
    document.getElementById('shareFileName').textContent = name || '';
    document.getElementById('shareModalTitle').innerHTML = '<img src="/icons/share.svg" width="18" height="18" alt="">'
      + (currentShareKind === 'folder' ? '分享文件夹' : '分享文件');
    document.getElementById('shareLinkInput').value = '正在生成链接...';
    document.getElementById('sharePwdInput').value = '----';
    document.getElementById('shareStatus').textContent = '';
    modal.style.display = 'flex';

    requestShare({}).then(function (data) {
      renderShareResult(data);
    }).catch(function (err) {
      document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-danger);">' + crEsc(err.message) + '</span>';
      document.getElementById('shareLinkInput').value = '';
    });
  };

  (function bindShareSegs() {
    var expEl = document.getElementById('crShareExpire');
    if (expEl) {
      expEl.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-exp]') : null;
        if (!b) { return; }
        shareExpireDays = Number(b.dataset.exp);
        syncShareSegs();
      });
    }
    var codeEl = document.getElementById('crShareCodeMode');
    if (codeEl) {
      codeEl.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-code]') : null;
        if (!b) { return; }
        shareCodeMode = b.dataset.code;
        syncShareSegs();
      });
    }
    var applyBtn = document.getElementById('crShareApply');
    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        if (!currentShareFileId) { return; }
        var extra = { expireDays: shareExpireDays, codeMode: shareCodeMode };
        if (shareCodeMode === 'custom') {
          var code = (document.getElementById('crShareCodeInput').value || '').trim();
          if (!code) { crAlert('请输入自定义提取码'); return; }
          extra.code = code;
        }
        applyBtn.disabled = true;
        requestShare(extra).then(function (data) {
          applyBtn.disabled = false;
          renderShareResult(data);
          document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);">设置已应用</span>';
        }).catch(function (err) {
          applyBtn.disabled = false;
          document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-danger);">' + crEsc(err.message) + '</span>';
        });
      });
    }
  })();

  window.closeShareModal = function() {
    modal.style.display = 'none';
    currentShareFileId = null;
  };

  window.copyShareLink = function() {
    var input = document.getElementById('shareLinkInput');
    if (!input.value || input.value.indexOf('http') !== 0) return;
    input.select();
    input.setSelectionRange(0, 99999);
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    if (!ok && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(input.value).then(function () {
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);">链接已复制（请连同下方提取码一起发给对方）</span>';
      }).catch(function () {
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-text-2);">请手动复制链接</span>';
      });
      return;
    }
    document.getElementById('shareStatus').innerHTML = ok
      ? '<span style="color:var(--cr-success);">链接已复制（请连同下方提取码一起发给对方）</span>'
      : '<span style="color:var(--cr-text-2);">请手动复制链接</span>';
  };

  window.copySharePwd = function() {
    var input = document.getElementById('sharePwdInput');
    if (!input.value || input.value === '----' || input.value === '（无）') return;
    input.select();
    input.setSelectionRange(0, 99999);
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    if (!ok && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(input.value).then(function () {
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);">提取码已复制</span>';
      });
      return;
    }
    document.getElementById('shareStatus').innerHTML = ok
      ? '<span style="color:var(--cr-success);">提取码已复制</span>'
      : '<span style="color:var(--cr-text-2);">请手动复制提取码</span>';
  };

  window.revokeShare = function() {
    if (!currentShareFileId) return;
    crConfirm({
      title: '撤销分享',
      message: '确定撤销该分享链接？撤销后链接立即失效。',
      danger: true,
      okText: '确认撤销'
    }).then(function (ok) {
      if (!ok) { return; }
      var body = currentShareKind === 'folder' ? { folderId: currentShareFileId } : { fileId: currentShareFileId };
      fetch('/share/revoke', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(function(resp) {
        if (!resp.ok) return resp.json().then(function(d) { throw new Error(d.error || '撤销失败'); });
        return resp.json();
      }).then(function() {
        document.getElementById('shareLinkInput').value = '';
        document.getElementById('sharePwdInput').value = '----';
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-success);">分享已撤销，链接已失效</span>';
      }).catch(function(err) {
        document.getElementById('shareStatus').innerHTML = '<span style="color:var(--cr-danger);">' + crEsc(err.message) + '</span>';
      });
    });
  };

  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeShareModal();
  });
})();
</script>

<script>
(function() {
  // ===== 个人资料（头像 / 昵称）=====
  function $(id) { return document.getElementById(id); }
  function pm(msg, ok) {
    var el = $('profileMsg');
    if (!el) return;
    el.style.color = ok ? 'var(--cr-success)' : 'var(--cr-danger)';
    el.textContent = msg || '';
  }
  function xhrJson(method, url, body, okFn, errFn) {
    var x = new XMLHttpRequest();
    x.open(method, url);
    x.setRequestHeader('Accept', 'application/json');
    if (body && !(body instanceof FormData)) {
      x.setRequestHeader('Content-Type', 'application/json');
    }
    x.onload = function() {
      var j = null;
      try { j = JSON.parse(x.responseText); } catch (e) { }
      if (x.status >= 200 && x.status < 300 && j && j.ok) { if (okFn) okFn(j); }
      else { if (errFn) errFn((j && j.error) || '操作失败'); }
    };
    x.onerror = function() { if (errFn) errFn('网络错误，请重试'); };
    x.send(body ? (body instanceof FormData ? body : JSON.stringify(body)) : null);
  }
  function bindProfile() {
    var inp = $('avatarInput'), btn = $('saveNicknameBtn'), ni = $('nicknameInput');
    if (inp) {
      inp.addEventListener('change', function() {
        var f = inp.files && inp.files[0];
        if (!f) return;
        if (!/^image\//i.test(f.type)) { pm('仅支持图片文件', false); return; }
        if (f.size > 5 * 1024 * 1024) { pm('图片不能超过5MB', false); return; }
        var fd = new FormData();
        fd.append('avatar', f);
        pm('上传中…', true);
        inp.disabled = true;
        xhrJson('POST', '/api/account/avatar', fd, function() {
          pm('头像已更新', true);
          setTimeout(function() { location.reload(); }, 600);
        }, function(e) { pm(e, false); inp.disabled = false; });
      });
    }
    if (btn && ni) {
      btn.addEventListener('click', function() {
        var v = (ni.value || '').trim();
        if (!v) { pm('昵称不能为空', false); return; }
        xhrJson('POST', '/api/account/profile', { nickname: v }, function() {
          pm('昵称已保存', true);
          setTimeout(function() { location.reload(); }, 600);
        }, function(e) { pm(e, false); });
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindProfile);
  } else {
    bindProfile();
  }
})();
</script>

<%- include('partials/cr-shell-foot') %>
